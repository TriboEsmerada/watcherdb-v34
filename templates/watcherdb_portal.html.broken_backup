                    // Debug dos dados recebidos - LOGS DETALHADOS
                    debugLog(`[INFO] Space Health: ${spaceHealth.success ? 'OK' : 'FALHOU'} - Score: ${spaceHealth.health_score || 'N/A'}`, spaceHealth.success ? 'success' : 'warning');
                    debugLog(`[INFO] CPU Data completo: ${JSON.stringify(cpuData)}`, 'info');
                    debugLog(`[INFO] CPU Data: ${cpuData.success ? 'OK' : 'FALHOU'} - Percent: ${cpuData.data.sqlserver_cpu_pct || 'N/A'}`, cpuData.success ? 'success' : 'warning');
                    debugLog(`[INFO] Memory Data completo: ${JSON.stringify(memoryData)}`, 'info');
                    debugLog(`[INFO] Memory Data: ${memoryData.success ? 'OK' : 'FALHOU'} - Used: ${memoryData.data.total_server_memory_mb || 'N/A'}MB / Max: ${memoryData.data.max_server_memory_mb || 'N/A'}MB`, memoryData.success ? 'success' : 'warning');
                    debugLog(`[INFO] Memory Data estrutura: success=${memoryData.success}, hasData=${!!memoryData.data}, total=${memoryData.data.total_server_memory_mb}, max=${memoryData.data.max_server_memory_mb}, target=${memoryData.data.target_server_memory_mb}`, 'info');
                    
                    // TDE e Always On REMOVIDOS temporariamente - logs de debug removidos
                    
                    // Salvar dados processados não cache
                    cachedData = {
                        spaceHealth,
                        backupSummary,
                        patt,
                        winlog,
                        servicesStatus,
                        cpuData,
                        memoryData,
                        overflowFilegroups,
