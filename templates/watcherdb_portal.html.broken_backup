        // ========================================
        // SHOW QUERY DETAIL MODAL FOR TEMPDB
        // Modal para exibir query completa de viles do TempDB
        // ========================================
        function showQueryDetailModalForTempDB(rowIndex) {
            const villainRows = window.tempdbVillainRows || [];
            if (rowIndex < 0 || rowIndex >= villainRows.length) {
                console.error('Invalid rowIndex for TempDB villain:', rowIndex);
                return;
            }

            const row = villainRows[rowIndex];
            const queryText = row.query_text || 'N/A';

            // Criar ou obter modal
            let modal = document.getElementById('tempdbQueryModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'tempdbQueryModal';
                modal.className = 'modal';
                modal.style.zIndex = '10003';
                document.body.appendChild(modal);

                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });
            }

            // Determinar cor do status
            const statusVal = String(row.status || '').toLowerCase();
            let statusColor = '#64748b';
            if (statusVal === 'running') statusColor = '#22c55e';       // Verde - executando
            else if (statusVal === 'runnable') statusColor = '#eab308'; // Amarelo - aguardando CPU
            else if (statusVal === 'suspended') statusColor = '#f59e0b'; // Laranja - aguardando recurso
            else if (statusVal === 'sleeping') statusColor = '#3b82f6'; // Azul - idle

            modal.innerHTML = `
                <div class="modal-content" style="max-width: 900px; max-height: 85vh;">
                    <div class="modal-header" style="background: linear-gradient(135deg, rgba(96, 165, 250, 0.2) 0%, rgba(15, 23, 42, 0.95) 100%); border-bottom: 2px solid #60a5fa;">
                        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                            <h2 style="font-size: 18px; margin: 0; color: #60a5fa;">
                                <i class="fas fa-code" style="margin-right: 8px;"></i>
                                Query SQL
                            </h2>
                            <span style="background: #3b82f6; color: white; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600;">
                                Session ${row.session_id}
                            </span>
                            <span style="color: #94a3b8; font-size: 12px;">
                                <i class="fas fa-database" style="margin-right: 4px;"></i>${row.database_name || 'N/A'}
                            </span>
                            <span style="color: #94a3b8; font-size: 12px;">
                                <i class="fas fa-user" style="margin-right: 4px;"></i>${row.login_name || 'N/A'}
                            </span>
                            <span style="background: ${statusColor}30; color: ${statusColor}; padding: 2px 8px; border-radius: 4px; font-size: 11px;">
                                ${row.status || 'N/A'}
                            </span>
                            <span style="color: #f59e0b; font-size: 12px; font-weight: 600;">
                                <i class="fas fa-hdd" style="margin-right: 4px;"></i>${parseFloat(row.space_used_mb || 0).toLocaleString('pt-BR', {maximumFractionDigits: 2})} MB (${parseFloat(row.percent_of_tempdb || 0).toFixed(2)}%)
                            </span>
                        </div>
                        <button onclick="document.getElementById('tempdbQueryModal').style.display='none'"
                                style="background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 20px; padding: 8px;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body" style="padding: 0; background: #0f172a; max-height: calc(85vh - 200px); overflow: auto;">
                        <pre style="margin: 0; padding: 20px; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; font-size: 13px; line-height: 1.6; color: #e2e8f0; white-space: pre-wrap; word-break: break-all;">${escapeHtml(queryText)}</pre>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 12px; padding: 16px; background: rgba(15, 23, 42, 0.8); border-top: 1px solid rgba(71, 85, 105, 0.5);">
                        <button onclick="copyTextToClipboard('${escapeHtml(queryText).replace(/'/g, "\\'")}'); showToast('Query copiada para a rea de transferncia!', 'success');"
                                style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 8px;">
