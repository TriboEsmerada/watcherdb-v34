                });
                }
                
                // SEO 3: Renderizar seo de queries customizadas se houver
                if (customQueriesList.length > 0) {
                html += `
                        <div style="grid-column: 1 / -1; margin-top: 16px; padding-top: 16px; border-top: 1px solid #334155;">
                            <h5 style="color: #94a3b8; margin-bottom: 12px; font-size: 14px; font-weight: 600;">
                                <i class="fas fa-user-cog"></i> Queries Customizadas
                            </h5>
                        </div>
                    `;
                    customQueriesList.forEach(query => {
                        html += `
                            <div class="card query-card" id="query-card-${query.id}" onclick="loadQueryDiagnostic('${query.id}', '${query.endpoint}', '${query.name}', ${query.requiresDb || false}, ${query.custom || false}, ${JSON.stringify(query.sql || '').replace(/"/g, '&quot;')})"
                                 style="background: linear-gradient(135deg, #3b82f622, #3b82f611); border-left: 4px solid #3b82f6; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.1); padding: 16px; position: relative;"
                                 onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 12px rgba(59,130,246,0.3)'"
                                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px rgba(0,0,0,0.1)'">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <i class="fas ${query.icon || 'fa-database'}" style="font-size: 24px; color: #3b82f6;"></i>
                                    <div style="flex: 1;">
                                        <div style="color: #3b82f6; font-size: 14px; font-weight: 600; margin-bottom: 4px;">${query.name}</div>
                                        ${query.description ? `<div style="color: #64748b; font-size: 11px;">${query.description}</div>` : ''}
                                    </div>
                                    <i class="fas fa-sync-alt query-card-icon-${query.id}" style="font-size: 16px; color: #3b82f6; opacity: 0.6; transition: opacity 0.2s;"></i>
