        // ============================================================================
        // MODAL DE ALERTAS DE ESPAO
        // ============================================================================
        async function showAlertsDetails(serverId) {
            debugLog('[INFO] Carregando detalhes de alertas (Warning)...', 'info');

            const modal = document.getElementById('alertsModal');
            const modalBody = document.getElementById('alertsModalBody');
            const modalSubtitle = document.getElementById('alertsModalSubtitle');
            const modalTitle = document.getElementById('alertsModalTitle');

            if (!modal || !modalBody) {
                debugLog(' Modal de alertas não encontrado', 'error');
                return;
            }

            // Resetar título do modal para Warning
            if (modalTitle) {
                modalTitle.innerHTML = '[INFO] Alertas de Espao (Warning)';
            }

            // Mostrar modal e loading do olho imediatamente
            modal.style.display = 'block';
            modalBody.innerHTML = createPremiumLoading('Carregando alertas...');
            if (modalSubtitle) {
                modalSubtitle.textContent = 'Carregando alertas de nível Warning...';
            }
            
            try {
                // Buscar dados do servidor
                const response = await createFetchWithAbort(`/api/monitoring/space/server/${serverId}?t=${Date.now()}`);
                const json = await response.json();
                const data = (json.success && json.data) ? json.data : json;
                
                if (!data || data.error) throw new Error(data.error || 'Dados inválidos');
                
                const filegroups = data.filegroups || [];
                
                // Agrupar por database e filtrar alertas
                const dbGroups = {};
                filegroups.forEach(fg => {
                    const dbName = fg.database_name;
                    if (!dbGroups[dbName]) {
                        dbGroups[dbName] = {
                            filegroups: [],
                            total_gb: 0
                        };
                    }
                    dbGroups[dbName].filegroups.push(fg);
                    dbGroups[dbName].total_gb += (fg.total_gb || 0);
                });
                
                // Filtrar databases com alertas WARNING (disco 10-20% livre)
                // Os alertas CRITICAL/HIGH vo para showCriticalDetails
                const alertsList = [];
                Object.keys(dbGroups).forEach(dbName => {
                    const db = dbGroups[dbName];

                    // Filtrar apenas alertas de nível WARNING/MEDIUM ou disco entre 10-20% livre
                    const dbAlerts = db.filegroups.filter(fg => {
                        // Alertas WARNING ou MEDIUM explcitos
                        const isWarningLevel = fg.alert_level && ['WARNING', 'MEDIUM'].includes(fg.alert_level.toUpperCase());
                        // Disco entre 10-20% livre (warning, não crítico)
                        const isDiskWarning = fg.disk_free_pct !== undefined && fg.disk_free_pct >= 10 && fg.disk_free_pct < 20;
                        const isFreeDiskWarning = fg.free_disk_percent !== undefined && fg.free_disk_percent >= 10 && fg.free_disk_percent < 20;
                        // Filegroup entre 80-90% usado (warning)
                        const isFgWarning = fg.pct_used !== undefined && fg.pct_used >= 80 && fg.pct_used < 90;

                        // Excluir se for CRITICAL/HIGH (esses vo para showCriticalDetails)
                        const isCritical = (fg.alert_level && ['CRITICAL', 'HIGH'].includes(fg.alert_level.toUpperCase())) ||
                                          (fg.disk_free_pct !== undefined && fg.disk_free_pct < 10) ||
                                          (fg.free_disk_percent !== undefined && fg.free_disk_percent < 10) ||
                                          (fg.pct_used !== undefined && fg.pct_used >= 90);

                        return (isWarningLevel || isDiskWarning || isFreeDiskWarning || isFgWarning) && !isCritical;
                    });

                    if (dbAlerts.length > 0) {
                        // Marcar todos como WARNING para exibio
                        dbAlerts.forEach(fg => {
                            if (!fg.alert_level || !['WARNING', 'MEDIUM'].includes(fg.alert_level.toUpperCase())) {
                                fg.alert_level = 'MEDIUM'; // Forar como warning
                            }
                        });

                        debugLog(`[INFO] Alerta WARNING encontrado para ${dbName}:`, 'info');
                        debugLog(JSON.stringify(dbAlerts[0], null, 2), 'info');

                        alertsList.push({
                            database: dbName,
                            total_gb: db.total_gb,
                            alerts: dbAlerts
                        });
                    }
                });
                
                // Ordenar por severidade (CRITICAL > HIGH > MEDIUM)
                const severityOrder = { 'CRITICAL': 0, 'HIGH': 1, 'MEDIUM': 2 };
                alertsList.forEach(item => {
                    item.alerts.sort((a, b) => {
                        const aSev = severityOrder[a.alert_level] || 99;
                        const bSev = severityOrder[b.alert_level] || 99;
                        return aSev - bSev;
                    });
                });
                
                // Ordenar databases pelo alerta mais crítico
                alertsList.sort((a, b) => {
                    const aMaxSev = Math.min(...a.alerts.map(alert => severityOrder[alert.alert_level] || 99));
                    const bMaxSev = Math.min(...b.alerts.map(alert => severityOrder[alert.alert_level] || 99));
                    return aMaxSev - bMaxSev;
                });
                
                debugLog(`[INFO] ${alertsList.length} databases com alertas encontrados`, 'info');
                
                // Renderizar modal
                renderAlertsModal(alertsList, serverId);
                
            } catch (e) {
                debugLog(` Erro ao carregar alertas: ${e.message}`, 'error');
                modalBody.innerHTML = `
                    <div class="card" style="background: #7f1d1d; border-color: #991b1b;">
                        <h4 style="color: #fca5a5;"><i class="fas fa-exclamation-triangle"></i> Erro</h4>
                        <p style="color: #fecaca;">${e.message}</p>
                    </div>
                `;
                modalSubtitle.textContent = 'Erro ao carregar alertas';
            }
        }

