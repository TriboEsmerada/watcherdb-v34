        async function loadUsersAnalysisForTab(tabId) {
            const tab = openTabs.get(tabId);
            if (!tab) return;

            // Verificar se é dashboard-kpis - não fazer requisições de servidor
            if (tab.tabType === 'dashboard-kpis' || tab.server.server_id === 'dashboard-kpis') {
                const content = tab.contentElement;
                content.innerHTML = `
                    <div class="card" style="background: #1e3a5f; border-left: 4px solid #3b82f6;">
                        <h4><i class="fas fa-info-circle"></i> Análise de Usurios</h4>
                        <p style="color: #94a3b8; margin-top: 12px;">
                            A análise de usuários est disponível apenas para instâncias de servidor específicas.
                            Selecione um servidor na lista ? esquerda para ver a análise de usuários.
                        </p>
                    </div>
                `;
                return;
            }

            const content = tab.contentElement;
            if (!content) return;

            // CACHE: Verificar se temos dados em cache
            const cacheInfo = getTabCache('users', tab.server.server_id);
            if (cacheInfo.valid) {
                content.innerHTML = cacheInfo.data;
                addCacheIndicator(content, cacheInfo);
                debugLog(` Aba Users carregada do cache (${cacheInfo.age}s)`, 'info');
                return;
            }

            const serverId = tab.server.server_id;
            const serverName = tab.server.name;

            // Loading state
            content.innerHTML = createPremiumLoading('Carregando análise de usuários...');

            try {
                const response = await createFetchWithAbort(`/api/users/server/${serverId}`);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                if (data.error) {
                    throw new Error(data.error);
                }

                // Renderizar UI com os dados
                const html = renderUsersAnalysis(data, serverName, serverId);
                content.innerHTML = html;

                // CACHE: Salvar dados após carregar
                if (content.innerHTML && !content.innerHTML.includes('loading-premium')) {
                    setTabCache('users', serverId, content.innerHTML);
                }

            } catch (error) {
                // Tratar erros de abort silenciosamente
                if (error.name === 'AbortError' || error.isAbort) {
                    debugLog(`[INFO] Requisio Users cancelada (tab switch)`, 'info');
                    content.innerHTML = `<div class="card"><p style="color:#94a3b8;">Requisio cancelada.</p></div>`;
                    return;
                }

                debugLog(` Erro ao carregar análise de usuários: ${error.message}`, 'error');
                content.innerHTML = `
                    <div class="card" style="border-left: 4px solid #ef4444;">
                        <h4><i class="fas fa-exclamation-triangle"></i> Erro ao Carregar Dados</h4>
                        <p style="color: #fca5a5; margin-top: 12px;">
                            ${error.message}
                        </p>
                        <button class="btn" onclick="refreshTab('${tabId}')" style="margin-top: 12px;">
                            <i class="fas fa-sync-alt"></i> Tentar Novamente
                        </button>
                    </div>
                `;
            }
        }

