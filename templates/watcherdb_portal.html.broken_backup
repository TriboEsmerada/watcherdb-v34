        // Fechar modal de service logs
        function closeServiceLogsModal() {
            const modal = document.getElementById('serviceLogsModal');
            modal.style.display = 'none';
            document.body.style.overflow = '';
            currentServiceLogsData = [];
        }

        // Abrir modal de mensagem completa do log
        function showLogMessage(logIndex) {
            const log = currentServiceLogsData[logIndex];
            if (!log) return;

            const modal = document.getElementById('logMessageModal');
            const detailsDiv = document.getElementById('logMessageDetails');
            const contentPre = document.getElementById('logMessageContent');

            // Determinar cor do nivel
            const levelColor = log.Level === 'Error' || log.Level === 'Critical' ? '#ef4444' :
                             log.Level === 'Warning' ? '#f59e0b' : '#22c55e';

            // Preencher detalhes
            detailsDiv.innerHTML = `
                <span style="color: #94a3b8; font-weight: 500;">Data/Hora:</span>
                <span style="color: #e2e8f0;">${log.TimeCreated || 'N/A'}</span>
                <span style="color: #94a3b8; font-weight: 500;">Event ID:</span>
                <span style="color: #e2e8f0;">${log.EventId || 'N/A'}</span>
                <span style="color: #94a3b8; font-weight: 500;">Nivel:</span>
                <span style="color: ${levelColor}; font-weight: bold;">${log.Level || 'Information'}</span>
                <span style="color: #94a3b8; font-weight: 500;">Origem:</span>
                <span style="color: #e2e8f0;">${log.Source || log.LogName || 'N/A'}</span>
                <span style="color: #94a3b8; font-weight: 500;">Fonte:</span>
                <span style="color: #e2e8f0;">${log.SourceType || 'Event Viewer'}</span>
            `;

            // Preencher mensagem completa
            contentPre.textContent = log.Message || 'Sem mensagem';

            modal.style.display = 'flex';
        }

        // Fechar modal de mensagem completa
        function closeLogMessageModal() {
            const modal = document.getElementById('logMessageModal');
            modal.style.display = 'none';
        }

        // Copiar mensagem do log para clipboard
        function copyLogMessage() {
            const content = document.getElementById('logMessageContent').textContent;
            navigator.clipboard.writeText(content).then(() => {
                // Feedback visual
                const btn = event.target.closest('button');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> Copiado!';
                btn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.style.background = 'linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)';
                }, 2000);
            }).catch(err => {
                console.error('Erro ao copiar:', err);
            });
        }

        // Fechar modais ao clicar fora
        document.addEventListener('click', function(e) {
            const serviceLogsModal = document.getElementById('serviceLogsModal');
            const logMessageModal = document.getElementById('logMessageModal');

            if (e.target === serviceLogsModal) {
                closeServiceLogsModal();
            }
            if (e.target === logMessageModal) {
                closeLogMessageModal();
            }
        });

        // Fechar modais com ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const logMessageModal = document.getElementById('logMessageModal');
                const serviceLogsModal = document.getElementById('serviceLogsModal');

                // Fechar o modal de mensagem primeiro se estiver aberto
                if (logMessageModal && logMessageModal.style.display === 'flex') {
                    closeLogMessageModal();
                } else if (serviceLogsModal && serviceLogsModal.style.display === 'flex') {
                    closeServiceLogsModal();
                }
            }
        });

        // Trocar aba (com lazy loading)
        function switchSQLResultsTab(tabName) {
            // Remover active de todas as abas
            document.querySelectorAll('.sql-results-tab').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.sql-results-tab-content').forEach(content => content.classList.remove('active'));

            // Ativar aba selecionada
            const tabs = {
                'results': 'sqlResultsTabResults',
                'sql': 'sqlResultsTabSQL',
                'info': 'sqlResultsTabInfo'
            };

            const contentId = tabs[tabName];
            if (contentId) {
                document.getElementById(contentId).classList.add('active');
                // Encontrar e ativar o boto da aba correspondente
                document.querySelectorAll('.sql-results-tab').forEach(tab => {
                    if (tab.onclick && tab.onclick.toString().includes(`'${tabName}'`)) {
                        tab.classList.add('active');
                    }
                });

                // Lazy loading: renderizar aba apenas quando for visualizada pela primeira vez
                if (!window.sqlModalTabsRendered) {
                    window.sqlModalTabsRendered = {results: false, sql: false, info: false};
                }

                if (!window.sqlModalTabsRendered[tabName]) {
                    if (tabName === 'sql') {
                        renderSQLTab(); // async - não precisa await aqui
                    } else if (tabName === 'info') {
                        renderInfoTab();
                    }
                    window.sqlModalTabsRendered[tabName] = true;
                }
            }
        }

        // Renderizar aba de resultados
        function renderResultsTab() {
            const container = document.getElementById('sqlResultsTabResults');
            const { results, columns } = window.sqlResultsData;

            if (results.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 60px 20px; color: var(--color-text-tertiary);">
                        <i class="fas fa-inbox" style="font-size: 48px; margin-bottom: 16px; opacity: 0.5;"></i>
                        <p style="font-size: 16px;">Nenhum resultado encontrado</p>
                    </div>
                `;
                return;
            }

            // Criar tabela (reaproveitando a lógica existente de formatao)
            const tableColumns = columns.length > 0 ? columns : Object.keys(results[0]);

            // Detectar se é query de TempDB (verificar queryId ou se tem session_id + espao tempdb)
            const { queryId, endpoint } = window.sqlResultsData;
            const isTempDBQuery = queryId === 'tempdb' ||
                                  (endpoint && endpoint.includes('/tempdb')) ||
                                  (tableColumns.includes('session_id') &&
                                   (tableColumns.includes('space_used_mb') || tableColumns.includes('percent_of_tempdb')));

            // Extrair serverId do endpoint para usar não boto de diagnóstico
            let serverIdForDiagnosis = '';
            if (endpoint) {
                const serverMatch = endpoint.match(/\/api\/queries\/[^\/]+\/([^\/]+)/);
                if (serverMatch) serverIdForDiagnosis = serverMatch[1];
            }

            // ========================================
            // TRATAMENTO ESPECIAL PARA TEMPDB
            // Separa Overview (card não topo) e Villains (tabela)
            // ========================================
            if (isTempDBQuery && results.some(r => r.metric_type === 'TempDB_Overview')) {
                // Separar overview e villains
                const overviewRow = results.find(r => r.metric_type === 'TempDB_Overview');
                const villainRows = results.filter(r => r.metric_type === 'TempDB_Villain');

                // v2.6 - Calcular status considerando DISCO e uso interno
                const usedPercent = parseFloat(overviewRow.used_percent) || 0;
                const fileSizeOnDiskMb = parseFloat(overviewRow.file_size_on_disk_mb) || 0;
                const diskFreeMb = parseFloat(overviewRow.disk_free_mb) || 0;
                const diskTotalMb = parseFloat(overviewRow.disk_total_mb) || 0;
                const diskUsedPercent = diskTotalMb > 0 ? ((diskTotalMb - diskFreeMb) / diskTotalMb * 100) : 0;
                const internalUsedMb = parseFloat(overviewRow.used_mb) || 0;

                // Status baseado não DISCO (prioridade) e uso interno
                let statusClass = 'tempdb-status-ok';
                let statusText = 'Normal';
                let statusIcon = 'fa-check-circle';
                let diskWarning = '';

                // CRÍTICO: Disco cheio (>95%)
                if (diskUsedPercent >= 95) {
                    statusClass = 'tempdb-status-critical';
                    statusText = 'DISCO CRÍTICO';
                    statusIcon = 'fa-exclamation-triangle';
                    diskWarning = `[INFO] DISCO ${diskUsedPercent.toFixed(1)}% CHEIO! Apenas ${(diskFreeMb/1024).toFixed(1)} GB livres`;
                }
                // ALERTA: Disco quase cheio (>85%)
                else if (diskUsedPercent >= 85) {
                    statusClass = 'tempdb-status-warning';
                    statusText = 'Disco Alto';
                    statusIcon = 'fa-exclamation-circle';
                    diskWarning = `Disco ${diskUsedPercent.toFixed(1)}% usado. ${(diskFreeMb/1024).toFixed(1)} GB livres`;
                }
                // ALERTA: Arquivo grande com pouco uso interno (oportunidade de SHRINK)
                else if (fileSizeOnDiskMb > 10240 && internalUsedMb < fileSizeOnDiskMb * 0.2) {
                    statusClass = 'tempdb-status-warning';
                    statusText = 'Arquivo Grande';
                    statusIcon = 'fa-database';
                    diskWarning = `Arquivo ${(fileSizeOnDiskMb/1024).toFixed(1)} GB mas apenas ${(internalUsedMb/1024).toFixed(1)} GB em uso. Considere SHRINK.`;
                }
                // Uso interno alto
                else if (usedPercent >= 90) {
                    statusClass = 'tempdb-status-critical';
                    statusText = 'Uso Alto';
                    statusIcon = 'fa-exclamation-triangle';
                } else if (usedPercent >= 75) {
                    statusClass = 'tempdb-status-warning';
                    statusText = 'Ateno';
                    statusIcon = 'fa-exclamation-circle';
                }

                let tempdbHtml = `
                    <style>
                        .tempdb-overview-card {
                            background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(15, 23, 42, 0.95) 100%);
                            border: 1px solid rgba(139, 92, 246, 0.3);
                            border-radius: 12px;
                            padding: 20px;
                            margin-bottom: 20px;
                        }
                        .tempdb-overview-header {
                            display: flex;
                            align-items: center;
                            gap: 12px;
                            margin-bottom: 16px;
                        }
                        .tempdb-overview-icon {
                            width: 48px;
                            height: 48px;
                            background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
