                        <button 
                            id="refresh-predictive-alerts-btn" 
                            onclick="refreshPredictiveAlerts('${serverId}')"
                            style="position: absolute; top: 0; right: 0; background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.5); color: #a78bfa; border-radius: 4px; padding: 4px 8px; cursor: pointer; font-size: 12px; transition: all 0.2s; z-index: 10;"
                            onmouseover="this.style.background='rgba(139, 92, 246, 0.4)'; this.style.borderColor='rgba(139, 92, 246, 0.8)'"
                            onmouseout="this.style.background='rgba(139, 92, 246, 0.2)'; this.style.borderColor='rgba(139, 92, 246, 0.5)'"
