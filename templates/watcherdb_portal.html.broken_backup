        /**
         * Gera relatório preditivo de crescimento de filegroup
         * Chama a API que executa os scripts Python de Machine Learning
         */
        async function generateReport(serverId, databaseName, filegroupName) {
            debugLog(`[INFO] Gerando relatório preditivo: ${filegroupName}`, 'info');
            debugLog(`[INFO] Server ID: ${serverId}`, 'info');
            debugLog(`[INFO] Database: ${databaseName}`, 'info');

            // Abre o modal com loading
            openReportModal(serverId, databaseName, filegroupName);

            try {
                const apiUrl = '/api/monitoring/space/filegroup/generate-report';
                debugLog(`[INFO] POST ${apiUrl}`, 'info');

                const requestBody = {
                    server_id: serverId,
                    database_name: databaseName,
                    filegroup_name: filegroupName,
                    forecast_days: 60,     // Previso de 60 dias
                    threshold: 0.85        // Alerta em 85% de uso
                };

                debugLog(`[INFO] Request: ${JSON.stringify(requestBody)}`, 'info');

                // Chama a API (pode demorar 30-60 segundos - Oracle + ML)
                const response = await createFetchWithAbort(apiUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(requestBody)
                });
            
                debugLog(`[INFO] Response status: ${response.status}`, response.ok ? 'success' : 'error');
            
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: `HTTP ${response.status}` }));
                    const errorMessage = errorData.error || `HTTP ${response.status}`;
                    
                    // Verificar se é erro de script não encontrado
                    if (errorMessage.includes('Scripts de análise não encontrados') || errorMessage.includes('Script não encontrado')) {
                        showScriptNotFoundError(errorMessage, serverId, databaseName, filegroupName);
                        return;
                    }
                    
                    throw new Error(errorMessage);
                }
            
                // A API retorna HTML direto (HTMLResponse)
                const htmlContent = await response.text();

                debugLog(` Relatório HTML recebido (${htmlContent.length} chars)`, 'success');

                // Headers com metadados do relatório
                const reportPath = response.headers.get('X-Report-Path');
                const csvPath = response.headers.get('X-CSV-Path');
                const generatedAt = response.headers.get('X-Generated-At');

                if (reportPath) debugLog(`[INFO] Report saved: ${reportPath}`, 'info');
                if (csvPath) debugLog(`[INFO] CSV saved: ${csvPath}`, 'info');
                if (generatedAt) debugLog(`[INFO] Generated: ${generatedAt}`, 'info');

                // Exibe o relatório não modal
                displayReport(htmlContent);
            
            } catch (error) {
                debugLog(` Erro: ${error.message}`, 'error');
                showReportError(error.message);
            }
        }

