        async function loadJobsAnalysisForTab(tabId) {
            console.log('[INFO] loadJobsAnalysisForTab chamado com tabId:', tabId);
            const tab = openTabs.get(tabId);
            if (!tab) {
                console.error(' Tab não encontrado:', tabId);
                return;
            }

            const content = tab.contentElement;
            const server = tab.server;
            const serverId = server.server_id;
            const serverName = server.name || serverId;
            console.log('[INFO] ServerId:', serverId, 'ServerName:', serverName);

            // Mostrar loading
            content.innerHTML = createPremiumLoading('Carregando análise de Jobs...');
            console.log('[INFO] Loading exibido');

            // Verificar cache
            const cacheInfo = getTabCache('jobs', serverId);
            if (cacheInfo.valid) {
                content.innerHTML = cacheInfo.data;
                addCacheIndicator(content, cacheInfo);
                debugLog(` Aba Jobs carregada do cache (${cacheInfo.age}s)`, 'info');
                console.log('[INFO] Carregado do cache');
                return;
            }

            try {
                // Converter serverId para formato da API (backslash para underscore)
                const serverIdFormatted = serverId.replace(/\\/g, '_');
                console.log('[INFO] Fazendo fetch para:', `/api/jobs/server/${serverIdFormatted}`);
                const response = await createFetchWithAbort(`/api/jobs/server/${serverIdFormatted}`);

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const responseData = await response.json();
                console.log('[INFO] Dados recebidos (raw):', responseData);
                
                // Verificar se a resposta tem a estrutura esperada
                let data = responseData;
                if (responseData.data) {
                    data = responseData.data;
                } else if (responseData.success && responseData.data) {
                    data = responseData.data;
                }
                
                console.log('[INFO] Dados processados:', data);
                console.log('[INFO] Estrutura dos dados:', {
                    hasFailedJobs: !!data.failed_jobs,
                    hasAllJobs: !!data.all_jobs,
                    hasRunningJobs: !!data.running_jobs,
                    hasDisabledJobs: !!data.disabled_jobs,
                    hasJobHistory: !!data.job_history
                });
                
                debugLog(` Jobs carregados para ${serverName}`, 'success');

                console.log('[INFO] Chamando renderJobsAnalysis...');
                const html = renderJobsAnalysis(data, serverName, serverId);
                console.log('[INFO] HTML gerado:', html ? 'SIM' : 'NO', typeof html, html ? html.substring(0, 100) : '');
                if (!html || typeof html !== 'string') {
                    throw new Error(`Falha ao renderizar dados de Jobs - html é ${typeof html}. Dados recebidos: ${JSON.stringify(data).substring(0, 200)}`);
                }
                content.innerHTML = html;
                console.log('[INFO] HTML inserido não content');

                // Carregar tendncias APS renderizar (no bloquear UI)
                console.log('[INFO] Carregando tendncias de jobs...');
                loadJobTrends(serverId).then(trends => {
                    if (trends && openTabs.has(tabId)) {
                        console.log('[INFO] Tendncias carregadas:', trends);
                        // Encontrar onde inserir (após o kpiHtml)
                        const trendsHtml = renderJobTrends(trends);
                        const kpiEndMarker = '<div class="card" style="border-left: 4px solid';
                        const currentHtml = content.innerHTML;

                        // Encontrar a primeira ocorrncia de maintenanceAnalysisHtml
                        const insertIndex = currentHtml.indexOf('class="card" style="border-left: 4px solid', currentHtml.indexOf('Análise de Manuteno'));

                        if (insertIndex !== -1) {
                            content.innerHTML = currentHtml.substring(0, insertIndex) + trendsHtml + currentHtml.substring(insertIndex);
                            console.log('[INFO] Tendncias inseridas não HTML');
                        }
                    }
                }).catch(err => {
                    console.error(' Erro ao carregar tendncias:', err);
                });

                // Salvar em cache
                if (openTabs.has(tabId)) {
                    setTabCache('jobs', serverId, content.innerHTML);
                }

            } catch (error) {
                if (error.name === 'AbortError') {
                    debugLog(`[INFO] Requisio Jobs cancelada (tab switch)`, 'info');
                    return;
                }

                debugLog(` Erro ao carregar Jobs: ${error.message}`, 'error');
                content.innerHTML = `
                    <div style="padding: var(--space-lg);">
                        ${createPageTitle('fas fa-clock', 'Análise de Jobs', serverName, '#667eea')}
                        <div class="card" style="border-left: 4px solid #ef4444;">
