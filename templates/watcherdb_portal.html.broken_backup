                    <div class="modal-body" style="max-height: 65vh; overflow-y: auto; padding: 20px;">
            `;

            if (alerts.length === 0) {
                html += `
                    <div style="text-align: center; padding: 40px;">
                        <i class="fas fa-check-circle" style="font-size: 48px; color: #10b981; margin-bottom: 16px;"></i>
                        <h4 style="color: #10b981;">Nenhum Alerta</h4>
                        <p style="color: #94a3b8;">Não há alertas nesta categoria.</p>
                    </div>
                `;
            } else {
                alerts.forEach((alert, index) => {
                    const alertConfig = severityConfig[alert.severity];
                    const daysText = alert.days_to_limit !== undefined ?
                        (alert.days_to_limit <= 0 ? 'Já atingiu o limite!' : `${alert.days_to_limit} dias até o limite`) :
                        'N/A';

                    html += `
                        <div style="background: ${alertConfig.bgColor}; border: 1px solid ${alertConfig.color}40; border-radius: 8px; padding: 16px; margin-bottom: 12px; border-left: 4px solid ${alertConfig.color};">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                                <div>
                                    <span style="color: ${alertConfig.color}; font-weight: bold; font-size: 12px;">${alertConfig.icon} ${alert.severity.toUpperCase()}</span>
                                    <h4 style="margin: 4px 0 0; color: #f1f5f9; font-size: 15px;">
                                        <i class="fas fa-database" style="margin-right: 8px; color: #64748b;"></i>
                                        ${alert.database_name || 'N/A'}
                                    </h4>
                                    <p style="margin: 4px 0 0; color: #94a3b8; font-size: 13px;">
                                        Filegroup: ${alert.filegroup_name || 'N/A'}
                                    </p>
                                </div>
                                <div style="text-align: right;">
                                    <div style="background: ${alertConfig.color}20; padding: 6px 12px; border-radius: 8px;">
                                        <div style="font-size: 11px; color: #94a3b8;">Tempo Restante</div>
                                        <div style="font-size: 14px; font-weight: bold; color: ${alertConfig.color};">${daysText}</div>
                                    </div>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; font-size: 12px;">
                                <div style="background: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;">
                                    <div style="color: #64748b;">Tamanho Atual</div>
                                    <div style="color: #f1f5f9; font-weight: 600;">${alert.current_size_gb ? alert.current_size_gb.toFixed(2) + ' GB' : 'N/A'}</div>
                                </div>
                                <div style="background: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;">
                                    <div style="color: #64748b;">Limite Máximo</div>
                                    <div style="color: #f1f5f9; font-weight: 600;">${alert.max_size_gb ? alert.max_size_gb.toFixed(2) + ' GB' : 'Ilimitado'}</div>
                                </div>
                                <div style="background: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;">
                                    <div style="color: #64748b;">% Utilizado</div>
                                    <div style="color: ${alert.pct_used >= 90 ? '#ef4444' : alert.pct_used >= 70 ? '#f59e0b' : '#10b981'}; font-weight: 600;">
                                        ${alert.pct_used ? alert.pct_used.toFixed(1) + '%' : 'N/A'}
                                    </div>
                                </div>
                            </div>

                            ${alert.recommendation ? `
                            <div style="margin-top: 12px; padding: 10px; background: rgba(139, 92, 246, 0.1); border-radius: 4px; border-left: 2px solid #8b5cf6;">
                                <div style="color: #a78bfa; font-size: 11px; font-weight: 600; margin-bottom: 4px;">
                                    <i class="fas fa-lightbulb"></i> Recomendao
                                </div>
                                <div style="color: #cbd5e1; font-size: 12px;">${alert.recommendation}</div>
                            </div>
                            ` : ''}
                        </div>
                    `;
                });
            }

            html += `
                    </div>
                </div>
            `;

            modal.innerHTML = html;
            modal.style.display = 'block';
        }

