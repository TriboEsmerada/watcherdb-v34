                    // Simplesmente tentar carregar os dados
                    // Se o servidor estiver offline, as requisições falharo naturalmente
                    const days = parseInt(localStorage.getItem('backup_days')||'7',10);

                    // Funo auxiliar para adicionar timeout em requisições
                    //  TIMEOUT AUMENTADO: 30s ? 120s (2 minutos) para servidores lentos
                    const fetchWithTimeout = async (url, timeout = 120000) => {
                        return Promise.race([
                            createFetchWithAbort(url),
                            new Promise((_, reject) =>
                                setTimeout(() => reject(new Error('Request timeout')), timeout)
                            )
                        ]);
                    };

                    // Funo auxiliar para processar resposta com fallback
                    const processResponse = async (responsePromise, fallback, label = 'unknown') => {
                        console.log(`[processResponse] Iniciando para: ${label}`);
                        try {
                            const response = await responsePromise;
                            console.log(`[processResponse] ${label} - response recebido:`, response);
                            console.log(`[processResponse] ${label} - response.ok:`, response.ok, 'status:', response.status);
                            if (!response || !response.ok) {
                                console.warn(`[processResponse] ${label} - Resposta não OK, usando fallback`);
                                debugLog(`[INFO] ${label}: Resposta não OK: status=${response.status}, usando fallback`, 'warning');
                                return fallback;
                            }
                            const data = await response.json();
                            console.log(`[processResponse] ${label} - JSON parseado:`, data);
                            debugLog(` ${label}: Resposta OK recebida`, 'info');
                            return data;
                        } catch (error) {
                            console.error(`[processResponse] ${label} - ERRO:`, error);
                            const errorMsg = error.message || 'Erro desconhecido';
                            if (errorMsg.includes('timeout')) {
                                debugLog(`[INFO] ${label}: Timeout detectado, usando fallback`, 'warning');
                            } else if (errorMsg.includes('aborted')) {
                                debugLog(`[INFO] ${label}: Requisio cancelada, usando fallback`, 'info');
                            } else {
                                debugLog(`[INFO] ${label}: Erro: ${errorMsg}, usando fallback`, 'warning');
                            }
                            return fallback;
                        }
                    };

                    //  CORREO CRTICA: Converter backslash para underscore
                    // Backend SEMPRE espera formato com underscore (SQLHDSPRD214_I01)
                    // Mas o serverId vem com backslash (SQLHDSPRD214\I01) do dropdown
                    const serverIdOriginal = serverId;
                    const serverIdFormatted = serverId.replace(/\\/g, '_');

                    debugLog(` Iniciando requisições Overview (paralelas com timeout 120s)...`, 'info');
                    debugLog(`[INFO] ServerId ORIGINAL: "${serverIdOriginal}"`, 'info');
