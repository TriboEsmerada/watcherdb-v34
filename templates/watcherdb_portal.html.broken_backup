                            database_name: fg.Database || fg.database || fg.database_name,
                            filegroup_name: fg.Filegroup || fg.filegroup || fg.filegroup_name,
                            total_gb: (fg.Total_MB || fg.total_mb || 0) / 1024,
                            used_gb: (fg.Used_MB || fg.used_mb || 0) / 1024,
                            free_gb: (fg.Free_MB || fg.free_mb || 0) / 1024,
                            free_percent: 100 - (fg.Percent_Used || fg.percent_used || 0),
                            pct_used: fg.Percent_Used || fg.percent_used || 0,
                            alert_level: fg.Status || fg.alert_level || 'ATTENTION'
                        }));
                        dataSource = 'WatcherDB_Intelligence';
                        debugLog(`WatcherDB Intelligence: ${filegroups.length} FileGroups retornados`, 'info');
                    }
                } catch (intErr) {
                    debugLog(`WatcherDB Intelligence indisponivel: ${intErr.message}`, 'warn');
                }

                // Fallback: consulta direta ao servidor (mais lento, usa Space router atualizado)
                if (filegroups.length === 0) {
                    debugLog('Tentando fallback para Space router...', 'info');
                    const response = await createFetchWithAbort(`/api/monitoring/space/server/${serverId}?t=${Date.now()}`);
                    const json = await response.json();
                    debugLog(`Space router response: success=${json.success}, source=${json.source}`, 'info');
                    const data = (json.success && json.data) ? json.data : json;
                    if (!data || data.error) throw new Error(data.error || 'Dados invalidos');
                    filegroups = data.filegroups || [];
                    dataSource = json.source || 'Space_Router';
                }

                debugLog(`Total filegroups obtidos de ${dataSource}: ${filegroups.length}`, 'info');

                // Agrupar por database
                const dbGroups = {};
                filegroups.forEach(fg => {
                    const dbName = fg.database_name;
                    if (!dbGroups[dbName]) { dbGroups[dbName] = { filegroups: [], total_gb: 0 }; }
                    dbGroups[dbName].filegroups.push(fg);
                    dbGroups[dbName].total_gb += (fg.total_gb || 0);
                });

                // Filtrar apenas filegroups ATTENTION (Status=ATTENTION ou 90% <= pct_used < 95%)
                const alertsList = [];
                Object.keys(dbGroups).forEach(dbName => {
                    const db = dbGroups[dbName];
                    const attentionFgs = db.filegroups.filter(fg => {
                        // Usar alert_level/Status da API (ja vem calculado corretamente)
                        // ou calcular baseado em 90% <= pct_used < 95%
                        const isAttention = (fg.alert_level === 'ATTENTION') ||
                                           (fg.pct_used >= 90 && fg.pct_used < 95) ||
                                           (fg.free_percent !== undefined && fg.free_percent >= 5 && fg.free_percent < 10);
                        return isAttention;
                    });
                    if (attentionFgs.length > 0) {
                        attentionFgs.forEach(fg => { fg.alert_level = 'ATTENTION'; });
                        alertsList.push({ database: dbName, total_gb: db.total_gb, alerts: attentionFgs });
                    }
                });

                alertsList.sort((a, b) => {
                    const aMax = Math.max(...a.alerts.map(fg => fg.pct_used || (100 - (fg.free_percent || 0))));
                    const bMax = Math.max(...b.alerts.map(fg => fg.pct_used || (100 - (fg.free_percent || 0))));
                    return bMax - aMax; // Maior uso primeiro
                });
                debugLog(`${alertsList.length} databases com FileGroups attention encontrados (fonte: ${dataSource})`, 'info');
                renderAlertsModal(alertsList, serverId);
            } catch (e) {
                debugLog(`Erro ao carregar alertas: ${e.message}`, 'error');
                modalBody.innerHTML = '<div class="card" style="background: #7f1d1d;"><h4 style="color: #fca5a5;">Erro</h4><p style="color: #fecaca;">' + e.message + '</p></div>';
            }
        }

// FUNO PARA MOSTRAR ALERTAS CRÍTICOS (disco < 10% livre)
        // ========================================
        async function showCriticalDetails(serverId) {
            debugLog('[INFO] Carregando detalhes de alertas CRÍTICOS...', 'info');

            const modal = document.getElementById('alertsModal');
            const modalBody = document.getElementById('alertsModalBody');
            const modalSubtitle = document.getElementById('alertsModalSubtitle');
            const modalTitle = document.getElementById('alertsModalTitle');

            if (!modal || !modalBody) {
                debugLog(' Modal de alertas não encontrado', 'error');
                return;
            }

            // Alterar título do modal para indicar que so alertas críticos
            if (modalTitle) {
                modalTitle.innerHTML = '<i class="fas fa-exclamation-circle"></i> Alertas Críticos de Espao';
            }

            // Mostrar modal e loading
            modal.style.display = 'block';
            modalBody.innerHTML = createPremiumLoading('Carregando alertas críticos...');
            if (modalSubtitle) {
                modalSubtitle.textContent = 'Identificando discos com menos de 10% de espao livre...';
            }

            try {
                // Buscar dados do servidor
                const response = await createFetchWithAbort(`/api/monitoring/space/server/${serverId}?t=${Date.now()}`);
                const json = await response.json();
                const data = (json.success && json.data) ? json.data : json;

                if (!data || data.error) throw new Error(data.error || 'Dados inválidos');

                const filegroups = data.filegroups || [];

                // Agrupar por database e filtrar APENAS alertas críticos
                const dbGroups = {};
                filegroups.forEach(fg => {
                    const dbName = fg.database_name;
                    if (!dbGroups[dbName]) {
                        dbGroups[dbName] = {
                            filegroups: [],
                            total_gb: 0
                        };
                    }
                    dbGroups[dbName].filegroups.push(fg);
                    dbGroups[dbName].total_gb += (fg.total_gb || 0);
                });

                // Filtrar databases com alertas CRÍTICOS
                const criticalList = [];
                Object.keys(dbGroups).forEach(dbName => {
                    const db = dbGroups[dbName];

                    // Verificar quais filegroups so críticos
                    const criticalFgs = db.filegroups.filter(fg => {
                        // alert_level CRITICAL ou HIGH
                        const isCriticalLevel = fg.alert_level && ['CRITICAL', 'HIGH'].includes(fg.alert_level.toUpperCase());
                        // Disco com menos de 10% livre
                        const isDiskCritical = fg.disk_free_pct !== undefined && fg.disk_free_pct < 10;
                        // Filegroup com mais de 90% usado
                        const isFgCritical = fg.pct_used !== undefined && fg.pct_used >= 90;
                        // Espao livre não disco < 10%
                        const isFreeDiskCritical = fg.free_disk_percent !== undefined && fg.free_disk_percent < 10;

                        return isCriticalLevel || isDiskCritical || isFgCritical || isFreeDiskCritical;
                    });

                    if (criticalFgs.length > 0) {
                        // Marcar todos como CRITICAL para exibio
                        criticalFgs.forEach(fg => {
                            if (!fg.alert_level || !['CRITICAL', 'HIGH'].includes(fg.alert_level.toUpperCase())) {
                                fg.alert_level = 'CRITICAL'; // Forar como crítico
                            }
                        });

                        criticalList.push({
                            database: dbName,
                            total_gb: db.total_gb,
                            alerts: criticalFgs
                        });
                    }
                });

                debugLog(`[INFO] ${criticalList.length} databases com alertas CRÍTICOS encontrados`, 'info');

                // Renderizar modal com a lista de críticos
                renderCriticalModal(criticalList, serverId);

            } catch (e) {
                debugLog(` Erro ao carregar alertas críticos: ${e.message}`, 'error');
                modalBody.innerHTML = `
                    <div class="card" style="background: #7f1d1d; border-color: #991b1b;">
                        <h4 style="color: #fca5a5;"><i class="fas fa-exclamation-triangle"></i> Erro</h4>
                        <p style="color: #fecaca;">${e.message}</p>
                    </div>
                `;
                if (modalSubtitle) modalSubtitle.textContent = 'Erro ao carregar alertas críticos';
            }
        }

