                        }))
                    };
                } else if (warningFilegroupsList.length > 0) {
                    spaceErrorType = `${warningFilegroupsList.length} FG >=85% MaxSize`;
                    spaceErrorDetails = {
                        type: 'Warning (=90%)',
                        count: warningFilegroupsList.length,
                        items: warningFilegroupsList.map(fg => ({
                            database: fg.database_name,
                            filegroup: fg.filegroup_name,
                            type: fg.filegroup_type,
                            usage: fg.usage_percent || fg.pct_used,
                            maxsize: fg.maxsize_utilization_percent,
                            volume: fg.volume,
                            diskAvailable: fg.disk_available_gb
                        }))
                    };
                }

                //  NOVO: Detalhes do Overflow (card separado)
                let overflowErrorDetails = null;
                if (overflowFilegroupsList.length > 0) {
                    overflowErrorDetails = {
                        type: 'Overflow',
                        count: overflowFilegroupsList.length,
                        items: overflowFilegroupsList.map(fg => ({
                            database: fg.database_name,
                            filegroup: fg.filegroup_name,
                            type: fg.filegroup_type,
                            usage: fg.usage_percent || fg.pct_used,
                            maxsize: fg.maxsize_utilization_percent,
                            volume: fg.volume,
                            diskAvailable: fg.disk_available_gb
                        }))
                    };
                }

                // Armazenar detalhes globalmente para acesso não modal
                window.spaceHealthDetails = spaceErrorDetails;
                window.overflowDetails = overflowErrorDetails;  //  NOVO: Detalhes do Overflow
                window.spaceHealthServerId = serverId;
                const backupIssues = (backupSummary.success && backupSummary.items) ? backupSummary.items.filter(i=>i.issues&&i.issues.length>0) : [];
                const totalDbs = backupSummary.total_databases || 0;
                // Status de backup para card: 'OK' se sem issues, 'Verificar' se houver qualquer issue/gap
                const backupStatus = backupIssues.length > 0 ? 'Verificar' : 'OK';

                // Top atenção: até 5 entradas (prioridade: serviços críticos down, gaps de padrão, depois issues de FULL/LOG)
                const dbMap = (patt.success ? (patt.databases||{}) : {});
                const attention = [];
                
                // Adicionar serviços críticos down primeiro
                if (servicesStatus.critical_services_down && servicesStatus.critical_services_down.length > 0) {
                    servicesStatus.critical_services_down.forEach(svc => {
                        attention.push({
                            db: 'SERVIO SQL',
                            msg: `${svc.display_name || svc.service_name} est PARADO (${svc.status})`
                        });
                    });
                }
                
                // Depois gaps de backup
                backupIssues.forEach(it=>{
                    const p = dbMap[it.database_name] || {}; const log=p.LOG||{}, diff=p.DIFF||{}, full=p.FULL||{};
                    if (log.delayed_now || diff.delayed_now || full.delayed_now) {
                        attention.push({db: it.database_name, msg: 'GAP detectado não padrão (LOG/DIFF/FULL)'});
                    } else if ((it.issues||[]).length){
                        attention.push({db: it.database_name, msg: (it.issues||[]).join(', ')});
                    }
                });

                // Status de serviços SQL Server
                //  Verificar se dados esto disponveis
                const servicesDataAvailable = servicesStatus.data_available !== false &&
                    (servicesStatus.total_services > 0 || servicesStatus.services.length > 0);
                const servicesHealthy = servicesDataAvailable && servicesStatus.is_healthy !== false;
                const criticalServicesDown = servicesStatus.critical_down || 0;
                const servicesStatusText = !servicesDataAvailable ? 'N/A' :
                    (criticalServicesDown > 0 ? `${criticalServicesDown} DOWN` : 'OK');
                
                // Processar dados CPU e Memória
                debugLog(`[INFO] CPU Data completo: ${JSON.stringify(cpuData)}`, 'info');
                debugLog(`[INFO] Memory Data completo: ${JSON.stringify(memoryData)}`, 'info');
                debugLog(`[INFO] Space Health completo: ${JSON.stringify(spaceHealth)}`, 'info');
                
                // Verificar estrutura dos dados
                debugLog(`[INFO] CPU Data.success: ${cpuData.success}, CPU Data.data: ${cpuData.data ? 'existe' : 'não existe'}`, 'info');
                debugLog(`[INFO] CPU Data.data.sqlserver_cpu_pct: ${cpuData.data.sqlserver_cpu_pct}`, 'info');
                debugLog(`[INFO] Memory Data.success: ${memoryData.success}, Memory Data.data: ${memoryData.data ? 'existe' : 'não existe'}`, 'info');
                debugLog(`[INFO] Memory Data.data.total_server_memory_mb: ${memoryData.data.total_server_memory_mb}, max: ${memoryData.data.max_server_memory_mb}`, 'info');
                
                const cpuPercent = cpuData.success && cpuData.data.sqlserver_cpu_pct !== null && cpuData.data.sqlserver_cpu_pct !== undefined
                    ? Number(cpuData.data.sqlserver_cpu_pct) : null;
                const systemIdle = cpuData.success && cpuData.data.system_idle_pct !== null && cpuData.data.system_idle_pct !== undefined
                    ? Number(cpuData.data.system_idle_pct) : null;
                const cpuCores = cpuData.success && cpuData.data
                    ? `${cpuData.data.physical_cpu_count || 0} físicos / ${cpuData.data.cpu_count || 0} lógicos` : null;
                
                // Tratar caso especial: quando total_server_memory_mb é 0 ou None, SQL Server ainda não alocou memória
                // Isso é normal e não significa que h problema
                // Verificar se os valores existem e não so null/undefined antes de converter
                const memoryTotalMBRaw = memoryData.success && memoryData.data.total_server_memory_mb !== null && memoryData.data.total_server_memory_mb !== undefined ? memoryData.data.total_server_memory_mb : null;
                const memoryMaxMBRaw = memoryData.success && memoryData.data.max_server_memory_mb !== null && memoryData.data.max_server_memory_mb !== undefined ? memoryData.data.max_server_memory_mb : null;
                const memoryTargetMBRaw = memoryData.success && memoryData.data.target_server_memory_mb !== null && memoryData.data.target_server_memory_mb !== undefined ? memoryData.data.target_server_memory_mb : null;
                const physicalRAMGBRaw = memoryData.success && memoryData.data.physical_ram_gb !== null && memoryData.data.physical_ram_gb !== undefined ? memoryData.data.physical_ram_gb : null;
                const processWorkingSetMBRaw = memoryData.success && memoryData.data.process_working_set_mb !== null && memoryData.data.process_working_set_mb !== undefined ? memoryData.data.process_working_set_mb : null;
                const topProcesses = memoryData.success && memoryData.data.top_processes ? memoryData.data.top_processes : [];
                
                // Converter para números
                const memoryTotalMB = memoryTotalMBRaw !== null ? Number(memoryTotalMBRaw) : null;
                const memoryMaxMB = memoryMaxMBRaw !== null ? Number(memoryMaxMBRaw) : null;
                const memoryTargetMB = memoryTargetMBRaw !== null ? Number(memoryTargetMBRaw) : null;
                const physicalRAMGB = physicalRAMGBRaw !== null ? Number(physicalRAMGBRaw) : null;
                const processWorkingSetMB = processWorkingSetMBRaw !== null ? Number(processWorkingSetMBRaw) : null;
                
                // Log detalhado dos valores recebidos
                debugLog(`[INFO] Memory valores brutos - total: ${memoryTotalMBRaw}, max: ${memoryMaxMBRaw}, target: ${memoryTargetMBRaw}, physical: ${physicalRAMGBRaw}, workingSet: ${processWorkingSetMBRaw}`, 'info');
                debugLog(`[INFO] Memory valores convertidos - total: ${memoryTotalMB}, max: ${memoryMaxMB}, target: ${memoryTargetMB}, physical: ${physicalRAMGB}, workingSet: ${processWorkingSetMB}`, 'info');
                
                // Calcular valores formatados
                const memoryMaxGB = memoryMaxMB !== null ? (memoryMaxMB / 1024).toFixed(2) : null;
                const physicalRAMGBFormatted = physicalRAMGB !== null ? physicalRAMGB.toFixed(2) : null;
                const processWorkingSetGB = processWorkingSetMB !== null ? (processWorkingSetMB / 1024).toFixed(2) : null;

                //  NOVA LÓGICA: Usar Working Set quando contadores não disponveis
                // Working Set é a memória REAL que o SQL Server est usando
                let memoryPercent = null;
                let memoryUsedGB = null;
                let memoryStatus = 'N/A';
                let memorySource = 'none'; // Para debug: indica de onde veio o valor

                if (memoryTotalMB !== null && memoryTotalMB > 0 && memoryMaxMB !== null && memoryMaxMB > 0) {
                    // Cenrio ideal: temos Total Server Memory do performance counter
                    memoryPercent = Math.min(100, Math.round((memoryTotalMB / memoryMaxMB) * 100));
                    memoryUsedGB = (memoryTotalMB / 1024).toFixed(2);
                    memoryStatus = `${memoryPercent}%`;
                    memorySource = 'total_server_memory';
                } else if (processWorkingSetMB !== null && processWorkingSetMB > 0 && memoryMaxMB !== null && memoryMaxMB > 0) {
                    // Fallback: usar Working Set (memória real do processo)
                    // Limitar a 100% pois Working Set pode exceder Max Server Memory
                    memoryPercent = Math.min(100, Math.round((processWorkingSetMB / memoryMaxMB) * 100));
                    memoryUsedGB = processWorkingSetGB;
                    memoryStatus = `${memoryPercent}%`;
                    memorySource = 'working_set';
                } else if (processWorkingSetMB !== null && processWorkingSetMB > 0 && physicalRAMGB !== null && physicalRAMGB > 0) {
                    // Fallback 2: usar Working Set vs RAM fsica
                    const physicalRAMMB = physicalRAMGB * 1024;
                    memoryPercent = Math.min(100, Math.round((processWorkingSetMB / physicalRAMMB) * 100));
                    memoryUsedGB = processWorkingSetGB;
                    memoryStatus = `${memoryPercent}%`;
                    memorySource = 'working_set_vs_physical';
                }

