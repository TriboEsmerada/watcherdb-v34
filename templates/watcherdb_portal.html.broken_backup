                          score.trend === 'DEGRADING' ? 'var(--color-danger)' : 'var(--color-text-secondary)';
        const risks = score.top_risks.slice(0, 3) || [];

        return `
            <div class="server-card" style="cursor: pointer; border-left: 4px solid ${levelColor};"
                 onclick="MaintenanceScore.showDetails('${score.instance_id}')">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
