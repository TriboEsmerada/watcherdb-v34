        async function toggleFilegroup(dbName, fgName, serverId, fgId) {
            debugLog(`[INFO] Toggle Filegroup: ${fgName}`, 'info');
            
            const filesRow = document.getElementById(`files-row-${fgId}`);
            const toggleBtn = document.getElementById(`toggle-fg-${fgId}`);
            const filesContent = document.getElementById(`files-content-${fgId}`);
            
            if (filesRow.style.display === 'table-row') {
                filesRow.style.display = 'none';
                toggleBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
                debugLog(` ${fgName} colapsado`, 'success');
                return;
            }
            
            toggleBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            filesContent.innerHTML = '<div style="color: #60a5fa;">Carregando datafiles...</div>';
            
            try {
                const apiUrl = `/api/monitoring/space/database/${serverId}/${encodeURIComponent(dbName)}/files`;
                debugLog(`[INFO] API Files: ${apiUrl}`, 'info');
                
                const response = await createFetchWithAbort(apiUrl);
                const result = await response.json();
                
                if (!result.success || !result.files) {
                    throw new Error(result.error || 'Sem datafiles');
                }
                
                const filesInFg = result.files.filter(f => f.filegroup_name === fgName);
                
                debugLog(` ${filesInFg.length} files não FG "${fgName}"`, 'success');
                
                if (filesInFg.length === 0) {
                    throw new Error(`Nenhum file encontrado não filegroup "${fgName}"`);
                }
                
                let html = `
                    <div style="background: #000; padding: 12px; border-left: 4px solid #3b82f6;">
                        <div style="color: #60a5fa; font-weight: bold; margin-bottom: 12px; font-size: 13px;">
                            [INFO] DATAFILES (${filesInFg.length} arquivos)
                        </div>
                        <div style="max-height: 300px; overflow-y: auto;">
                        <table class="nested-table" style="font-size: 12px;">
                            <thead style="position: sticky; top: 0; background: #000; z-index: 10;">
                                <tr>
                                    <th style="padding-left: 48px; min-width: 250px; background: #000;">Logical Name</th>
                                    <th style="text-align: right; background: #000;">Current MB</th>
                                    <th style="text-align: right; background: #000;">Max MB</th>
                                    <th style="text-align: left; background: #000;">Growth</th>
                                    <th style="text-align: center; background: #000;">Type</th>
                                    <th style="text-align: center; background: #000;">Volume</th>
                                    <th style="text-align: right; background: #000;">Disk Avail GB</th>
                                    <th style="text-align: center; background: #000;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                
                filesInFg.forEach(file => {
                    // Suporte a campos novos do WatcherDB Intelligence e fallback para campos antigos
                    const currentMB = parseFloat(file.size_mb || file.current_size_mb) || 0;
                    const usedMB = parseFloat(file.used_mb) || 0;
                    const freeMB = parseFloat(file.free_mb) || 0;
                    const maxMB = parseFloat(file.max_size_mb) || 0;
                    const percentUsed = parseFloat(file.percent_used) || 0;
                    const autogrowPotentialMB = parseFloat(file.autogrow_potential_mb) || 0;
                    const volumeFreeMB = parseFloat(file.volume_free_mb) || 0;
                    const diskAvailGB = volumeFreeMB > 0 ? volumeFreeMB / 1024 : (parseFloat(file.disk_available_gb) || 0);
                    const isUnlimited = file.is_unlimited || false;
                    const maxSizeStr = isUnlimited ? 'UNLIMITED' : (file.max_size_formatted || (maxMB > 0 ? maxMB.toFixed(2) : 'UNLIMITED'));
                    const fileType = (file.type || file.file_type || '').toUpperCase();
                    const isDataFile = (fileType === 'ROWS');
                    // Usar status do WatcherDB Intelligence se disponivel
                    const intelligenceStatus = file.status || '';
                    const hasOverflowRisk = file.overflow_risk || intelligenceStatus === 'OVERFLOW_RISK';
                    const hasNearMaxsize = file.near_maxsize || intelligenceStatus === 'NEAR_MAXSIZE';
                    const hasNoGrowth = file.no_growth || intelligenceStatus === 'NO_GROWTH';
                    // Fallback para calculo local se status nao vier do Intelligence
                    const hasOverflow = hasOverflowRisk || (isDataFile &&
                                       maxSizeStr !== 'UNLIMITED' &&
                                       (maxMB / 1024) > diskAvailGB &&
                                       diskAvailGB > 0);
                    let statusClass = 'ok';
                    let statusText = 'OK';
                    let rowStyle = '';
                    // Prioridade: OVERFLOW_RISK > NEAR_MAXSIZE > NO_GROWTH > UNLIMITED > OK
                    if (hasOverflow || hasOverflowRisk) {
                        statusClass = 'critical';
                        statusText = 'OVERFLOW';
                        rowStyle = 'background: rgba(127, 29, 18, 0.3);';
                    } else if (hasNearMaxsize) {
                        statusClass = 'warning';
                        statusText = 'NEAR MAX';
                        rowStyle = 'background: rgba(180, 83, 9, 0.2);';
                    } else if (hasNoGrowth) {
                        statusClass = 'warning';
                        statusText = 'NO GROWTH';
                        rowStyle = 'background: rgba(180, 83, 9, 0.15);';
                    } else if (isUnlimited || maxSizeStr === 'UNLIMITED') {
                        statusText = 'UNLIMITED';
                        statusClass = 'ok';
                    } else if (!isDataFile) {
                        statusText = 'LOG FILE';
                        statusClass = 'ok';
                    }
                    
                    const logicalNameDisplay = file.logical_name.length > 35 ?
                         file.logical_name.substring(0, 32) + '...' :
                         file.logical_name;
                    
                    html += `
                        <tr style="${rowStyle}">
                            <td style="padding-left: 48px;" title="${file.physical_name}">
                                <i class="fas fa-file-alt" style="color: #60a5fa; margin-right: 6px;"></i>
                                <span style="font-family: monospace; font-size: 11px;">${logicalNameDisplay}</span>
                            </td>
                            <td style="text-align: right; font-family: monospace;">${currentMB.toFixed(2)}</td>
                            <td style="text-align: right; font-family: monospace; ${hasOverflow ? 'color: #fca5a5; font-weight: bold;' : ''}">${maxMB.toFixed(2)}</td>
                            <td style="text-align: left; font-size: 11px;">${file.growth_increment || 'N/A'}</td>
                            <td style="text-align: center;">
                                <span style="background: ${file.file_type === 'ROWS' ? '#065f46' : '#1e3a8a'}; 
                                             padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold;">
                                    ${file.file_type || 'N/A'}
                                </span>
                            </td>
                            <td style="text-align: center; font-family: monospace; font-size: 11px; font-weight: bold;">
                                ${file.volume || 'N/A'}
                            </td>
                            <td style="text-align: right; font-family: monospace; ${diskAvailGB < 100 ? 'color: #fbbf24;' : ''}">${diskAvailGB.toFixed(2)}</td>
                            <td style="text-align: center;">
                                <span class="badge ${statusClass}" style="font-size: 9px;">${statusText}</span>
                            </td>
                        </tr>
                    `;
                });
                
                html += `
                            </tbody>
                        </table>
                        </div>
                    </div>
                `;

                filesContent.innerHTML = html;
                filesRow.style.display = 'table-row';
                toggleBtn.innerHTML = '<i class="fas fa-chevron-down"></i>';
                debugLog(` Filegroup "${fgName}" expandido com ${filesInFg.length} files`, 'success');
                
            } catch (error) {
                debugLog(` Erro não Filegroup: ${error.message}`, 'error');
                filesContent.innerHTML = `
