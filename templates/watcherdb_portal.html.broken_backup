                    { id: 'missing-index-analysis', name: 'Análise ndices Faltantes', endpoint: `/api/queries/missing-index-analysis/${serverId}`, requiresDb: true, category: 'analysis' }
                ];
                
                // Carregar queries customizadas
                let customQueries = [];
                try {
                    const customRes = await createFetchWithAbort('/api/config/custom-queries');
                    if (customRes && customRes.ok) {
                        customQueries = await customRes.json();
                        // Converter queries customizadas para o formato esperado
                        customQueries = customQueries.map(q => ({
                            id: q.id,
                            name: q.name,
                            endpoint: `/api/queries/custom/${serverId}`,
                            requiresDb: q.requiresDb || false,
