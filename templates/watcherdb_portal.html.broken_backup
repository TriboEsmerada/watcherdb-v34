                if (html.includes('<div style="padding: var(--space-lg);">') && !html.match(/<\/div>\s*<\/div>\s*$/)) {
                    html += '</div>';
                }
                
                debugLog(`[INFO] Renderizando HTML Always On (${html.length} caracteres)`, 'info');
                content.innerHTML = html;
                debugLog(` Always On renderizado com sucesso`, 'info');
                
            } catch (error) {
                debugLog(` Erro ao carregar Always On: ${error.message}`, 'error');
                debugLog(` Stack: ${error.stack}`, 'error');
                content.innerHTML = `
                    <div class="card" style="background: #7f1d1d; border-color: #991b1b;">
                        <h4 style="color: #fca5a5;"><i class="fas fa-exclamation-triangle"></i> Erro ao Carregar Always On</h4>
                        <p style="color: #fecaca; margin-top: 8px;">${error.message || 'Erro desconhecido'}</p>
                        <p style="color: #94a3b8; font-size: 12px; margin-top: 12px;">
