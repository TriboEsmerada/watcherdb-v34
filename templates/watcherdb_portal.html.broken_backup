                                                            <td style="padding: 12px;">
                                                                <span style="background: ${healthColor}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold;">
                                                                    ${d.synchronization_health || 'N/A'}
                                                                </span>
                                                            </td>
                                                            <td style="padding: 12px; color: ${d.database_state === 'ONLINE' ? '#10b981' : '#ef4444'};">
                                                                <strong>${d.database_state || 'N/A'}</strong>
                                                            </td>
                                                            <td style="padding: 12px; color: ${d.is_suspended ? '#ef4444' : '#10b981'};">
                                                                <strong>${d.is_suspended ? 'Sim' : 'No'}</strong>
                                                            </td>
                                                            <td style="padding: 12px;">${d.log_send_queue_size || 'N/A'}</td>
                                                            <td style="padding: 12px;">${d.redo_queue_size || 'N/A'}</td>
                                                        </tr>
                                                        `;
                                                    }).join('')}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                        
                        html += `
                            </div>
                        `;
                    }

                    // Eventos recentes e padrões
                    html += `
                        <div class="card">
                            <h4>Eventos e Padrões (30 dias)</h4>
                            ${eventsPayload.total_events === 0 ? '<p style="color:#94a3b8;">Nenhum evento de Always On encontrado.</p>' : ''}
                            ${eventsPayload.total_events > 0 ? `
                                <div style="overflow-x:auto; margin-top: 12px;">
