            // Buscar dados de alertas preditivos e também dados de serviços, CPU e memória
            try {
                const serverIdFormatted = serverId.replace(/\\/g, '_');
                const [alertsData, servicesData, cpuData, memoryData] = await Promise.all([
                    loadPredictiveAlerts(serverId),
                    processResponse(fetchWithTimeout(`/api/monitoring/services/server/${serverIdFormatted}`), { is_healthy: true, critical_down: 0 }),
                    processResponse(fetchWithTimeout(`/api/monitoring/cpu/server/${serverIdFormatted}`), { success: false, data: {} }),
                    processResponse(fetchWithTimeout(`/api/monitoring/memory/server/${serverIdFormatted}`), { success: false, data: {} })
                ]);
                displayPredictiveAlerts(alertsData, servicesData, cpuData, memoryData);
            } catch (error) {
                debugLog(` Erro ao carregar alertas preditivos: ${error.message}`, 'error');
                showPredictiveAlertsError(error.message);
            }
        }

