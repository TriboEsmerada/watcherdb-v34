            toggleBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            fgContent.innerHTML = 'Carregando filegroups...';
            
            try {
                const apiUrl = `/api/monitoring/space/database/${serverId}/${encodeURIComponent(dbName)}/filegroups?t=${Date.now()}`;
                debugLog(`[INFO] API: ${apiUrl}`, 'info');
                
                const response = await createFetchWithAbort(apiUrl);
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: `HTTP ${response.status}` }));
                    throw new Error(errorData.error || `Erro HTTP ${response.status}`);
                }
                
                const result = await response.json();
                
                if (!result.success) {
                    throw new Error(result.error || 'Erro ao buscar filegroups');
                }
                
