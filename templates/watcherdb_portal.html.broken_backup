        // Funo para detectar qual endpoint de KPI est disponível
        let cachedKpiEndpoint = null;
        async function detectKpiEndpoint(forceRefresh = false) {
            // Se já detectamos antes e não for refresh forado, usar o cache
            if (cachedKpiEndpoint && !forceRefresh) {
                return cachedKpiEndpoint;
            }
            
            debugLog('[INFO] Detectando endpoint de KPI disponível...', 'info');
            
            // PRIMEIRO: Tentar identificar o tipo de servidor via /api/server-info
            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), 1000);
                const serverInfoResponse = await fetch('/api/server-info', { 
                    method: 'GET',
                    signal: controller.signal
                });
                clearTimeout(timeout);
                
                if (serverInfoResponse.ok) {
                    const serverInfo = await serverInfoResponse.json();
                    if (serverInfo.kpi_endpoint) {
                        cachedKpiEndpoint = serverInfo.kpi_endpoint;
                        debugLog(` Servidor identificado via /api/server-info: ${serverInfo.server_type} -> ${serverInfo.kpi_endpoint}`, 'success');
                        return cachedKpiEndpoint;
                    }
                }
            } catch (e) {
                debugLog(`[INFO] Não foi possível identificar servidor via /api/server-info: ${e.message}`, 'info');
            }
            
            // FALLBACK: Tentar ambos simultaneamente para ser mais rápido
            const promises = [
                // Tentar Intelligence primeiro (prioridade)
                (async () => {
                    try {
                        const controller = new AbortController();
                        const timeout = setTimeout(() => controller.abort(), 2000);
                        const response = await fetch('/api/intelligence-kpis/dashboard', { 
                            method: 'GET',
                            signal: controller.signal
                        });
                        clearTimeout(timeout);
                        
                        if (response.ok) {
                            const data = await response.json();
                            if (data.success) {
                                return { endpoint: '/api/intelligence-kpis/dashboard', source: 'Intelligence', priority: 1 };
                            }
                        }
                    } catch (e) {
                        // Ignorar erro
                    }
                    return null;
                })(),
                
                // Tentar Oracle (menor prioridade)
                (async () => {
                    try {
                        const controller = new AbortController();
                        const timeout = setTimeout(() => controller.abort(), 2000);
                        const response = await fetch('/api/oracle-kpis/dashboard', { 
                            method: 'GET',
                            signal: controller.signal
                        });
                        clearTimeout(timeout);
                        
                        if (response.ok) {
                            const data = await response.json();
                            if (data.success) {
                                return { endpoint: '/api/oracle-kpis/dashboard', source: 'Oracle', priority: 2 };
                            }
                        }
                    } catch (e) {
                        // Ignorar erro
                    }
                    return null;
                })()
            ];
            
            // Aguardar ambos e pegar o de maior prioridade (menor número = maior prioridade)
            const results = await Promise.all(promises);
            const available = results
                .filter(r => r !== null)
                .sort((a, b) => a.priority - b.priority)[0]; // Ordenar por prioridade
            
            if (available) {
                cachedKpiEndpoint = available.endpoint;
                debugLog(` Endpoint detectado: ${available.source} KPIs (${available.endpoint})`, 'success');
                return cachedKpiEndpoint;
            }
            
            // Se nenhum funcionou, tentar com timeout manual (fallback para navegadores antigos)
            try {
                const intelController = new AbortController();
                const intelTimeout = setTimeout(() => intelController.abort(), 2000);
                const intelResponse = await fetch('/api/intelligence-kpis/dashboard', { 
                    method: 'GET',
                    signal: intelController.signal
                });
                clearTimeout(intelTimeout);
                
                if (intelResponse.ok) {
                    const intelData = await intelResponse.json();
                    if (intelData.success) {
                        cachedKpiEndpoint = '/api/intelligence-kpis/dashboard';
                        debugLog(' Endpoint detectado: Intelligence KPIs (fallback)', 'success');
                        return cachedKpiEndpoint;
                    }
                }
            } catch (e) {
                // Ignorar
            }
            
            try {
                const oracleController = new AbortController();
                const oracleTimeout = setTimeout(() => oracleController.abort(), 2000);
                const oracleResponse = await fetch('/api/oracle-kpis/dashboard', { 
                    method: 'GET',
                    signal: oracleController.signal
                });
                clearTimeout(oracleTimeout);
                
                if (oracleResponse.ok) {
                    const oracleData = await oracleResponse.json();
                    if (oracleData.success) {
                        cachedKpiEndpoint = '/api/oracle-kpis/dashboard';
                        debugLog(' Endpoint detectado: Oracle KPIs (fallback)', 'success');
                        return cachedKpiEndpoint;
                    }
                }
            } catch (e) {
                // Ignorar
            }
            
            // Fallback padrão: Intelligence KPIs (WatcherDB Intelligence)
            cachedKpiEndpoint = '/api/intelligence-kpis/dashboard';
            debugLog('[INFO] Nenhum endpoint detectado, usando padrão: Intelligence KPIs', 'warning');
            return cachedKpiEndpoint;
        }
        
