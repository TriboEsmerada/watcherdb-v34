        // ============================================================================
        // TAPOS PORTAL - ALERTAS PREDITIVOS AGREGADOS - FRONTEND v2
        // ============================================================================
        // Atualizado para mostrar análise agregada por filegroup
        // ============================================================================

        /**
         * Exibe alertas preditivos agregados não painel
         * VERSO 2: Mostra contexto de múltiplos datafiles
         * VERSO 3: Inclui informações sobre serviços, CPU e memória
         */
        function displayPredictiveAlerts(data, servicesData = null, cpuData = null, memoryData = null) {
            const content = document.getElementById('predictiveAlertsContent');
            const healthBadge = document.getElementById('healthScoreBadge');
            
            // Verificar se os elementos existem
            if (!content) {
                debugLog('[INFO] predictiveAlertsContent não encontrado', 'warning');
                return;
            }
            
            // Badge de health score (verificar se existe antes de usar)
            if (healthBadge) {
            const healthScore = data.predictive_health_score;
            let scoreColor = '#10b981';
            let scoreIcon = '';
            
            if (healthScore < 50) {
                scoreColor = '#ef4444';
                scoreIcon = '[INFO]';
            } else if (healthScore < 70) {
                scoreColor = '#f59e0b';
                scoreIcon = '[INFO]';
            } else if (healthScore < 85) {
                scoreColor = '#eab308';
                scoreIcon = '[INFO]';
            }
            
            healthBadge.innerHTML = `
                <span style="background: ${scoreColor}20; color: ${scoreColor}; padding: 4px 12px; border-radius: 12px; font-weight: bold;">
                    ${scoreIcon} ${healthScore}%
                </span>
            `;
            }
            
            // Processar dados de serviços, CPU e memória
            const servicesHealthy = servicesData.is_healthy !== false;
            const criticalServicesDown = servicesData.critical_down || 0;
            const servicesStatusText = criticalServicesDown > 0 ? `${criticalServicesDown} DOWN` : 'OK';
            const servicesOK = servicesHealthy && criticalServicesDown === 0;
            const servicesError = servicesData.error || (criticalServicesDown > 0 ? `${criticalServicesDown} servio(s) crítico(s) parado(s)` : null);
            
            const cpuPercent = cpuData.success && cpuData.data.sqlserver_cpu_pct !== null && cpuData.data.sqlserver_cpu_pct !== undefined ?
                cpuData.data.sqlserver_cpu_pct : null;
            const cpuOK = cpuData.success && cpuPercent !== null;
            const cpuError = cpuData.error || (!cpuData.success ? 'Não foi possível obter dados de CPU' : null);
            const cpuWarning = cpuPercent !== null && cpuPercent >= 80 ? `CPU em ${cpuPercent}% (alto uso)` : null;
            
            //  NOVA LÓGICA: Usar Working Set quando contadores não disponveis (igual ao card principal)
            const memoryTotalMB = memoryData.success && memoryData.data.total_server_memory_mb ? Number(memoryData.data.total_server_memory_mb) : null;
            const memoryMaxMB = memoryData.success && memoryData.data.max_server_memory_mb ? Number(memoryData.data.max_server_memory_mb) : null;
            const processWorkingSetMB = memoryData.success && memoryData.data.process_working_set_mb ? Number(memoryData.data.process_working_set_mb) : null;
            const physicalRAMGB = memoryData.success && memoryData.data.physical_ram_gb ? Number(memoryData.data.physical_ram_gb) : null;

            // Calcular memoryPercent usando a mesma lógica do card principal
            let memoryPercent = null;
            if (memoryTotalMB !== null && memoryTotalMB > 0 && memoryMaxMB !== null && memoryMaxMB > 0) {
                memoryPercent = Math.round((memoryTotalMB / memoryMaxMB) * 100);
            } else if (processWorkingSetMB !== null && processWorkingSetMB > 0 && memoryMaxMB !== null && memoryMaxMB > 0) {
                memoryPercent = Math.round((processWorkingSetMB / memoryMaxMB) * 100);
            } else if (processWorkingSetMB !== null && processWorkingSetMB > 0 && physicalRAMGB !== null && physicalRAMGB > 0) {
                const physicalRAMMB = physicalRAMGB * 1024;
                memoryPercent = Math.round((processWorkingSetMB / physicalRAMMB) * 100);
            }

            const memoryNotAllocated = false; // No usar mais este estado
            const memoryOK = memoryData.success && memoryPercent !== null;
            const memoryError = memoryData.error || (!memoryData.success ? 'Não foi possível obter dados de memória' : null);
            const memoryWarning = memoryPercent !== null && memoryPercent >= 90 ? `Memória em ${memoryPercent}% (alto uso)` : null;
            
            // Determinar status geral
            const allOK = servicesOK && cpuOK && memoryOK && !cpuWarning && !memoryWarning;
            const issues = [];
            if (!servicesOK) issues.push({ type: 'services', message: servicesError || 'Serviços SQL com problemas' });
            if (!cpuOK) issues.push({ type: 'cpu', message: cpuError || 'CPU não disponível' });
            if (cpuWarning) issues.push({ type: 'cpu', message: cpuWarning });
            if (!memoryOK) issues.push({ type: 'memory', message: memoryError || 'Memória não disponível' });
            if (memoryWarning) issues.push({ type: 'memory', message: memoryWarning });
            
            // Determinar cores
            const servicesColor = servicesHealthy ? '#10b981' : '#ef4444';
            const cpuColor = cpuPercent !== null ? (cpuPercent >= 80 ? '#ef4444' : cpuPercent >= 60 ? '#f59e0b' : '#10b981') : '#6b7280';
            const memoryColor = memoryNotAllocated ? '#3b82f6' : (memoryPercent !== null ? (memoryPercent >= 90 ? '#ef4444' : memoryPercent >= 70 ? '#f59e0b' : '#10b981') : '#6b7280');
            const memoryStatusText = memoryNotAllocated ? 'Aguardando alocao' : (memoryPercent !== null ? `${memoryPercent}%` : 'N/A');
            
            if (data.total_alerts === 0) {
                content.innerHTML = `
                    <div style="text-align: center; padding: 40px 20px; background: linear-gradient(135deg, #064e3b 0%, #022c22 100%); border-radius: 8px; margin-bottom: 20px;">
                        <i class="fas fa-shield-check" style="font-size: 48px; color: #10b981; margin-bottom: 16px;"></i>
                        <h3 style="color: #10b981; font-size: 18px; margin-bottom: 8px;">Sistema Saudvel</h3>
                        <p style="color: #6ee7b7; font-size: 14px;">
                            Nenhum alerta preditivo detectado.<br>
                            ${data.total_filegroups_analyzed} filegroups analisados - todos operando normalmente.
                        </p>
                    </div>
                    
                    <!-- Informaes de Serviços, CPU e Memória - Texto informativo -->
                    <div style="background: ${allOK ? 'rgba(16, 185, 129, 0.1)' : 'rgba(239, 68, 68, 0.1)'}; border-left: 3px solid ${allOK ? '#10b981' : '#ef4444'}; padding: 12px; border-radius: 6px; margin-top: 16px;">
                        <div style="color: ${allOK ? '#6ee7b7' : '#fca5a5'}; font-size: 12px; line-height: 1.6;">
                            <i class="fas ${allOK ? 'fa-check-circle' : 'fa-exclamation-triangle'}" style="margin-right: 6px;"></i>
                            <strong>Status do Sistema:</strong> 
                            Serviços SQL: <span style="color: ${servicesOK ? '#10b981' : '#ef4444'};">${servicesOK ? 'OK' : 'Not OK'}</span> | 
                            CPU: <span style="color: ${cpuOK && !cpuWarning ? '#10b981' : cpuWarning ? '#f59e0b' : '#ef4444'};">${cpuOK && !cpuWarning ? 'OK' : cpuWarning ? cpuWarning : 'Not OK'}</span> | 
                            Memória: <span style="color: ${memoryNotAllocated ? '#3b82f6' : (memoryOK && !memoryWarning ? '#10b981' : memoryWarning ? '#f59e0b' : '#ef4444')};">${memoryNotAllocated ? 'OK (Aguardando alocao)' : (memoryOK && !memoryWarning ? 'OK' : memoryWarning ? memoryWarning : 'Not OK')}</span>
                        </div>
                    </div>
                    ${issues.length > 0 ? `
                    <!-- Box de Erros/Alertas -->
                    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 6px; padding: 16px; margin-top: 12px;">
                        <div style="color: #fca5a5; font-size: 13px; font-weight: 600; margin-bottom: 8px;">
                            <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i>Problemas Detectados:
                        </div>
                        <ul style="margin: 0; padding-left: 20px; color: #fecaca; font-size: 12px; line-height: 1.8;">
                            ${issues.map(issue => `<li>${issue.message}</li>`).join('')}
                        </ul>
                    </div>
                    ` : ''}
                `;
                return;
