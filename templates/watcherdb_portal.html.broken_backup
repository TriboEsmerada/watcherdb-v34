                            margin-top: 4px;
                        }
                        .tempdb-status-ok .tempdb-metric-value { color: #22c55e; }
                        .tempdb-status-warning .tempdb-metric-value { color: #f59e0b; }
                        .tempdb-status-critical .tempdb-metric-value { color: #ef4444; }
                        .tempdb-villain-title {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            font-size: 16px;
                            font-weight: 600;
                            color: #e2e8f0;
                            margin-bottom: 12px;
                        }
                    </style>

                    <!-- Card de Overview do TempDB v2.6 -->
                    <div class="tempdb-overview-card">
                        <div class="tempdb-overview-header">
                            <div class="tempdb-overview-icon">
                                <i class="fas fa-database"></i>
                            </div>
                            <div>
                                <div class="tempdb-overview-title">TempDB Overview</div>
                                <div class="tempdb-overview-subtitle">
                                    Servidor: ${serverIdForDiagnosis || 'N/A'}
                                </div>
                            </div>
                            <div style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
                                <i class="fas ${statusIcon} ${statusClass}" style="font-size: 20px;"></i>
                                <span class="${statusClass}" style="font-weight: 600;">${statusText}</span>
                            </div>
                        </div>
                        ${diskWarning ? `
                        <div style="background: ${statusClass === 'tempdb-status-critical' ? 'rgba(239, 68, 68, 0.2)' : 'rgba(245, 158, 11, 0.2)'};
                                    border: 1px solid ${statusClass === 'tempdb-status-critical' ? '#ef4444' : '#f59e0b'};
                                    border-radius: 8px; padding: 12px; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
                            <i class="fas fa-hdd" style="font-size: 24px; color: ${statusClass === 'tempdb-status-critical' ? '#ef4444' : '#f59e0b'};"></i>
                            <div>
                                <div style="font-weight: 600; color: ${statusClass === 'tempdb-status-critical' ? '#ef4444' : '#f59e0b'};">${diskWarning}</div>
                                <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">
                                    Arquivo TempDB: ${(fileSizeOnDiskMb/1024).toFixed(1)} GB não disco |
                                    Disco: ${(diskTotalMb/1024).toFixed(0)} GB total, ${(diskFreeMb/1024).toFixed(1)} GB livres
                                </div>
                            </div>
                            <button onclick="showTempDBGrowthAnalysisModal('${serverIdForDiagnosis}')"
                                    style="margin-left: auto; background: ${statusClass === 'tempdb-status-critical' ? '#ef4444' : '#f59e0b'};
                                           color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;">
                                <i class="fas fa-chart-line"></i> Analisar Crescimento
                            </button>
                        </div>
                        ` : ''}
                        <div class="tempdb-metrics" style="display: grid; grid-template-columns: repeat(${fileSizeOnDiskMb > 0 ? '6' : '4'}, 1fr); gap: 16px;">
                            ${fileSizeOnDiskMb > 0 ? `
                            <div class="tempdb-metric" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 12px; text-align: center;">
                                <div class="tempdb-metric-value" style="color: #ef4444;">${(fileSizeOnDiskMb/1024).toFixed(1)} GB</div>
                                <div class="tempdb-metric-label">Arquivo em Disco</div>
                            </div>
                            <div class="tempdb-metric" style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; padding: 12px; text-align: center;">
                                <div class="tempdb-metric-value" style="color: #3b82f6;">${(diskFreeMb/1024).toFixed(1)} GB</div>
                                <div class="tempdb-metric-label">Disco Livre</div>
                            </div>
                            ` : ''}
                            <div class="tempdb-metric">
                                <div class="tempdb-metric-value">${parseFloat(overviewRow.total_mb || 0).toLocaleString('pt-BR', {maximumFractionDigits: 0})} MB</div>
                                <div class="tempdb-metric-label">Alocado Interno</div>
                            </div>
                            <div class="tempdb-metric">
                                <div class="tempdb-metric-value">${parseFloat(overviewRow.used_mb || 0).toLocaleString('pt-BR', {maximumFractionDigits: 0})} MB</div>
                                <div class="tempdb-metric-label">Em Uso</div>
                            </div>
                            <div class="tempdb-metric">
                                <div class="tempdb-metric-value">${parseFloat(overviewRow.free_mb || 0).toLocaleString('pt-BR', {maximumFractionDigits: 0})} MB</div>
                                <div class="tempdb-metric-label">Livre Interno</div>
                            </div>
                            <div class="tempdb-metric ${statusClass}">
                                <div class="tempdb-metric-value">${parseFloat(overviewRow.used_percent || 0).toFixed(1)}%</div>
                                <div class="tempdb-metric-label">Uso Interno</div>
                            </div>
                        </div>
                    </div>
                `;

                // Se não há viles, mostrar mensagem
                if (villainRows.length === 0) {
                    tempdbHtml += `
                        <div style="text-align: center; padding: 40px 20px; color: #94a3b8; background: rgba(15, 23, 42, 0.4); border-radius: 8px;">
                            <i class="fas fa-check-circle" style="font-size: 48px; margin-bottom: 16px; color: #22c55e; opacity: 0.7;"></i>
                            <p style="font-size: 16px; margin: 0;">Nenhuma sessão consumindo TempDB excessivamente</p>
                            <p style="font-size: 12px; margin-top: 8px; opacity: 0.7;">Todas as sessões esto dentro dos parmetros normais.</p>
                        </div>
                    `;
                    container.innerHTML = tempdbHtml;
                    return;
                }

                // Colunas relevantes para viles (excluindo colunas de overview e sort_order)
                // v2.5 - Adicionado idle_time_minutes, user_objects_mb, internal_objects_mb
                const villainColumns = [
                    'session_id', 'login_name', 'host_name', 'program_name', 'database_name',
                    'space_used_mb', 'user_objects_mb', 'internal_objects_mb', 'percent_of_tempdb',
                    'status', 'idle_time_minutes', 'command',
                    'wait_type', 'wait_time_ms', 'cpu_time_ms', 'query_text'
                ];

                // Mapeamento de nomes amigveis para viles
                const villainColumnNames = {
                    'session_id': 'SPID',
                    'login_name': 'Usurio',
                    'host_name': 'Host',
                    'program_name': 'Programa',
                    'database_name': 'Database',
                    'space_used_mb': 'Total (MB)',
                    'user_objects_mb': 'User Obj',
                    'internal_objects_mb': 'Internal Obj',
                    'percent_of_tempdb': '% TempDB',
                    'status': 'Status',
                    'idle_time_minutes': 'Idle (min)',
                    'command': 'Comando',
                    'wait_type': 'Wait Type',
                    'wait_time_ms': 'Wait (ms)',
                    'cpu_time_ms': 'CPU (ms)',
                    'query_text': 'Query SQL'
                };

                // Contar sessões com idle alto (>=30 minutos)
                const highIdleSessions = villainRows.filter(r => {
                    const idle = parseInt(r.idle_time_minutes);
                    return !isNaN(idle) && idle >= 30;
                });
                const highIdleCount = highIdleSessions.length;

                // Título da tabela de sessões consumidoras
                tempdbHtml += `
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 12px;">
                        <div class="tempdb-villain-title" style="margin-bottom: 0;">
