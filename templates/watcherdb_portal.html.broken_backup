        // ========================================
        // LOG ANALYSIS TAB
        // ========================================
        async function loadLogAnalysis() {
            const content = activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea');
            if (!content) return;
            const serverId = selectedServer.server_id;
            debugLog(`[INFO] Carregando Log Analysis...`, 'info');
            debugLog(`[INFO] Server ID: ${serverId}`, 'info');

            content.innerHTML = createPremiumLoading('Carregando análise de logs...');

            try {
                const hours = parseInt(localStorage.getItem('log_hours')||'24',10);
                const logType = localStorage.getItem('log_type') || 'all';

                // Buscar logs do Windows e SQL Server em paralelo
                const [windowsLogsRes, sqlLogsRes] = await Promise.all([
                    createFetchWithAbort(`/api/monitoring/windows-events/${serverId}?hours=${hours}`).catch(() => null),
                    createFetchWithAbort(`/api/monitoring/sql-errors/${serverId}?hours=${hours}`).catch(() => null)
                ]);

                // Verificar se as requisições foram bem-sucedidas
                let windowsData, sqlData;
                
                if (!windowsLogsRes || !windowsLogsRes.ok || windowsLogsRes.status === 404) {
                    windowsData = { success: false, error: windowsLogsRes && windowsLogsRes.status === 404 ? 'Endpoint não disponível' : 'Erro ao conectar', events: [] };
                    debugLog(` Windows logs response error: ${windowsLogsRes.status || 'no response'}`, 'error');
                } else {
                    try {
                        windowsData = await windowsLogsRes.json();
                        debugLog(` Windows logs response OK: success=${windowsData.success}, events=${windowsData.events.length || 0}`, 'info');
                    } catch (e) {
                        windowsData = { success: false, error: 'Erro ao processar resposta', events: [] };
                        debugLog(` Erro ao parsear Windows logs JSON: ${e.message}`, 'error');
                    }
                }
                
                if (!sqlLogsRes || !sqlLogsRes.ok || sqlLogsRes.status === 404) {
                    sqlData = { success: false, error: sqlLogsRes && sqlLogsRes.status === 404 ? 'Endpoint não implementado ainda' : 'Erro ao conectar', errors: [] };
                } else {
                    try {
                        sqlData = await sqlLogsRes.json();
                    } catch (e) {
                        sqlData = { success: false, error: 'Erro ao processar resposta', errors: [] };
                    }
                }

                const windowsEvents = windowsData.success && windowsData.events ? windowsData.events : [];
                const sqlErrors = sqlData.success && sqlData.errors ? sqlData.errors : [];

                // Log informativo com detalhes
                debugLog(`[INFO] Dados recebidos - Windows success: ${windowsData.success}, Events: ${windowsEvents.length}, SQL success: ${sqlData.success}, Errors: ${sqlErrors.length}`, 'info');
                if (windowsEvents.length > 0) {
                    debugLog(`[INFO] Primeiro evento Windows: ${JSON.stringify(windowsEvents[0]).substring(0, 200)}`, 'info');
                }
                if (sqlErrors.length > 0) {
                    debugLog(`[INFO] Primeiro erro SQL: ${JSON.stringify(sqlErrors[0]).substring(0, 200)}`, 'info');
                }

                // Usar o mesmo elemento que foi usado para o loading
                const targetContent = activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea');
                renderLogAnalysis({
                    windowsEvents,
                    sqlErrors,
                    windowsSuccess: windowsData.success !== false,
                    sqlSuccess: sqlData.success !== false,
                    windowsError: windowsData.error,
                    sqlError: sqlData.error
                }, serverId, hours, logType, targetContent);

            } catch (err) {
                // Ignorar erros de abort
                if (err.isAbort || err.name === 'AbortError') {
                    debugLog(`[INFO] Log Analysis cancelado (aba fechada)`, 'info');
                    return;
                }
                debugLog(` Log Analysis error: ${err.message}`, 'error');
                if (content) {
                content.innerHTML = `<div class=\"error\">Erro: ${err.message}</div>`;
                }
            }
        }

        function renderLogAnalysis(data, serverId, hours, currentLogType, contentElement = null) {
            // Usar o elemento passado como parmetro ou tentar encontrar o contentArea
            const content = contentElement || document.getElementById('contentArea');
            if (!content) {
                debugLog(` Elemento de conteúdo não encontrado`, 'error');
                return;
            }
            
            const { windowsEvents, sqlErrors, windowsSuccess, sqlSuccess, windowsError, sqlError } = data;

            // Helper para formatar data/hora
            const fmtDateTime = (dt) => {
                if (!dt) return 'N/A';
                const d = new Date(dt);
                return d.toLocaleString('pt-BR', { 
                    day: '2-digit', 
                    month: '2-digit', 
                    year: 'numeric',
                    hour: '2-digit', 
                    minute: '2-digit',
                    second: '2-digit'
                });
            };

            // Helper para obter nível de severidade
            const getSeverityBadge = (level) => {
                const levelUpper = (level || '').toUpperCase();
                if (levelUpper.includes('ERROR') || levelUpper.includes('CRITICAL') || levelUpper === '16' || levelUpper === '17' || levelUpper === '18' || levelUpper === '19' || levelUpper === '20' || levelUpper === '21' || levelUpper === '22') {
                    return '<span class="badge badge-error">ERRO</span>';
                } else if (levelUpper.includes('WARNING') || levelUpper === '14' || levelUpper === '15') {
                    return '<span class="badge badge-warning">AVISO</span>';
                } else if (levelUpper.includes('INFO') || levelUpper.includes('INFORMATION')) {
                    return '<span class="badge">INFO</span>';
                }
                return '<span class="badge">INFO</span>';
            };

            // Filtrar logs baseado não tipo selecionado
            let windowsToShow = [...windowsEvents];
            let sqlToShow = [...sqlErrors];

            if (currentLogType === 'windows') {
