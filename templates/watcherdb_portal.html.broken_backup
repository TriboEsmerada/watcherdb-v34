                    ${issuesTable}
                  </div>
                  </div>
                  </div>
                `;

                // Eventos dos controles
                const daysSel = document.getElementById('backupDaysSelect');
                const sortSel = document.getElementById('backupSortSelect');
                const includeSystemChk = document.getElementById('backupIncludeSystemChk');
                daysSel.value = String(lookbackDays);
                includeSystemChk.checked = (localStorage.getItem('backup_include_system')||'false') === 'true';
                daysSel.onchange = () => {
                  localStorage.setItem('backup_days', daysSel.value);
                  loadBackupAnalysis();
                };
                includeSystemChk.onchange = () => {
                  localStorage.setItem('backup_include_system', includeSystemChk.checked ? 'true' : 'false');
                  loadBackupAnalysis();
                };
                const applyRender = () => {
                  localStorage.setItem('backup_sort', sortSel.value);
                  localStorage.setItem('backup_filter', filterSel.value);
                  // filtrar e ordenar
                  let dataToRender = [...issues];
                  if (filterSel.value==='full') {
                    dataToRender = dataToRender.filter(it => (it.issues||[]).some(s=>s.toLowerCase().includes('full')));
                  } else if (filterSel.value==='log') {
                    dataToRender = dataToRender.filter(it => (it.issues||[]).some(s=>s.toLowerCase().includes('log')));
                  } else if (filterSel.value==='full_models') {
                    dataToRender = dataToRender.filter(it => ['FULL','BULK_LOGGED'].includes((it.recovery_model||'').toUpperCase()));
                  }
                  const sorted = dataToRender.sort((a,b)=>{
                    const sevA = (a.issues||[]).length; const sevB = (b.issues||[]).length;
                    const ageFullA = a.last_full ? (Date.now()-Date.parse(a.last_full))/3600000 : 999999;
                    const ageFullB = b.last_full ? (Date.now()-Date.parse(b.last_full))/3600000 : 999999;
                    const ageLogA = a.last_log ? (Date.now()-Date.parse(a.last_log))/3600000 : 999999;
                    const ageLogB = b.last_log ? (Date.now()-Date.parse(b.last_log))/3600000 : 999999;
                    const key = sortSel.value;
                    if (key==='name') return a.database_name.localeCompare(b.database_name);
                    if (key==='age_full') return ageFullB - ageFullA;
                    if (key==='age_log') return ageLogB - ageLogA;
                    return sevB - sevA;
                  });
                  // re-render rápido substituindo tbody
                  const tbody = document.querySelector('#backupIssuesTbody');
                  if (!tbody) return;
                  tbody.innerHTML = sorted.map(it => `
                    <tr>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${it.database_name}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${it.recovery_model || 'N/A'}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${fmt(it.last_full)}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${fmt(it.last_diff)}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${fmt(it.last_log)}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${it._pattern || '...'}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${(it.issues && it.issues.length) ? (it.issues.map(renderIssueBadge).join(' ')) : '<span class=\\"badge\\">OK</span>'}${it._gapBadge || ''}</td>
                      <td style=\"padding:10px; border-bottom:1px solid #1f2937;\">${(it.tdp_error_count||0) > 0 ? renderIssueBadge('TDP ' + it.tdp_error_count) : '<span class=\\"badge\\">OK</span>'}${(it.tdp_samples && it.tdp_samples.length) ? `<div style=\\"color:#9ca3af; font-size:12px; margin-top:6px;\\">${it.tdp_samples.map(s => s.replace(/</g,'&lt;')).join('<br>')}</div>` : ''}</td>
                    </tr>`).join('');
                };
                const filterSel = document.getElementById('backupFilterSelect');
                filterSel.value = localStorage.getItem('backup_filter') || 'all';
                sortSel.onchange = applyRender;
                filterSel.onchange = applyRender;
                document.getElementById('backupExportBtn').onclick = () => {
                  const includeSystem = (localStorage.getItem('backup_include_system')||'false') === 'true';
                  window.open(`/api/monitoring/backup/server/${serverId}/summary.csv?days=${lookbackDays}${includeSystem ? '&include_system=true' : ''}`, '_blank');
                };
            } catch (err) {
                debugLog(` Backup Analysis error: ${err.message}`, 'error');
                const isAbort = err.name === 'AbortError' || err.message.includes('aborted') || err.message.includes('Aborted');
                const isTimeout = err.message.includes('timeout') || err.message.includes('Timeout');

                let errorTitle = 'Erro ao Carregar Dados';
                let errorMessage = err.message;
                let errorIcon = 'fa-exclamation-triangle';
                let errorColor = '#ef4444';

                if (isAbort || isTimeout) {
                    errorTitle = 'Requisio Cancelada ou Timeout';
                    errorMessage = 'A consulta de backups demorou muito ou foi cancelada. Isso pode acontecer em servidores com muitos databases. Clique em "Tentar Novamente" para recarregar.';
                    errorIcon = 'fa-clock';
                    errorColor = '#f59e0b';
                }

                content.innerHTML = `
                    <div class="card" style="border-left: 4px solid ${errorColor}; margin: 20px;">
                        <h4 style="color: ${errorColor}; margin: 0 0 12px 0;">
                            <i class="fas ${errorIcon}"></i> ${errorTitle}
                        </h4>
                        <p style="color: #94a3b8; margin: 0 0 16px 0;">${errorMessage}</p>
                        <button onclick="loadBackupAnalysis()" style="background: #3b82f6; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-size: 14px;">
                            <i class="fas fa-sync-alt"></i> Tentar Novamente
                        </button>
                    </div>
                `;
            }
        }

        // ========================================
        // BACKUP GAPS MODAL
        // ========================================
        async function showBackupGapsModal(type, serverId) {
            const modal = document.getElementById('backupGapsModal') || createBackupGapsModal();
            const modalBody = document.getElementById('backupGapsModalBody');
            const modalTitle = document.getElementById('backupGapsModalTitle');
            
            const titles = {
                'full': 'Gaps em Backup FULL',
                'diff': 'Gaps em Backup DIFF',
                'log': 'Gaps em Backup LOG',
                'summary': 'Resumo Consolidado de Gaps'
            };
            
            // Período de análise padrão (30 dias para gaps, pode ser ajustado não futuro)
            const analysisPeriod = 30;
            
            // Adicionar período ao título para todos os tipos de gaps
            modalTitle.textContent = `${titles[type] || 'Análise de Gaps'} (úúltimos ${analysisPeriod} dias)`;
            modalBody.innerHTML = createPremiumLoading('Carregando dados...');
            modal.style.display = 'flex';
            
            try {
                let url, dataKey;
                switch(type) {
                    case 'full':
                        url = `/api/queries/backup-gaps-full/${serverId}`;
                        dataKey = 'full_gaps';
                        break;
                    case 'diff':
                        url = `/api/queries/backup-gaps-diff/${serverId}`;
                        dataKey = 'diff_gaps';
                        break;
                    case 'log':
                        url = `/api/queries/backup-gaps-log/${serverId}`;
                        dataKey = 'log_gaps';
                        break;
                    case 'summary':
                        url = `/api/queries/backup-gaps-summary/${serverId}`;
                        dataKey = 'gaps_summary';
                        break;
                    default:
                        throw new Error('Tipo inválido');
                }
                
                const res = await createFetchWithAbort(url);
                const data = await res.json();
                const gaps = data[dataKey] || [];
                
                if (gaps.length === 0) {
                    modalBody.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #94a3b8;">
                            <i class="fas fa-check-circle" style="font-size: 48px; color: #10b981; margin-bottom: 16px;"></i>
                            <p>Nenhum gap significativo encontrado nos úúúltimos 30 dias.</p>
                        </div>
                    `;
                    return;
                }
                
                // Renderizar tabela baseada não tipo
                let tableHtml = '';
                if (type === 'summary') {
                    // Buscar estatísticas de gaps
                    try {
                        const statsRes = await createFetchWithAbort(`/api/queries/backup-gaps-statistics/${serverId}`);
                        const statsData = await statsRes.json();
                        const stats = statsData.gaps_statistics[0] || null;
                        
                        if (stats) {
                            const gapsDetalhados = stats.GapsDetalhados ? JSON.parse(stats.GapsDetalhados) : [];
                            tableHtml = renderGapsStatistics(stats, gapsDetalhados) + renderSummaryTable(gaps);
                        } else {
                            tableHtml = renderSummaryTable(gaps);
                        }
                    } catch (err) {
                        console.error('Erro ao buscar estatísticas:', err);
                        tableHtml = renderSummaryTable(gaps);
                    }
                } else if (type === 'log') {
                    // Adicionar filtros para gaps LOG
                    const filterHtml = `
                        <div style="display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <label style="color: #cbd5e1; font-size: 13px; white-space: nowrap;">Filtrar por Severidade:</label>
                                <select id="severityFilter" style="padding: 6px 12px; background: #1e293b; border: 1px solid #334155; border-radius: 4px; color: #e5e7eb; font-size: 13px; cursor: pointer;">
                                    <option value="all">Todas</option>
                                    <option value="CRITICAL">CRITICAL</option>
                                    <option value="HIGH">HIGH</option>
                                    <option value="MEDIUM">MEDIUM</option>
                                    <option value="LOW">LOW</option>
                                    <option value="INFO">INFO</option>
                                </select>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <label style="color: #cbd5e1; font-size: 13px; white-space: nowrap;">Filtrar por último LOG:</label>
                                <select id="lastBackupFilter" style="padding: 6px 12px; background: #1e293b; border: 1px solid #334155; border-radius: 4px; color: #e5e7eb; font-size: 13px; cursor: pointer;">
                                    <option value="all">Todos</option>
                                    <option value="today">Hoje</option>
                                    <option value="yesterday">Ontem</option>
                                    <option value="last7days">úúltimos 7 dias</option>
                                    <option value="last30days">úúltimos 30 dias</option>
                                </select>
                            </div>
                            <div style="margin-left: auto; color: #94a3b8; font-size: 12px;">
                                <span id="filteredCount">${gaps.length}</span> de <span id="totalCount">${gaps.length}</span> registros
                            </div>
                        </div>
                    `;
                    tableHtml = filterHtml + renderLogGapsTable(gaps, true);
                } else if (type === 'full' || type === 'diff') {
                    // Adicionar filtros para gaps FULL e DIFF
                    const backupTypeLabel = type === 'full' ? 'FULL' : 'DIFF';
                    const filterHtml = `
                        <div style="display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <label style="color: #cbd5e1; font-size: 13px; white-space: nowrap;">Filtrar por Severidade:</label>
                                <select id="severityFilter" style="padding: 6px 12px; background: #1e293b; border: 1px solid #334155; border-radius: 4px; color: #e5e7eb; font-size: 13px; cursor: pointer;">
                                    <option value="all">Todas</option>
                                    <option value="CRITICAL">CRITICAL</option>
                                    <option value="HIGH">HIGH</option>
                                    <option value="MEDIUM">MEDIUM</option>
                                    <option value="LOW">LOW</option>
                                </select>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <label style="color: #cbd5e1; font-size: 13px; white-space: nowrap;">Filtrar por último ${backupTypeLabel}:</label>
                                <select id="lastBackupFilter" style="padding: 6px 12px; background: #1e293b; border: 1px solid #334155; border-radius: 4px; color: #e5e7eb; font-size: 13px; cursor: pointer;">
                                    <option value="all">Todos</option>
                                    <option value="today">Hoje</option>
                                    <option value="yesterday">Ontem</option>
                                    <option value="last7days">úúltimos 7 dias</option>
                                    <option value="last30days">úúltimos 30 dias</option>
                                </select>
                            </div>
                            <div style="margin-left: auto; color: #94a3b8; font-size: 12px;">
                                <span id="filteredCount">${gaps.length}</span> de <span id="totalCount">${gaps.length}</span> registros
                            </div>
                        </div>
                    `;
                    tableHtml = filterHtml + renderGapsTable(gaps, type, true);
                } else {
                    tableHtml = renderGapsTable(gaps, type);
                }
                
                modalBody.innerHTML = `
                    <div class="table-container" style="max-height: 600px;">
                        ${tableHtml}
                    </div>
                `;
                
                // Adicionar event listeners para filtros (para gaps LOG, FULL e DIFF)
                if (type === 'log' || type === 'full' || type === 'diff') {
                    const severityFilter = document.getElementById('severityFilter');
                    const lastBackupFilter = document.getElementById('lastBackupFilter');
                    const filteredCount = document.getElementById('filteredCount');
                    const totalCount = document.getElementById('totalCount');
                    
                    function applyFilters() {
                        const severityValue = severityFilter.value;
                        const lastBackupValue = lastBackupFilter.value;
                        const today = new Date();
                        today.setHours(0, 0, 0, 0);
                        
                        let filtered = gaps.filter(g => {
                            // Filtro de severidade
                            if (severityValue !== 'all' && g.Severity !== severityValue) {
                                return false;
                            }
                            
                            // Filtro de úúltimo backup (adaptado para cada tipo)
                            if (lastBackupValue !== 'all') {
                                let lastBackupDate;
                                if (type === 'log') {
                                    lastBackupDate = new Date(g.LastLogBackup);
                                } else if (type === 'full') {
                                    lastBackupDate = new Date(g.LastFullBackup);
                                } else if (type === 'diff') {
                                    lastBackupDate = new Date(g.LastDiffBackup);
                                }
                                
                                if (!lastBackupDate || isNaN(lastBackupDate.getTime())) {
                                    return false;
                                }
                                
                                lastBackupDate.setHours(0, 0, 0, 0);
                                
                                if (lastBackupValue === 'today') {
                                    if (lastBackupDate.getTime() !== today.getTime()) return false;
                                } else if (lastBackupValue === 'yesterday') {
                                    const yesterday = new Date(today);
                                    yesterday.setDate(yesterday.getDate() - 1);
                                    if (lastBackupDate.getTime() !== yesterday.getTime()) return false;
                                } else if (lastBackupValue === 'last7days') {
                                    const sevenDaysAgo = new Date(today);
                                    sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
                                    if (lastBackupDate < sevenDaysAgo) return false;
                                } else if (lastBackupValue === 'last30days') {
                                    const thirtyDaysAgo = new Date(today);
                                    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
                                    if (lastBackupDate < thirtyDaysAgo) return false;
                                }
                            }
                            
                            return true;
                        });
                        
                        // Atualizar contador
                        filteredCount.textContent = filtered.length;
                        totalCount.textContent = gaps.length;
                        
                        // Re-renderizar tabela com dados filtrados
                        const tableContainer = modalBody.querySelector('.table-container');
                        const filterHtml = tableContainer.innerHTML.split('<table')[0];
                        if (type === 'log') {
                            tableContainer.innerHTML = filterHtml + renderLogGapsTable(filtered, false);
                        } else {
                            tableContainer.innerHTML = filterHtml + renderGapsTable(filtered, type, false);
                        }
                    }
                    
                    severityFilter.addEventListener('change', applyFilters);
                    lastBackupFilter.addEventListener('change', applyFilters);
                    
                    // Configurar ordenao inicial para todas as tabelas
                    setupTableSorting();
                }
            } catch (err) {
                modalBody.innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #ef4444;">
                        <i class="fas fa-exclamation-triangle" style="font-size: 48px; margin-bottom: 16px;"></i>
                        <p>Erro ao carregar dados: ${err.message}</p>
                    </div>
                `;
            }
        }
        
        function renderGapsTable(gaps, type, includeFilters = false) {
            if (gaps.length === 0) {
                return `
                    <div style="text-align: center; padding: 40px; color: #94a3b8;">
                        <i class="fas fa-filter" style="font-size: 32px; margin-bottom: 12px; opacity: 0.5;"></i>
                        <p>Nenhum registro encontrado com os filtros aplicados.</p>
                    </div>
                `;
            }
            
            const tableId = type === 'full' ? 'fullGapsTable' : 'diffGapsTable';
            const lastBackupCol = type === 'full' ? 'LastFullBackup' : 'LastDiffBackup';
            const nextBackupCol = type === 'full' ? 'NextFullBackup' : 'NextDiffBackup';
            
            return `
                <table id="${tableId}" style="width: 100%; border-collapse: collapse; color: #e5e7eb; font-size: 13px;">
                    <thead>
                        <tr style="background: #0f172a; text-align: left; position: sticky; top: 0; z-index: 10;">
                            <th style="padding: 10px; border-bottom: 1px solid #334155;">Database</th>
                            <th style="padding: 10px; border-bottom: 1px solid #334155; cursor: pointer; user-select: none;" onclick="sortTable('${tableId}', 1, 'date')">
                                último Backup <i class="fas fa-sort" style="margin-left: 4px; font-size: 10px; opacity: 0.6;"></i>
                            </th>
                            <th style="padding: 10px; border-bottom: 1px solid #334155;">Próximo Backup</th>
                            <th style="padding: 10px; border-bottom: 1px solid #334155;">Gap (dias)</th>
                            <th style="padding: 10px; border-bottom: 1px solid #334155;">Status</th>
                            <th style="padding: 10px; border-bottom: 1px solid #334155; cursor: pointer; user-select: none;" onclick="sortTable('${tableId}', 5, 'severity')">
                                Severidade <i class="fas fa-sort" style="margin-left: 4px; font-size: 10px; opacity: 0.6;"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        ${gaps.map(g => {
                            const severityColor = g.Severity === 'CRITICAL' ? '#ef4444' : 
                                                  g.Severity === 'HIGH' ? '#f97316' : 
                                                  g.Severity === 'MEDIUM' ? '#eab308' : '#10b981';
                            const lastBackup = g[lastBackupCol];
                            const nextBackup = g[nextBackupCol];
                            // Armazenar valores originais para ordenao
                            const lastBackupDate = lastBackup ? new Date(lastBackup).getTime() : 0;
                            const severityOrder = g.Severity === 'CRITICAL' ? 5 : g.Severity === 'HIGH' ? 4 : g.Severity === 'MEDIUM' ? 3 : g.Severity === 'LOW' ? 2 : 0;
                            return `
                                <tr>
                                    <td style="padding: 10px; border-bottom: 1px solid #1f2937;">${g.DatabaseName}</td>
                                    <td style="padding: 10px; border-bottom: 1px solid #1f2937;" data-sort-value="${lastBackupDate}">${formatDate(lastBackup)}</td>
                                    <td style="padding: 10px; border-bottom: 1px solid #1f2937;">${formatDate(nextBackup) || 'N/A'}</td>
                                    <td style="padding: 10px; border-bottom: 1px solid #1f2937;">${g.GapDays || 'N/A'}</td>
                                    <td style="padding: 10px; border-bottom: 1px solid #1f2937;">${g.Status || 'N/A'}</td>
                                    <td style="padding: 10px; border-bottom: 1px solid #1f2937;" data-sort-value="${severityOrder}">
                                        <span style="color: ${severityColor}; font-weight: bold;">${g.Severity}</span>
                                    </td>
                                </tr>
                            `;
                        }).join('')}
                    </tbody>
                </table>
            `;
        }
        
