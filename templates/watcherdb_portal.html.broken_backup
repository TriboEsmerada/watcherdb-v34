        // ========================================
        // LOAD SERVERS
        // ========================================
        async function loadServers() {
            try {
                debugLog('[INFO] Buscando servidores...', 'info');
                const response = await fetch('/api/v3/servers');
                const data = await response.json();

        // Verificar se é erro de "sem dados históricos"
