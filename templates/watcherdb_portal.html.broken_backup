                    debugLog(`   - TDE DB Status: /api/queries/tde-database-status/${serverIdFormatted}`, 'info');
                    debugLog(`   - Always On: /api/alwayson/server/${serverIdFormatted}/overview`, 'info');

                    const startTime = Date.now();

