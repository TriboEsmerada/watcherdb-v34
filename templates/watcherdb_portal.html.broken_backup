                    { id: 'backup', name: 'Status de Backups', endpoint: `/api/queries/backup/${serverId}`, category: 'standard' },
                    { id: 'database-connections', name: 'Conexes por Database', endpoint: `/api/queries/database-connections/${serverId}`, category: 'standard' },
                    { id: 'filegroup-growth-history', name: 'Histórico Crescimento Filegroups', endpoint: `/api/queries/filegroup-growth-history/${serverId}`, requiresDb: true, category: 'analysis' },
                    { id: 'filegroup-growth-forecast', name: 'Projeo Crescimento Filegroups', endpoint: `/api/queries/filegroup-growth-forecast/${serverId}`, requiresDb: true, category: 'analysis' },
