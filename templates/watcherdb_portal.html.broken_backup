        // ========================================
        // ATUALIZAO INDIVIDUAL DE CARDS DO OVERVIEW
        // ========================================
        async function refreshOverviewCard(cardType, serverId) {
            const serverIdFormatted = serverId.replace(/\\/g, '_');
            const iconId = `refresh-${cardType}-icon`;
            const icon = document.getElementById(iconId);
            
            if (!icon) {
                debugLog(`[INFO] cone de refresh não encontrado: ${iconId}`, 'warning');
                return;
            }
            
            // Funes auxiliares para processar respostas
            const fetchWithTimeout = async (url, timeout = 120000) => {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), timeout);
