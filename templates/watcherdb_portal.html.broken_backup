                if (indicator) indicator.remove();

                // Restaurar ordem original re-renderizando
                renderResultsTab();
            }
        }

        // Ordenar tabela por coluna
        function sortTableColumn(columnIndex) {
            const tbody = document.getElementById('sqlResultsTableBody');
            if (!tbody) return;

            const rows = Array.from(tbody.getElementsByTagName('tr'));
            if (rows.length === 0) return;

            // Determinar direo da ordenao
            let direction = 'asc';
            if (tableSortState.column === columnIndex) {
                if (tableSortState.direction === 'asc') {
                    direction = 'desc';
                } else if (tableSortState.direction === 'desc') {
                    direction = 'none';
                } else {
                    direction = 'asc';
                }
            }

            // Atualizar estado
            tableSortState.column = columnIndex;
            tableSortState.direction = direction;

            // Atualizar cones de todas as colunas
            const { columns } = window.sqlResultsData;
            const tableColumns = columns.length > 0 ? columns : (rows.length > 0 ? Array.from(rows[0].getElementsByTagName('td')).map((_, i) => i) : []);

            tableColumns.forEach((_, idx) => {
                const icon = document.getElementById(`sort-icon-${idx}`);
                if (icon) {
                    if (idx === columnIndex) {
                        if (direction === 'asc') {
                            icon.innerHTML = '<i class="fas fa-sort-up"></i>';
                            icon.style.opacity = '1';
                        } else if (direction === 'desc') {
                            icon.innerHTML = '<i class="fas fa-sort-down"></i>';
                            icon.style.opacity = '1';
                        } else {
                            icon.innerHTML = '<i class="fas fa-sort"></i>';
                            icon.style.opacity = '0.5';
                        }
                    } else {
                        icon.innerHTML = '<i class="fas fa-sort"></i>';
                        icon.style.opacity = '0.5';
                    }
                }
            });

            // Se direction === 'none', restaurar ordem original
            if (direction === 'none') {
                renderResultsTab();
                return;
            }

            // Ordenar linhas
            rows.sort((a, b) => {
                const cellA = a.getElementsByTagName('td')[columnIndex];
                const cellB = b.getElementsByTagName('td')[columnIndex];

                if (!cellA || !cellB) return 0;

                let textA = cellA.textContent || cellA.innerText || '';
                let textB = cellB.textContent || cellB.innerText || '';

                // Tentar converter para número se possível
                const numA = parseFloat(textA.replace(/[^0-9.-]/g, ''));
                const numB = parseFloat(textB.replace(/[^0-9.-]/g, ''));

                let comparison = 0;
                if (!isNaN(numA) && !isNaN(numB)) {
                    comparison = numA - numB;
                } else {
                    comparison = textA.localeCompare(textB, 'pt-BR', { numeric: true, sensitivity: 'base' });
                }

                return direction === 'asc' ? comparison : -comparison;
            });

            // Limpar tbody e reinserer linhas ordenadas
            tbody.innerHTML = '';
            rows.forEach(row => tbody.appendChild(row));
        }

        // Renderizar aba de SQL
        async function renderSQLTab() {
            const container = document.getElementById('sqlResultsCode');
