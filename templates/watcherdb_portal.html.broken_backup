                        <button onclick="document.getElementById('tempdbQueryModal').style.display='none'"
                                style="background: rgba(71, 85, 105, 0.5); color: #e2e8f0; border: 1px solid rgba(71, 85, 105, 0.5); padding: 10px 20px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500;">
