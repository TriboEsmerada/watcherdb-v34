        // Filtrar sessões com idle alto (>=30 min) e ordenar desc
        function filterHighIdleSessions() {
            const tbody = document.getElementById('sqlResultsTableBody');
            const card = document.getElementById('highIdleCard');
            if (!tbody) return;

            const rows = Array.from(tbody.getElementsByTagName('tr'));
            if (rows.length === 0) return;

            // Toggle do filtro
            highIdleFilterActive = !highIdleFilterActive;

            // Encontrar ndice da coluna idle_time_minutes (coluna 10 - 0-indexed)
            const idleColumnIndex = 10; // idle_time_minutes é a 11 coluna

            if (highIdleFilterActive) {
                // Ativar filtro - esconder linhas sem idle alto e ordenar
                let visibleCount = 0;

                rows.forEach(row => {
                    const idleCell = row.getElementsByTagName('td')[idleColumnIndex];
                    if (idleCell) {
                        const idleText = idleCell.textContent || '';
                        const idleValue = parseInt(idleText.replace(/[^0-9.-]/g, ''));

                        if (!isNaN(idleValue) && idleValue >= 30) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });

                // Ordenar as linhas visveis por idle desc
                const visibleRows = rows.filter(r => r.style.display !== 'none');
                visibleRows.sort((a, b) => {
                    const cellA = a.getElementsByTagName('td')[idleColumnIndex];
                    const cellB = b.getElementsByTagName('td')[idleColumnIndex];
                    const numA = parseInt((cellA.textContent || '0').replace(/[^0-9.-]/g, '')) || 0;
                    const numB = parseInt((cellB.textContent || '0').replace(/[^0-9.-]/g, '')) || 0;
                    return numB - numA; // DESC
                });

                // Reordenar não DOM
                visibleRows.forEach(row => tbody.appendChild(row));

                // Atualizar visual do card
                if (card) {
                    card.style.background = 'linear-gradient(135deg, rgba(239, 68, 68, 0.4) 0%, rgba(220, 38, 38, 0.5) 100%)';
                    card.style.borderColor = '#ef4444';
                    card.title = 'Clique para mostrar todas as sessões';
                }

                // Mostrar indicador de filtro ativo
                const titleDiv = document.querySelector('.tempdb-villain-title');
                if (titleDiv && !document.getElementById('filterIndicator')) {
                    const indicator = document.createElement('span');
                    indicator.id = 'filterIndicator';
                    indicator.innerHTML = `<i class="fas fa-filter" style="color: #ef4444; margin-left: 8px;"></i> <span style="font-size: 12px; color: #fca5a5;">Filtrado: ${visibleCount} com idle =30min</span>`;
                    titleDiv.appendChild(indicator);
                }
            } else {
                // Desativar filtro - mostrar todas as linhas
                rows.forEach(row => {
                    row.style.display = '';
                });

                // Restaurar visual do card
                if (card) {
                    card.style.background = 'linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.3) 100%)';
                    card.style.borderColor = 'rgba(239, 68, 68, 0.5)';
                    card.title = 'Clique para filtrar sessões com idle =30 min';
                }

                // Remover indicador de filtro
