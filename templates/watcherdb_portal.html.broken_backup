        function showSelectableModal(title, content, buttonText = 'OK', onConfirm = null) {
            // Criar ou obter modal
            let modal = document.getElementById('selectableModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'selectableModal';
                modal.className = 'selectable-modal';
                modal.innerHTML = `
                    <div class="selectable-modal-content">
                        <div class="selectable-modal-header">
                            <h3 id="selectableModalTitle"></h3>
                            <button class="selectable-modal-close" onclick="closeSelectableModal()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="selectable-modal-body" id="selectableModalBody"></div>
                        <div class="selectable-modal-footer" id="selectableModalFooter"></div>
                    </div>
                `;
                document.body.appendChild(modal);
                
                // Fechar ao clicar fora
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        closeSelectableModal();
                    }
                });
            }
            
            // Preencher conteúdo
            document.getElementById('selectableModalTitle').textContent = title;
            document.getElementById('selectableModalBody').innerHTML = content;
            
            // Botes
            const footer = document.getElementById('selectableModalFooter');
            footer.innerHTML = '';
            
            if (onConfirm) {
                const confirmBtn = document.createElement('button');
                confirmBtn.className = 'selectable-modal-btn selectable-modal-btn-primary';
                confirmBtn.textContent = buttonText;
                confirmBtn.onclick = () => {
                    closeSelectableModal();
                    if (onConfirm) onConfirm();
                };
                footer.appendChild(confirmBtn);
            }
            
            const cancelBtn = document.createElement('button');
            cancelBtn.className = 'selectable-modal-btn selectable-modal-btn-secondary';
            cancelBtn.textContent = onConfirm ? 'Cancelar' : 'Fechar';
            cancelBtn.onclick = closeSelectableModal;
            footer.appendChild(cancelBtn);
            
            // Mostrar modal
            modal.classList.add('show');
        }
        
        function closeSelectableModal() {
            const modal = document.getElementById('selectableModal');
            if (modal) {
                modal.classList.remove('show');
            }
        }

        // ============================================================================
