                                    meta: meta,
                                    envBreakdownFromMeta: meta.envBreakdown,
                                    hasGetEnvBreakdown: window.KPI_METADATA && window.KPI_METADATA[kpiId] && typeof window.KPI_METADATA[kpiId].getEnvBreakdown === 'function',
                                    hasDashboardData: !!window.dashboardData
                                });
                            }
                            
                            // Se não háouver envBreakdown não meta, tentar buscar do KPI_METADATA
                            if (!envBreakdown || (typeof envBreakdown === 'object' && (!envBreakdown || Object.keys(envBreakdown).length === 0))) {
                                // Tentar buscar do KPI_METADATA global
                                const kpiMetadata = window.KPI_METADATA || {};
                                const kpiDef = kpiMetadata[kpiId];
                                if (kpiDef && typeof kpiDef.getEnvBreakdown === 'function' && window.dashboardData) {
                                    try {
                                        envBreakdown = kpiDef.getEnvBreakdown(window.dashboardData);
                                        if (kpiId === 'backup-failed' || kpiId === 'backup-delayed') {
                                            console.log(`[Tooltip Debug] ${kpiId} - Calculado do getEnvBreakdown:`, envBreakdown);
                                        }
                                    } catch (e) {
                                        console.warn(`Erro ao calcular envBreakdown para ${kpiId}:`, e);
                                    }
                                }
                            }
                            
                            // Renderizar tooltip APENAS com breakdown por ambiente
                            const prd = (envBreakdown && typeof envBreakdown.PRD === 'number') ? envBreakdown.PRD : 0;
                            const qlt = (envBreakdown && typeof envBreakdown.QLT === 'number') ? envBreakdown.QLT : 0;
                            const tst = (envBreakdown && typeof envBreakdown.TST === 'number') ? envBreakdown.TST : 0;
                            
                            // Montar HTML do tooltip - SOMENTE título e breakdown por ambiente
                            let tooltipContent = `<div class="kpi-tooltip-title">${meta.name || 'KPI'}</div>`;
                            
                            // Adicionar breakdown por ambiente apenas se houver valores > 0
                            if (prd > 0 || qlt > 0 || tst > 0) {
                                tooltipContent += `<div style="margin-top: 8px;">`;
                                if (prd > 0) {
                                    tooltipContent += `<div class="kpi-tooltip-item"><strong style="color: #ef4444;">PRD:</strong> ${prd}</div>`;
                                }
                                if (qlt > 0) {
                                    tooltipContent += `<div class="kpi-tooltip-item"><strong style="color: #f59e0b;">QLT:</strong> ${qlt}</div>`;
                                }
                                if (tst > 0) {
                                    tooltipContent += `<div class="kpi-tooltip-item"><strong style="color: #3b82f6;">TST:</strong> ${tst}</div>`;
                                }
                                tooltipContent += `</div>`;
                            }
                            
                            // Limpar qualquer conteúdo anterior e definir apenas o novo conteúdo
                            tooltip.innerHTML = '';
                            tooltip.innerHTML = tooltipContent;
                            
                            const rect = card.getBoundingClientRect();
                            tooltip.style.left = `${rect.left + rect.width / 2 - 150}px`;
                            tooltip.style.top = `${rect.bottom + 10}px`;
                            
                            // Ajustar se sair da tela
                            setTimeout(() => {
                                const tooltipRect = tooltip.getBoundingClientRect();
                                if (tooltipRect.right > window.innerWidth) {
                                    tooltip.style.left = `${window.innerWidth - tooltipRect.width - 10}px`;
                                }
                                if (tooltipRect.bottom > window.innerHeight) {
                                    tooltip.style.top = `${rect.top - tooltipRect.height - 10}px`;
                                }
                            }, 0);
                            
                            tooltip.classList.add('visible');
                        } catch (e) {
                            console.warn('Erro ao mostrar tooltip:', e);
                        }
                    }, 500);
                };
                
                const hideTooltip = () => {
                    if (tooltipTimeout) {
                        clearTimeout(tooltipTimeout);
                        tooltipTimeout = null;
                    }
                    if (tooltip) {
                        tooltip.classList.remove('visible');
                        // Forar ocultao imediata movendo para fora da tela
                        tooltip.style.left = '-9999px';
                        tooltip.style.top = '-9999px';
                    }
                };

                // NO adicionar listener ao tooltip (tem pointer-events: none não CSS)
                // O hideTooltip ser chamado apenas pelo mouseleave do card

                card.addEventListener('mouseenter', showTooltip);
                card.addEventListener('mouseleave', hideTooltip);

                // Fallback: esconder tooltip ao clicar em qualquer lugar
                document.addEventListener('click', () => {
                    if (tooltip && tooltip.classList.contains('visible')) {
                        hideTooltip();
                    }
                }, { once: false });
            });
        }
        
        function generateKPICards(data) {
            const config = getDashboardConfig();
            // Garantir que todos os KPIs do KPI_METADATA estejam na lista de visíveis
            // Isso garante que novos KPIs sejam automaticamente incluídos
            const allKPIIds = Object.keys(KPI_METADATA);
            const visibleKPIs = config.visibleKPIs ?
                 [...new Set([...config.visibleKPIs, ...allKPIIds])] : // Merge: manter os existentes + adicionar novos
                 allKPIIds;
            
            // Filtrar KPIs visveis
            let kpis = visibleKPIs
                .map(id => KPI_METADATA[id])
                .filter(kpi => kpi !== undefined);
            
            // Ordenar
            if (config.sortOrder === 'custom' && config.customOrder && config.customOrder.length > 0) {
                // Ordenar pela ordem personalizada
                const customOrderMap = {};
                config.customOrder.forEach((id, index) => {
                    customOrderMap[id] = index;
                });
                kpis.sort((a, b) => {
                    const orderA = customOrderMap[a.id] !== undefined ? customOrderMap[a.id] : 9999;
                    const orderB = customOrderMap[b.id] !== undefined ? customOrderMap[b.id] : 9999;
