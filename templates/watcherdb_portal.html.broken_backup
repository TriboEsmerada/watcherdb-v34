                        debugLog(`[INFO] Tópico "${topic}": ${topicQueries.length} queries (esperadas: ${queryIds.length})`, 'info');
                        debugLog(`   IDs esperados: ${queryIds.join(', ')}`, 'info');
                        debugLog(`   IDs encontrados: ${topicQueries.map(q => q.id).join(', ')}`, 'info');
                        if (topicQueries.length > 0) {
                            html += `
                                <div style="grid-column: 1 / -1; margin-top: 8px;">
