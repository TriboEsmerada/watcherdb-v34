        // ========================================
        // FUNO PARA MOSTRAR ALERTAS POR SEVERIDADE (CARDS INTERATIVOS)
        // ========================================
        function showPredictiveAlertsBySeverity(severity) {
            const data = window.currentPredictiveData;
            if (!data) {
                debugLog('[INFO] Dados preditivos não disponveis', 'warning');
                return;
            }

            // Se não há alertas da severidade selecionada (exceto 'all'), não fazer nada
            if (severity !== 'all' && (!data.alerts_by_severity[severity] || data.alerts_by_severity[severity].length === 0)) {
                debugLog(`[INFO] Nenhum alerta de severidade ${severity}`, 'info');
                return;
            }

            // Configuraes por severidade
            const severityConfig = {
                critical: { title: 'Alertas Críticos', icon: '[INFO]', color: '#ef4444', bgColor: 'rgba(239, 68, 68, 0.15)' },
                high: { title: 'Alertas de Risco Alto', icon: '[INFO]', color: '#fb923c', bgColor: 'rgba(251, 146, 60, 0.15)' },
                medium: { title: 'Alertas de Risco Médio', icon: '[INFO]', color: '#facc15', bgColor: 'rgba(234, 179, 8, 0.15)' },
                all: { title: 'Todos os Filegroups Analisados', icon: '[INFO]', color: '#22c55e', bgColor: 'rgba(34, 197, 94, 0.15)' }
            };

            const config = severityConfig[severity];
            let alerts = [];

            if (severity === 'all') {
                // Combinar todos os alertas
                alerts = [
                    ...data.alerts_by_severity.critical.map(a => ({ ...a, severity: 'critical' })),
                    ...data.alerts_by_severity.high.map(a => ({ ...a, severity: 'high' })),
                    ...data.alerts_by_severity.medium.map(a => ({ ...a, severity: 'medium' }))
                ];
            } else {
                alerts = data.alerts_by_severity[severity].map(a => ({ ...a, severity }));
            }

            // Criar ou obter o modal
            let modal = document.getElementById('predictiveSeverityModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'predictiveSeverityModal';
                modal.className = 'modal';
                document.body.appendChild(modal);
            }

            // Renderizar conteúdo do modal
            let html = `
                <div class="modal-content" style="max-width: 900px; max-height: 85vh;">
                    <div class="modal-header" style="background: linear-gradient(135deg, ${config.bgColor} 0%, rgba(15, 23, 42, 0.95) 100%); border-bottom: 2px solid ${config.color};">
                        <div>
                            <h2 style="font-size: 20px; margin: 0; color: ${config.color};">
                                ${config.icon} ${config.title}
                            </h2>
                            <p style="font-size: 13px; margin-top: 4px; color: #94a3b8;">
                                ${alerts.length} alerta(s) encontrado(s)
