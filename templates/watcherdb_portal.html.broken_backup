            // Determinar direo da ordenao
            const currentDir = sortDirection[`${tableId}_${columnIndex}`] || 'asc';
            const newDir = currentDir === 'asc' ? 'desc' : 'asc';
            sortDirection[`${tableId}_${columnIndex}`] = newDir;
            
            // Ordenar linhas
            rows.sort((a, b) => {
                const aCell = a.cells[columnIndex];
                const bCell = b.cells[columnIndex];
                
                if (!aCell || !bCell) return 0;
                
                // Tentar usar data-sort-value se disponível (mais confivel)
                const aSortValue = aCell.getAttribute('data-sort-value');
                const bSortValue = bCell.getAttribute('data-sort-value');
                
                if (aSortValue !== null && bSortValue !== null) {
                    // Usar valores numéricos armazenados
                    const aNum = parseFloat(aSortValue);
                    const bNum = parseFloat(bSortValue);
                    if (!isNaN(aNum) && !isNaN(bNum)) {
                        return newDir === 'asc' ? aNum - bNum : bNum - aNum;
                    }
                }
                
                // Fallback: usar texto da célula
                let aValue = aCell.textContent.trim();
                let bValue = bCell.textContent.trim();
                
                if (sortType === 'date') {
                    // Tentar parsear data não formato brasileiro (dd/MM/yyyy, HH:mm:ss)
                    const parseBrazilianDate = (str) => {
                        // Formato: "11/11/2025, 18:00:23"
                        const match = str.match(/(\d{2})\/(\d{2})\/(\d{4}),\s*(\d{2}):(\d{2}):(\d{2})/);
                        if (match) {
                            const [, day, month, year, hour, minute, second] = match;
                            return new Date(year, month - 1, day, hour, minute, second).getTime();
                        }
                        // Tentar formato ISO ou padrão
                        const date = new Date(str);
                        return isNaN(date.getTime()) ? 0 : date.getTime();
                    };
                    
                    const aTime = parseBrazilianDate(aValue);
                    const bTime = parseBrazilianDate(bValue);
                    
                    if (aTime === 0 && bTime === 0) {
                        return aValue.localeCompare(bValue);
                    }
                    return newDir === 'asc' ? aTime - bTime : bTime - aTime;
                } else if (sortType === 'severity') {
                    // Ordenar por severidade (ordem: CRITICAL > HIGH > MEDIUM > LOW > INFO)
                    const severityOrder = { 'CRITICAL': 5, 'HIGH': 4, 'MEDIUM': 3, 'LOW': 2, 'INFO': 1 };
                    const aOrder = severityOrder[aValue] || 0;
                    const bOrder = severityOrder[bValue] || 0;
                    return newDir === 'asc' ? aOrder - bOrder : bOrder - aOrder;
                } else {
                    // Ordenao alfabética padrão
                    return newDir === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);
                }
            });
            
            // Remover linhas existentes
            rows.forEach(row => row.remove());
            
            // Adicionar linhas ordenadas
            rows.forEach(row => tbody.appendChild(row));
            
            // Atualizar cones de ordenao
