                if (title.includes('1 Dia')) {
                    projection = fg.projected_1day;
                } else if (title.includes('7 Dias')) {
                    projection = fg.projected_7days;
                } else if (title.includes('30 Dias')) {
                    projection = fg.projected_30days;
                } else if (title.includes('60 Dias')) {
                    projection = fg.projected_60days;
                } else {
                    projection = fg.projected_30days; // fallback
                }
                
                const utilizationPercent = (projection / fg.effective_limit) * 100;
                // Cor baseada na urgncia
                let urgencyColor = '#fb923c';
                if (title.includes('1 Dia')) urgencyColor = '#dc2626';
                else if (title.includes('7 Dias')) urgencyColor = '#ef4444';
                else if (title.includes('30 Dias')) urgencyColor = '#f97316';
                else if (title.includes('60 Dias')) urgencyColor = '#eab308';
                
                html += `
                    <tr style="background: rgba(234, 179, 8, 0.1);">
                        <td><strong>${fg.database_name}</strong></td>
                        <td style="font-family: monospace; font-size: 12px; font-weight: bold; color: #60a5fa;">
                            ${fg.filegroup_name}
