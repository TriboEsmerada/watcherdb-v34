                        }
                        .tempdb-metrics {
                            display: grid;
                            grid-template-columns: repeat(4, 1fr);
                            gap: 16px;
                        }
                        .tempdb-metric {
                            background: rgba(15, 23, 42, 0.6);
                            border-radius: 8px;
                            padding: 16px;
                            text-align: center;
                        }
                        .tempdb-metric-value {
                            font-size: 24px;
                            font-weight: 700;
                            color: #e2e8f0;
                        }
                        .tempdb-metric-label {
                            font-size: 12px;
