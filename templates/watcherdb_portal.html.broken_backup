        // ========================================
        // MEMORY PRESSURE REFRESH
        // ========================================
        async function refreshMemoryPressure(serverId) {
            // Usar IDs úúúnicos por servidor para evitar conflitos quando h múltiplas abas abertas
            const icon = document.getElementById(`memory-pressure-icon-${serverId}`);
            const valueEl = document.getElementById(`memory-pressure-value-${serverId}`);
            const statusEl = document.getElementById(`memory-pressure-status-${serverId}`);
            const card = document.getElementById(`memory-pressure-card-${serverId}`);

            if (!icon || !valueEl || !statusEl || !card) {
                debugLog(`[INFO] Elementos do Memory Pressure card não encontrados para ${serverId}`, 'warning');
                return;
            }

            // Adicionar animao de rotao
            icon.style.animation = 'spin 1s linear infinite';

            try {
                const apiUrl = `/api/monitoring/memory/server/${serverId}/pressure?t=${Date.now()}`;
                debugLog(`[INFO] Atualizando Memory Pressure (${serverId}): ${apiUrl}`, 'info');

                const response = await fetch(apiUrl);
                const json = await response.json();

                if (!json.success) {
                    throw new Error(json.error || 'Erro ao atualizar memory pressure');
                }

                const pressurePct = json.memory_pressure_pct;
                const pressureStatus = json.memory_pressure_status;

                // Atualizar valor
                valueEl.textContent = pressurePct !== null && pressurePct !== undefined ? pressurePct.toFixed(1) + '%' : 'N/A';

                // Atualizar status (traduzido para portugus)
                statusEl.textContent = translateMemoryPressureStatus(pressureStatus);

                // Atualizar cor do card
                card.className = 'stat-card ';
                if (pressureStatus === 'HEALTHY') {
                    card.className += 'green';
                } else if (pressureStatus === 'WARNING' || pressureStatus === 'MODERATE') {
                    card.className += 'yellow';
                } else if (pressureStatus === 'LOW_USAGE' || pressureStatus === 'LOW' || pressureStatus === 'AWAITING_INIT' || pressureStatus === 'NOT_CONFIGURED') {
                    card.className += 'blue';
                } else if (pressureStatus === 'HIGH' || pressureStatus === 'CRITICAL') {
                    card.className += 'red';
                } else {
                    card.className += 'blue'; // Default
                }

                // Atualizar alerta se existir
                updateMemoryPressureAlert(pressurePct, pressureStatus, serverId);

                debugLog(` Memory Pressure atualizado (${serverId}): ${pressurePct !== null ? pressurePct.toFixed(1) + '%' : 'N/A'} (${pressureStatus})`, 'success');

            } catch (error) {
                debugLog(` Erro ao atualizar Memory Pressure (${serverId}): ${error.message}`, 'error');
                // Mostrar feedback visual de erro
                valueEl.style.color = '#ef4444';
                setTimeout(() => {
                    valueEl.style.color = '';
                }, 2000);
            } finally {
                // Remover animao
                icon.style.animation = '';
            }
        }
        
        function updateMemoryPressureAlert(pressurePct, pressureStatus) {
            // Buscar o container de alertas
            const alertsContainer = document.getElementById('memory-alerts');
            if (!alertsContainer) return;
            
            // Remover alertas antigos de memory pressure
            const existingAlerts = alertsContainer.querySelectorAll('.alert');
            existingAlerts.forEach(alert => {
                const message = alert.textContent || '';
                if (message.includes('PRESSO DE MEMRIA') || 
                    message.includes('Memory pressure') || 
                    message.includes('no alocou memória')) {
                    alert.remove();
                }
            });
            
            // Adicionar novo alerta se necessrio
            let alertHtml = '';
            if (pressurePct === null) {
                alertHtml = `
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        [INFO] SQL Server ainda não alocou memória (Target = 0). Aguardando inicialização ou primeira carga de trabalho.
                    </div>
                `;
            } else if (pressurePct < 80) {
                alertHtml = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        [INFO] PRESSO DE MEMRIA BAIXA! SQL est usando apenas ${pressurePct.toFixed(1)}% da memória alocada. Pode indicar problema de alocao.
                    </div>
                `;
            } else if (pressurePct < 95) {
                alertHtml = `
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        [INFO] Memory pressure em ${pressurePct.toFixed(1)}%. SQL poderia usar mais memória.
                    </div>
                `;
            }
            
            if (alertHtml) {
                alertsContainer.insertAdjacentHTML('afterbegin', alertHtml);
            }
        }

