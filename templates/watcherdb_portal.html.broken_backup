        // ========================================
        // SPACE ANALYSIS TAB
        // ========================================
        async function loadSpaceAnalysis(contentElement = null) {
            // Se contentElement não foi fornecido, tentar obter da aba ativa ou contentArea
            const content = contentElement || (activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea'));
            if (!content) {
                debugLog('[INFO] contentElement não encontrado para loadSpaceAnalysis', 'warning');
                return;
            }
            const serverId = selectedServer.server_id;
            
            debugLog(`[INFO] Carregando Space Analysis...`, 'info');
            debugLog(`[INFO] Server ID: ${serverId}`, 'info');
            
            content.innerHTML = createPremiumLoading('Carregando análise de espao...');
            
            try {
                const apiUrl = `/api/monitoring/space/server/${serverId}?t=${Date.now()}`;
                debugLog(`[INFO] API: ${apiUrl}`, 'info');
                
                const response = await createFetchWithAbort(apiUrl);
                const json = await response.json();
                
                debugLog(`[INFO] Status: ${response.status}`, response.ok ? 'success' : 'error');
                
                const data = (json.success && json.data) ? json.data : json;
                
                if (!data || data.error) {
                    throw new Error(data.error || 'Dados inválidos');
                }
                
                const filegroups = data.filegroups || [];
                debugLog(` ${filegroups.length} filegroups`, 'success');
                
                const dbGroups = {};
                filegroups.forEach(fg => {
                    const dbName = fg.database_name;
                    if (!dbGroups[dbName]) {
                        dbGroups[dbName] = {
                            filegroups: [],
                            total_gb: 0,
                            has_overflow: false
                        };
                    }
                    dbGroups[dbName].filegroups.push(fg);
                    dbGroups[dbName].total_gb += (fg.total_gb || 0);
                    if (fg.disk_overflow_risk && fg.filegroup_type === 'ROWS') {
                        dbGroups[dbName].has_overflow = true;
                    }
                });
                
                debugLog(`[INFO] ${Object.keys(dbGroups).length} databases`, 'success');
                
                renderSpaceAnalysis(dbGroups, serverId, content);
                
            } catch (error) {
                debugLog(` Erro: ${error.message}`, 'error');
                content.innerHTML = `
                    <div class="card" style="background: #7f1d1d; border-color: #991b1b;">
                        <h4 style="color: #fca5a5;"><i class="fas fa-exclamation-triangle"></i> Erro</h4>
                        <p style="color: #fecaca;">${error.message}</p>
                    </div>
                `;
            }
        }
        
        function renderSpaceAnalysis(dbGroups, serverId, contentElement = null) {
            // Obter o elemento de conteúdo correto
            const content = contentElement || (activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea'));
            if (!content) {
                debugLog('[INFO] contentElement não encontrado para renderSpaceAnalysis', 'warning');
                return;
            }
            const totalDbs = Object.keys(dbGroups).length;

            //  CORRIGIDO v1.4.9: Calcular databases por nível de alerta (FileGroup Free %)
            let fgCriticalDbs = 0;   // FileGroup >= 98% usado
            let fgWarningDbs = 0;    // FileGroup >= 95% e < 98% usado
            let fgAttentionDbs = 0;  // FileGroup >= 90% e < 95% usado
            let alertDbs = 0;
            
            // Variveis antigas mantidas para compatibilidade
            let criticalDbs = 0;
            let warningDbs = 0;

            Object.values(dbGroups).forEach(db => {
                // FG Space Critical: FileGroup com menos de 2% livre
                const hasFgCritical = db.filegroups.some(fg => {
                    const pctUsed = fg.pct_used !== undefined ? fg.pct_used : (100 - (fg.free_percent || 0));
                    return pctUsed >= 98;
                });
                
                // FG Space Warning: FileGroup com menos de 5% livre (mas >= 2%)
                const hasFgWarning = db.filegroups.some(fg => {
                    const pctUsed = fg.pct_used !== undefined ? fg.pct_used : (100 - (fg.free_percent || 0));
                    return pctUsed >= 95 && pctUsed < 98;
                });

                const hasFgAttention = db.filegroups.some(fg => {
                    const pctUsed = fg.pct_used !== undefined ? fg.pct_used : (100 - (fg.free_percent || 0));
                    return pctUsed >= 90 && pctUsed < 95;
                });

                if (hasFgCritical) fgCriticalDbs++;
                if (hasFgWarning && !hasFgCritical) fgWarningDbs++;
                if (hasFgAttention && !hasFgCritical && !hasFgWarning) fgAttentionDbs++;
                if (hasFgCritical || hasFgWarning) alertDbs++;
                
