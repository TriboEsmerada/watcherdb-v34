                const sqlDiagConfig = getSQLDiagnosticsConfig();
                debugLog(`[INFO] SQL Diag Config - visibleQueries: ${sqlDiagConfig.visibleQueries.length} queries`, 'info');
                debugLog(`[INFO] SQL Diag Config - IDs: ${sqlDiagConfig.visibleQueries.join(', ')}`, 'info');
                
                const visibleStandardQueries = standardQueries.filter(q => {
                    const isVisible = sqlDiagConfig.visibleQueries.includes(q.id);
