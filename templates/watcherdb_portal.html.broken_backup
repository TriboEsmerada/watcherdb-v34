                        <h2 style="margin: 0;">${(data.instance_id || '').replace('_', '\\\\')}</h2>
                        <button onclick="document.getElementById('maintenance-detail-modal').remove()" style="background: none; border: none; font-size: 1.5em; cursor: pointer; color: var(--color-text-secondary);">
