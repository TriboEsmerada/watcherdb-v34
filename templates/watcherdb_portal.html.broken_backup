                } else if (!hasAO) {
                    // Verificar se houve erro de conexão/timeout
                    if (serverStatus.error) {
                        html += `
                            <div class="card" style="border-left: 4px solid #f59e0b;">
                                <h4><i class="fas fa-exclamation-triangle"></i> Always On</h4>
