                // Extrair databases uúúnicos com problemas
                const dbsWithCritical = [...new Set(criticalFilegroupsList.map(fg => fg.database_name))];
                const dbsWithWarning = [...new Set(warningFilegroupsList.map(fg => fg.database_name))];
                const allProblematicDbs = [...new Set([...dbsWithCritical, ...dbsWithWarning])];
