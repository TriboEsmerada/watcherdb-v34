                    <svg width="${size}" height="${size * 0.6}" viewBox="0 0 100 60">
                        <path d="M 10 55 A 40 40 0 0 1 90 55" fill="none" stroke="#1e293b" stroke-width="8" stroke-linecap="round"/>
