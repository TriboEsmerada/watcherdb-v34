        /* Tab Content */
        .sql-results-tab-content {
            display: none;
            padding: var(--space-lg);
            overflow: auto;
            max-height: calc(90vh - 220px);
        }
        .sql-results-tab-content.active {
            display: block;
        }

        /* Action Buttons */
        .sql-results-actions {
            padding: var(--space-sm) var(--space-lg);
            background: #0f172a;
            border-top: 1px solid #334155;
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }
        .sql-results-btn {
            padding: 10px 20px;
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
            font-size: var(--font-sm);
            font-weight: var(--font-weight-medium);
