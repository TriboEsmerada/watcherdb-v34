        // Filtrar instâncias por ambiente
        function filterByEnv(env) {
            // Toggle: se clicar não mesmo ambiente, limpa o filtro
            if (currentEnvFilter === env) {
                clearEnvFilter();
                return;
            }

            currentEnvFilter = env;

            // Atualizar visual das barras
            document.querySelectorAll('.env-bar-row').forEach(row => {
                const rowEnv = row.dataset.env;
                if (rowEnv === env) {
                    row.style.background = 'rgba(59, 130, 246, 0.2)';
