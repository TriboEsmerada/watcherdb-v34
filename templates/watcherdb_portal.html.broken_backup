                                <i class="fas fa-sort"></i>
                            </span>
                        </th>
                    `;
                });

                // Coluna de aes
                tempdbHtml += `
                    <th style="text-align: center; min-width: 110px;">
                        <i class="fas fa-stethoscope" style="margin-right: 4px;"></i>Aes
                    </th>
                </tr>
            </thead>
            <tbody id="sqlResultsTableBody">
                `;

                // Linhas dos viles
                villainRows.forEach(row => {
                    tempdbHtml += `<tr>`;
                    villainColumns.forEach(key => {
                        const value = row[key];
                        if (key === 'query_text') {
                            // Query clicvel
                            const fullText = String(value || 'N/A');
                            const hasValue = fullText && fullText !== 'N/A' && fullText !== 'null' && fullText.length > 0;
                            const shortText = hasValue ? (fullText.length > 40 ? fullText.substring(0, 40) + '...' : fullText) : 'N/A';
                            if (hasValue) {
                                const rowIndex = villainRows.indexOf(row);
                                tempdbHtml += `
                                    <td style="cursor: pointer; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #60a5fa;"
                                        title="Clique para ver a query completa"
                                        onclick="showQueryDetailModalForTempDB(${rowIndex})">
                                        <i class="fas fa-code" style="margin-right: 6px; opacity: 0.7;"></i>${escapeHtml(shortText)}
                                    </td>
                                `;
                            } else {
                                tempdbHtml += `<td style="color: #64748b;">N/A</td>`;
                            }
                        } else if (key === 'space_used_mb' || key === 'percent_of_tempdb' || key === 'user_objects_mb' || key === 'internal_objects_mb') {
                            // Valores numéricos formatados (MB ou %)
                            const num = parseFloat(value);
                            if (!isNaN(num) && num !== 0) {
                                let formatted, cellStyle = '';
                                if (key === 'percent_of_tempdb') {
                                    formatted = num.toFixed(2) + '%';
                                    if (num >= 20) cellStyle = 'color: #ef4444; font-weight: 600;';
                                    else if (num >= 10) cellStyle = 'color: #f59e0b; font-weight: 600;';
                                } else {
                                    formatted = num.toLocaleString('pt-BR', {maximumFractionDigits: 2});
                                    // Destacar consumos altos
                                    if (key === 'space_used_mb' && num >= 1000) {
                                        cellStyle = 'color: #ef4444; font-weight: 600;';
                                    } else if (key === 'space_used_mb' && num >= 500) {
                                        cellStyle = 'color: #f59e0b; font-weight: 600;';
                                    }
                                }
                                tempdbHtml += `<td style="${cellStyle}">${formatted}</td>`;
                            } else {
                                tempdbHtml += `<td style="color: #64748b;">-</td>`;
                            }
