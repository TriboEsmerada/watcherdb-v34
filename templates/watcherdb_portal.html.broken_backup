        // Funo para resolver evento de servidor offline
        async function resolveServerOfflineEvent(eventId) {
            if (!confirm('Confirma a resoluo deste evento')) return;

            try {
                const baseEndpoint = cachedKpiEndpoint || await detectKpiEndpoint();
                const url = baseEndpoint.replace('/dashboard', `/server-offline/resolve/${eventId}`);

                const response = await fetch(url, { method: 'POST' });
                const result = await response.json();

                if (result.success) {
                    showNotification('Evento marcado como resolvido!', 'success');
                    // Recarregar modal
                    showServerOfflineDetails();
                    // Recarregar dashboard
                    await fetchKPIData();
                } else {
                    throw new Error(result.error || 'Erro ao resolver evento');
                }
            } catch (error) {
                showNotification(`Erro: ${error.message}`, 'error');
            }
        }

