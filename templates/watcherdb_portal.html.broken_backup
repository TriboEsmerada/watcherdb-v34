        function createTab(server, tabType) {
            const tabId = generateTabId(server.server_id, tabType);
            
            // Verificar se já existe uma aba para este servidor e tipo
            const existingTab = Array.from(openTabs.values()).find(
                tab => tab.server.server_id === server.server_id && tab.tabType === tabType
            );
            
            if (existingTab) {
                // Se já existe, apenas ativar
                activateTab(existingTab.tabId);
                return existingTab.tabId;
            }
            
            // Criar nova aba
            const tabsContainer = document.getElementById('tabs');
            const tabsContentArea = document.getElementById('tabsContentArea');
            
            // IMPORTANTE: Limpar apenas conteúdo que não seja de uma aba (KPIs do dashboard)
            // Mas preservar os contentElements das abas existentes
            const existingContentElements = Array.from(tabsContentArea.children).filter(
                child => child.classList.contains('tab-content')
            );

            // Limpar tabsContentArea (remove KPIs do dashboard se houver)
            // IMPORTANTE: Remover qualquer conteúdo que não seja um tab-content para evitar
            // que KPIs do dashboard apaream nas abas de overview
            tabsContentArea.innerHTML = '';

            // Restaurar apenas os contentElements das abas existentes
            existingContentElements.forEach(element => {
                tabsContentArea.appendChild(element);
            });
            
            // Criar elemento da nova aba
            const tabElement = document.createElement('div');
            tabElement.className = 'dynamic-tab';
            tabElement.dataset.tabId = tabId;
            tabElement.setAttribute('draggable', 'true');
            const tabLabel = getTabLabel(server, tabType);
            tabElement.innerHTML = `
                <span class="tab-label" title="${tabLabel}">${tabLabel}</span>
                <span class="tab-refresh" onclick="event.stopPropagation(); refreshTab('${tabId}')" title="Atualizar aba">
                    <i class="fas fa-sync-alt"></i>
                </span>
                <span class="tab-close" onclick="event.stopPropagation(); closeTab('${tabId}')" title="Fechar aba">
                    <i class="fas fa-times" style="font-size: 10px;"></i>
                </span>
            `;
            
            tabElement.onclick = () => activateTab(tabId);
            // Eventos para drag & drop (reordenao de abas)
            tabElement.addEventListener('dragstart', (event) => handleTabDragStart(event, tabId));
            tabElement.addEventListener('dragover', (event) => handleTabDragOver(event));
            tabElement.addEventListener('drop', (event) => handleTabDrop(event, tabId));
            tabElement.addEventListener('dragend', () => { draggedTabId = null; });
            
            // Criar conteúdo da nova aba
            const contentElement = document.createElement('div');
            contentElement.className = 'tab-content';
            contentElement.id = `tab-content-${tabId}`;
            contentElement.innerHTML = ''; // Limpar conteúdo
            
            // Adicionar nova aba ao DOM
            tabsContainer.appendChild(tabElement);
            tabsContentArea.appendChild(contentElement);
            
            // Armazenar não Map
            openTabs.set(tabId, {
                tabId: tabId,
                server: server,
                tabType: tabType,
                element: tabElement,
                contentElement: contentElement,
                interval: null // Intervalo específico desta aba (se houver)
            });
            
            // Mostrar container de abas ANTES de ativar
            document.getElementById('tabsContainer').classList.add('show');
            
            // Ativar a nova aba (isso vai carregar o conteúdo)
            activateTab(tabId);
            
            debugLog(`[INFO] Nova aba criada: ${tabId} (${server.name} - ${tabType})`, 'info');
            
            return tabId;
        }

        // ========================================
        // DRAG & DROP DAS ABAS DINMICAS
        // ========================================

        function handleTabDragStart(event, tabId) {
            draggedTabId = tabId;
            try {
                if (event.dataTransfer) {
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', tabId);
                }
            } catch (e) {
                // Alguns browsers podem não permitir setData aqui, ignorar
            }
        }

        function handleTabDragOver(event) {
            // Permitir drop
            event.preventDefault();
            if (event.dataTransfer) {
                event.dataTransfer.dropEffect = 'move';
            }
        }

        function handleTabDrop(event, targetTabId) {
            event.preventDefault();
            if (!draggedTabId || draggedTabId === targetTabId) {
                return;
            }

            const tabsContainer = document.getElementById('tabs');
            if (!tabsContainer) return;

            const draggedEl = tabsContainer.querySelector(`.dynamic-tab[data-tab-id="${draggedTabId}"]`);
            const targetEl = tabsContainer.querySelector(`.dynamic-tab[data-tab-id="${targetTabId}"]`);
            if (!draggedEl || !targetEl || draggedEl === targetEl) return;

            const targetRect = targetEl.getBoundingClientRect();
            const insertAfter = event.clientX > targetRect.left + targetRect.width / 2;

            if (insertAfter) {
                tabsContainer.insertBefore(draggedEl, targetEl.nextSibling);
            } else {
                tabsContainer.insertBefore(draggedEl, targetEl);
            }

            debugLog(`[INFO] Aba reordenada: ${draggedTabId} em relao a ${targetTabId}`, 'info');
        }
        
        function activateTab(tabId) {
            const tab = openTabs.get(tabId);
            if (!tab) return;
            
            // Desativar todas as abas
            document.querySelectorAll('.dynamic-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            
            // Ativar a aba selecionada
            tab.element.classList.add('active');
            tab.contentElement.classList.add('active');
            
            activeTabId = tabId;
            // Só definir selectedServer se não for dashboard-kpis
            if (tab.tabType !== 'dashboard-kpis') {
                selectedServer = tab.server;
            } else {
                selectedServer = null;
            }
            currentTab = tab.tabType;
            
            // Atualizar header
            document.getElementById('serverHeader').classList.add('show');
            document.getElementById('serverName').textContent = tab.server.name;
            document.getElementById('serverId').textContent = tab.server.server_id;
            
            // Habilitar boto de ping apenas se não for dashboard-kpis
            const pingButton = document.getElementById('pingButton');
            if (pingButton) {
                if (tab.tabType === 'dashboard-kpis') {
                    pingButton.style.opacity = '0.5';
                    pingButton.style.pointerEvents = 'none';
                } else {
                    pingButton.style.opacity = '1';
                    pingButton.style.pointerEvents = 'auto';
                }
            }
            
            // Carregar conteúdo apenas se necessrio (no recarregar se já foi carregado)
            // Verificar se o conteúdo já foi carregado antes de recarregar
            const hasContent = tab.contentElement.innerHTML.trim() && 
                              !tab.contentElement.innerHTML.includes('loading') &&
                              !tab.contentElement.innerHTML.includes('Carregando');
            
            if (!hasContent) {
                loadTabContent(tabId);
            } else {
                debugLog(`[INFO] Conteúdo da aba ${tabId} já carregado, pulando recarregamento`, 'info');
            }
            
            debugLog(` Aba ativada: ${tabId}`, 'info');
        }
        
        // Funo para atualizar uma aba específica
        async function refreshTab(tabId) {
            const tab = openTabs.get(tabId);
            if (!tab) return;
            
            debugLog(`[INFO] Atualizando aba: ${tabId} (${tab.tabType})`, 'info');
            
            // Adicionar classe de animao ao boto de refresh
            const refreshBtn = tab.element.querySelector('.tab-refresh');
            if (refreshBtn) {
                refreshBtn.classList.add('refreshing');
            }
            
            // Limpar cache da aba
            clearTabCache(tab.tabType, tab.server.server_id);
            
            // Cancelar requisições anteriores desta aba
            cancelTabRequests(tabId);
            
            // Recarregar conteúdo baseado não tipo da aba
            try {
                if (tab.tabType === 'overview') {
                    await renderOverviewForTab(tabId);
                } else if (tab.tabType === 'space') {
                    await loadSpaceAnalysisForTab(tabId);
                } else if (tab.tabType === 'memory') {
                    await loadMemoryAnalysisForTab(tabId);
                } else if (tab.tabType === 'cpu') {
                    await loadCPUAnalysisForTab(tabId);
                } else if (tab.tabType === 'backup') {
                    await loadBackupAnalysisForTab(tabId);
                } else if (tab.tabType === 'security') {
                    await loadSecurityForTab(tabId);
                } else if (tab.tabType === 'encrypted') {
                    await loadEncryptedForTab(tabId);
                } else if (tab.tabType === 'log') {
                    await loadLogAnalysisForTab(tabId);
                } else if (tab.tabType === 'alwayson') {
                    await loadAlwaysOnForTab(tabId);
                } else if (tab.tabType === 'sql-diagnostics') {
                    await loadSQLDiagnosticsForTab(tabId);
                } else if (tab.tabType === 'services') {
                    await loadServicesForTab(tabId);
                } else if (tab.tabType === 'users') {
                    await loadUsersAnalysisForTab(tabId);
                } else if (tab.tabType === 'jobs') {
                    await loadJobsAnalysisForTab(tabId);
                } else if (tab.tabType === 'dashboard-kpis') {
                    await renderDashboardCardsForTab(tabId);
                }
            } catch (error) {
                debugLog(` Erro ao atualizar aba ${tabId}: ${error.message}`, 'error');
            } finally {
                // Remover classe de animao
                if (refreshBtn) {
                    setTimeout(() => {
                        refreshBtn.classList.remove('refreshing');
                    }, 500);
                }
            }
        }
        
        function closeTab(tabId) {
            const tab = openTabs.get(tabId);
            if (!tab) return;
            
            debugLog(`[INFO] Fechando aba: ${tabId} (${tab.tabType})`, 'info');
            
            // 1. Cancelar TODAS as requisições ativas relacionadas a esta aba
            cancelTabRequests(tabId);
            
            // 2. Limpar intervalos específicos desta aba
            if (tab.interval) {
                clearInterval(tab.interval);
                debugLog(`[INFO] Intervalo da aba ${tabId} cancelado`, 'info');
            }
            
            // Limpar intervalo do Map de intervalos
            if (tabIntervals.has(tabId)) {
                clearInterval(tabIntervals.get(tabId));
                tabIntervals.delete(tabId);
                debugLog(`[INFO] Intervalo do Map cancelado para aba ${tabId}`, 'info');
            }
            
            // 3. Cancelar todos os timeouts desta aba
            if (tabTimeouts.has(tabId)) {
                const timeouts = tabTimeouts.get(tabId);
                timeouts.forEach(timeoutId => clearTimeout(timeoutId));
                tabTimeouts.delete(tabId);
                debugLog(`[INFO] ${timeouts.size} timeout(s) da aba ${tabId} cancelado(s)`, 'info');
            }
            
            // 4. Se for uma aba de dashboard, limpar TODOS os intervalos relacionados
            // IMPORTANTE: Fazer isso ANTES de remover a aba do Map para poder verificar outras abas
            if (tab.tabType === 'dashboard-kpis') {
                // Limpar intervalo da aba específica
                if (tab.interval) {
                    clearInterval(tab.interval);
                    tab.interval = null;
                    debugLog(`[INFO] Intervalo da aba dashboard cancelado (tab.interval)`, 'info');
                }
                
                // Limpar intervalo do Map de intervalos
                if (tabIntervals.has(tabId)) {
                    const intervalId = tabIntervals.get(tabId);
                    clearInterval(intervalId);
                    tabIntervals.delete(tabId);
                    debugLog(`[INFO] Intervalo da aba dashboard cancelado (tabIntervals)`, 'info');
                }
                
                // Limpar dashboardRefreshInterval global APENAS se for desta aba específica
                // Verificar se h outras abas de dashboard abertas (ANTES de remover esta aba)
                const otherDashboardTabs = Array.from(openTabs.values()).filter(
                    t => t.tabType === 'dashboard-kpis' && t.tabId !== tabId
                );
                
                if (otherDashboardTabs.length === 0) {
                    // Não há outras abas de dashboard, pode limpar o global
                    if (dashboardRefreshInterval) {
                        clearInterval(dashboardRefreshInterval);
                        dashboardRefreshInterval = null;
                        debugLog(`[INFO] Auto-refresh global do dashboard cancelado (última aba fechada)`, 'info');
                    }
                } else {
                    debugLog(`[INFO] Outras abas de dashboard ainda abertas (${otherDashboardTabs.length}), mantendo intervalo global`, 'info');
                }
            }
            
            // 5. Limpar qualquer Promise.all ou processos assncronos pendentes
            // (isso é feito automaticamente ao cancelar os AbortControllers)
            
            // 6. Remover do DOM
            tab.element.remove();
            tab.contentElement.remove();
            
            // 7. Remover do Map (DEPOIS de limpar intervalos e verificar outras abas)
            openTabs.delete(tabId);
            
            // 6. Se era a aba ativa, ativar outra
            if (activeTabId === tabId) {
                const remainingTabs = Array.from(openTabs.values());
                if (remainingTabs.length > 0) {
                    // Ativar a última aba ou a primeira
                    activateTab(remainingTabs[remainingTabs.length - 1].tabId);
                } else {
                    // Nenhuma aba restante
                    activeTabId = null;
                    selectedServer = null;
                    currentTab = 'overview';
                    document.getElementById('serverHeader').classList.remove('show');
                    document.getElementById('tabsContainer').classList.remove('show');

                    // Mostrar loading do olho na rea de conteúdo
                    const contentArea = document.getElementById('tabsContentArea');
                    if (contentArea) {
                        contentArea.innerHTML = createPremiumLoading('Selecione um servidor ou aguarde os KPIs...');
                    }

                    // Desabilitar boto de ping
                    const pingButton = document.getElementById('pingButton');
                    if (pingButton) {
                        pingButton.style.opacity = '0.5';
                        pingButton.style.pointerEvents = 'none';
                    }
                }
            }
            
            debugLog(` Aba fechada: ${tabId}`, 'info');
        }
        
        // Funão háelper para criar loading premium
        function createPremiumLoading(text = 'Carregando...') {
            return `
                <div class="loading-premium">
                    <svg class="loading-logo" viewBox="0 0 120 120">
                        <!-- Spinner externo -->
