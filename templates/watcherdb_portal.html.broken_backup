        // Funo para abrir query Transaction Log não SQL Diagnostics
        async function openTransactionLogQuery(serverId, instanceName) {
            debugLog(`[INFO] Abrindo Transaction Log para ${instanceName} (serverId: ${serverId})`, 'info');
            
            // Buscar servidor na lista
            let foundServer = allServers.find(server => {
                const serverIdLower = server.server_id.toLowerCase();
                const serverNameLower = server.name.toLowerCase();
                const searchName = instanceName.toLowerCase();
                const searchServerId = serverId.toLowerCase();
                
                return serverIdLower === searchServerId || 
                       serverNameLower === searchName ||
                       serverIdLower.replace(/_/g, '\\') === searchName.replace(/\\/g, '\\') ||
                       serverNameLower.replace(/\\/g, '_') === searchServerId;
            });
            
            // Se não encontrou, tentar buscar pelo instanceName convertendo formatos
            if (!foundServer) {
                // Tentar diferentes formatos
                const formats = [
                    instanceName,
                    instanceName.replace(/\\/g, '_'),
                    instanceName.replace(/_/g, '\\'),
                    serverId,
                    serverId.replace(/_/g, '\\')
                ];
                
                for (const format of formats) {
                    foundServer = allServers.find(server => {
                        return server.server_id.toLowerCase() === format.toLowerCase() ||
                               server.name.toLowerCase() === format.toLowerCase();
                    });
                    if (foundServer) break;
                }
            }
            
            if (!foundServer) {
                debugLog(` Servidor não encontrado: ${instanceName} (${serverId})`, 'error');
                alert(`Servidor "${instanceName}" não encontrado na lista de servidores.\n\nTente buscar manualmente na barra de pesquisa.`);
                return;
            }
            
            debugLog(` Servidor encontrado: ${foundServer.name} (${foundServer.server_id})`, 'success');
            
            // Fechar modal
            closeInstancesModal();
            
            // Criar aba SQL Diagnostics
            const tabId = createTab(foundServer, 'sql-diagnostics');
            
            debugLog(`[INFO] Tab criada: ${tabId}, aguardando carregamento...`, 'info');
            
            // Aguardar a aba ser criada e executar a query log-space
            let attempts = 0;
            const maxAttempts = 50; // 5 segundos (50 * 100ms)
            
            const checkAndExecute = setInterval(() => {
                attempts++;
                
                // Verificar se a aba est ativa
                if (activeTabId === tabId) {
                    const tab = openTabs.get(activeTabId);
                    if (tab && tab.contentElement && tab.tabType === 'sql-diagnostics') {
                        const queryResultsDiv = tab.contentElement.querySelector('#queryResults');
                        if (queryResultsDiv) {
                            clearInterval(checkAndExecute);
                            
                            const queryEndpoint = `/api/queries/log-space/${foundServer.server_id}`;
                            const queryName = 'Transaction Log';
                            
                            debugLog(`[INFO] Executando query Transaction Log automaticamente`, 'info');
                            debugLog(`[INFO] Endpoint: ${queryEndpoint}`, 'info');
                            
                            // Executar a query automaticamente
                            if (typeof loadQueryDiagnostic === 'function') {
                                loadQueryDiagnostic('log-space', queryEndpoint, queryName, false);
                            } else {
                                debugLog(`[INFO] Funo loadQueryDiagnostic não encontrada`, 'warning');
                                // Tentar executar diretamente via fetch
                                executeQueryDirectly(queryEndpoint, queryName);
                            }
                            return;
                        }
                    }
                }
                
                // Timeout após maxAttempts
                if (attempts >= maxAttempts) {
                    clearInterval(checkAndExecute);
                    debugLog(`[INFO] Timeout aguardando aba SQL Diagnostics, tentando executar mesmo assim`, 'warning');
                    const queryEndpoint = `/api/queries/log-space/${foundServer.server_id}`;
                    const queryName = 'Transaction Log';
                    
                    if (typeof loadQueryDiagnostic === 'function') {
                        loadQueryDiagnostic('log-space', queryEndpoint, queryName, false);
                    } else {
                        executeQueryDirectly(queryEndpoint, queryName);
                    }
                }
            }, 100);
            
            // Funo auxiliar para executar query diretamente se loadQueryDiagnostic não estiver disponível
            async function executeQueryDirectly(endpoint, queryName) {
                try {
                    debugLog(`[INFO] Executando query diretamente: ${endpoint}`, 'info');
                    const response = await fetch(endpoint);
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                    }
                    const data = await response.json();
                    debugLog(` Query executada com sucesso, ${data.log_space.length || 0} databases encontrados`, 'success');
                    
                    // Tentar encontrar o div de resultados e atualizar
                    const tab = openTabs.get(activeTabId);
                    if (tab && tab.contentElement) {
                        const resultsDiv = tab.contentElement.querySelector('#queryResults');
                        if (resultsDiv && typeof loadQueryDiagnostic === 'function') {
                            // Recarregar a query usando a funo padrão
                            loadQueryDiagnostic('log-space', endpoint, queryName, false);
                        }
                    }
                } catch (error) {
                    debugLog(` Erro ao executar query diretamente: ${error.message}`, 'error');
                }
            }
        }
        
        // Funo para selecionar instância do modal e abrir o servidor não SQL Diagnostics
        async function selectInstanceFromModal(instanceName, kpiType = null) {
            try {
                console.log('[INFO] selectInstanceFromModal CHAMADO!', { instanceName, kpiType });

                // Garantir que recebemos uma string vlida
                if (!instanceName || typeof instanceName !== 'string') {
                    debugLog(` Nome de instância inválido: ${instanceName}`, 'error');
                    alert('Erro: Nome de instância inválido.');
                    return;
                }

                debugLog(`[INFO] Buscando servidor para instância: ${instanceName}`, 'info');
                debugLog(`[INFO] Tipo: ${typeof instanceName}, Valor: "${instanceName}"`, 'info');
                debugLog(`[INFO] KPI Type: ${kpiType}`, 'info');
                console.log('[INFO] KPI_TO_QUERY_MAP:', KPI_TO_QUERY_MAP);
                console.log('[INFO] Query mapeada:', KPI_TO_QUERY_MAP[kpiType]);
            
            // Se for Always On, buscar a instância correta não inventory primeiro
            let resolvedServerId = null;
            if (kpiType === 'always-on') {
                try {
                    debugLog(`[INFO] Buscando instância não inventory para AG: ${instanceName}`, 'info');
                    const response = await fetch(`/api/alwayson/instance-by-ag/${encodeURIComponent(instanceName)}`);
                    
                    // Verificar se a resposta é OK
                    if (!response.ok) {
                        const errorData = await response.json().catch(() => ({ error: 'Erro desconhecido' }));
                        debugLog(`[INFO] Erro HTTP ${response.status}: ${errorData.error || 'N/A'}`, 'warning');
                        alert(`AG "${instanceName}" não foi encontrado na configuração.\n\n` +
                              `Erro: ${errorData.error || 'AG não configurado'}\n\n` +
                              `Sugesto: ${errorData.suggestion || 'Verifique se o AG est configurado não alwayson_inventory.json ou sql_servers.json'}`);
                        closeInstancesModal();
                        return;
                    }
                    
                    const result = await response.json();
                    
                    if (result.success && result.server_id) {
                        debugLog(` Instância encontrada não inventory: ${result.server_id} (${result.server}\\${result.instance || 'DEFAULT'})`, 'success');
                        debugLog(`[INFO] Source: ${result.source || 'unknown'}`, 'info');
                        // Usar o server_id encontrado não inventory
                        resolvedServerId = result.server_id;
                        instanceName = result.server_id;
                    } else {
                        debugLog(`[INFO] AG não encontrado não inventory: ${result.error || 'N/A'}`, 'warning');
                        // Mostrar mensagem mais clara ao usurio
                        alert(`AG "${instanceName}" não foi encontrado na configuração.\n\n` +
                              `Erro: ${result.error || 'AG não configurado'}\n\n` +
                              `Sugesto: ${result.suggestion || 'Verifique se o AG est configurado não alwayson_inventory.json ou sql_servers.json'}`);
                        closeInstancesModal();
                        return;
                    }
                } catch (error) {
                    debugLog(`[INFO] Erro ao buscar instância não inventory: ${error.message}`, 'error');
                    alert(`Erro ao buscar instância para o AG "${instanceName}":\n${error.message}\n\nTente buscar manualmente na barra de pesquisa.`);
                    closeInstancesModal();
                    return;
                }
            }
            
            // Remover domnio do nome (ex: "SQLHDSPRD302.tapnet.tap.pt" -> "SQLHDSPRD302")
            const removeDomain = (hostname) => {
                if (!hostname) return hostname;
                // Remover domnios comuns (.tapnet.tap.pt, .tap.pt, etc)
                return hostname.split('.')[0];
            };
            
            // Extrair host e instância do nome (pode vir como "SQLHDSPRD014\I03" ou "SQLHDSPRD014_I03" ou "SQLHDSPRD302.tapnet.tap.pt\I01")
            let host = '';
            let instance = '';
            
            debugLog(`[INFO] Processando instanceName: "${instanceName}" (length: ${instanceName.length})`, 'info');
            
            // Primeiro, normalizar o nome removendo escapes duplos se houver
            let normalizedName = instanceName.replace(/\\\\/g, '\\');
            debugLog(`[INFO] Nome normalizado: "${normalizedName}"`, 'info');
            
            if (normalizedName.includes('\\')) {
                const parts = normalizedName.split('\\', 2);
                host = removeDomain(parts[0]); // Remover domnio do host
                instance = parts[1] || '';
                debugLog(`[INFO] Extrado (backslash): host="${host}", instance="${instance}"`, 'info');
            } else if (normalizedName.includes('_')) {
                const parts = normalizedName.split('_');
                // Para underscore, precisamos pegar tudo exceto a última parte como host
                // Mas se tiver apenas um underscore (ex: SQLHDSPRD214_I01), pegar corretamente
                if (parts.length === 2) {
                    host = removeDomain(parts[0]);
                    instance = parts[1];
                } else {
                    host = removeDomain(parts.slice(0, -1).join('_')); // Tudo exceto a última parte, removendo domnio
                    instance = parts[parts.length - 1]; // última parte
                }
                debugLog(`[INFO] Extrado (underscore): host="${host}", instance="${instance}"`, 'info');
            } else {
                // Tentar detectar padrão HOSTI## quando não há separador (ex: SQLHDSPRD214I01)
                const match = normalizedName.match(/^(.+)(I\d+)$/i);
                if (match) {
                    host = removeDomain(match[1]);
                    instance = match[2];
                    debugLog(`[INFO] Extrado (padrão detectado HOSTI##): host="${host}", instance="${instance}"`, 'info');
                } else {
                    host = removeDomain(normalizedName);
                    debugLog(`[INFO] Extrado (sem separador): host="${host}", instance="${instance}"`, 'info');
                }
            }
            
            // Normalizar instância (remover zeros ? esquerda, tratar I maiúsculo/minúsculo)
            const normalizeInstance = (inst) => {
                if (!inst) return '';
                // Se comea com I, manter o I e normalizar o número
                if (inst.toUpperCase().startsWith('I')) {
                    const num = inst.substring(1).replace(/^0+/, '') || '0';
                    return 'I' + num.padStart(inst.substring(1).length, '0'); // Manter zeros ? esquerda originais
                }
                // Se é só número, normalizar
                return inst.replace(/^0+/, '') || '0';
            };
            
            const normalizedInstance = normalizeInstance(instance);
            const hostLower = host.toLowerCase();
            
            debugLog(`[INFO] Host: ${host}, Instância: ${instance} (normalizada: ${normalizedInstance})`, 'info');
            
            // Tentar encontrar o servidor na lista
            let foundServer = null;
            
            // 0. Se temos um resolvedServerId (do Always On), buscar diretamente por ele primeiro
            if (resolvedServerId) {
                foundServer = allServers.find(server => {
                    const match = server.server_id.toLowerCase() === resolvedServerId.toLowerCase();
                    if (match) {
                        debugLog(` Match direto pelo resolvedServerId: ${server.server_id}`, 'success');
                    }
                    return match;
                });
                
                // Se não encontrou pelo server_id, tentar pelo name também
                if (!foundServer) {
                    // Converter resolvedServerId para formato name (SQLHDSPRD214_I01 -> SQLHDSPRD214\I01)
                    const nameFormat = resolvedServerId.replace('_', '\\');
                    foundServer = allServers.find(server => {
                        const match = server.name.toLowerCase() === nameFormat.toLowerCase();
                        if (match) {
                            debugLog(` Match pelo name formatado do resolvedServerId: ${server.name}`, 'success');
                        }
                        return match;
                    });
                }
            }
            
            // 1. Match exato com barra invertida (name) - formato: SQLHDSPRD023\I01
            // Também tentar sem domnio (só se ainda não encontrou)
            if (!foundServer) {
            foundServer = allServers.find(server => {
                const serverNameLower = server.name.toLowerCase();
                const instanceNameLower = instanceName.toLowerCase();
                const instanceNameNoDomain = instanceNameLower.split('\\').map(p => removeDomain(p)).join('\\');
                
                if (serverNameLower === instanceNameLower || serverNameLower === instanceNameNoDomain) {
                    debugLog(` Match exato não name: ${server.name}`, 'success');
                    return true;
                }
                return false;
            });
            }
            
            // 2. Match exato com underscore (server_id) - formato: SQLHDSPRD023_I01
            if (!foundServer) {
                const expectedId = instance ? `${host}_${instance}` : host;
                foundServer = allServers.find(server => {
                    const match = server.server_id.toLowerCase() === expectedId.toLowerCase();
                    if (match) {
                        debugLog(` Match exato não server_id: ${server.server_id}`, 'success');
                    }
                    return match;
                });
            }
            
            // 2b. Match exato com underscore alternativo (caso a instância venha sem I)
            if (!foundServer && instance) {
                // Tentar com e sem o I na frente
                const variations = [
                    `${host}_${instance}`,           // SQLHDSPRD023_I01
                    `${host}_I${instance}`,          // SQLHDSPRD023_II01 (se vier só 01)
                    `${host}_${instance.replace(/^I/i, '')}`, // SQLHDSPRD023_01 (se vier I01)
                ];
                
                for (const variation of variations) {
                    foundServer = allServers.find(server => {
                        const match = server.server_id.toLowerCase() === variation.toLowerCase();
                        if (match) {
                            debugLog(` Match exato não server_id (variao): ${server.server_id}`, 'success');
                        }
                        return match;
                    });
                    if (foundServer) break;
                }
            }
            
            // 3. Match com instância normalizada (I03 = I03, I003 = I003, etc)
            // Considerar também remoo de domnio
            if (!foundServer && instance) {
                foundServer = allServers.find(server => {
                    const serverNameLower = server.name.toLowerCase();
                    const serverIdLower = server.server_id.toLowerCase();
                    
                    // Tentar match não name (formato HOST\INSTANCE)
                    if (serverNameLower.includes('\\')) {
                        const [srvHostFull, srvInst] = serverNameLower.split('\\', 2);
                        const srvHost = removeDomain(srvHostFull);
                        if (srvHost === hostLower) {
                            const srvInstNorm = normalizeInstance(srvInst);
                            if (srvInstNorm === normalizedInstance || srvInstNorm.toLowerCase() === normalizedInstance.toLowerCase()) {
                                debugLog(` Match normalizado não name (sem domnio): ${server.name}`, 'success');
                                return true;
                            }
                        }
                    }
                    
                    // Tentar match não server_id (formato HOST_INSTANCE)
                    if (serverIdLower.includes('_')) {
                        const parts = serverIdLower.split('_');
                        const srvHostFull = parts.slice(0, -1).join('_');
                        const srvHost = removeDomain(srvHostFull);
                        const srvInst = parts[parts.length - 1];
                        if (srvHost === hostLower) {
                            const srvInstNorm = normalizeInstance(srvInst);
                            if (srvInstNorm === normalizedInstance || srvInstNorm.toLowerCase() === normalizedInstance.toLowerCase()) {
                                debugLog(` Match normalizado não server_id (sem domnio): ${server.server_id}`, 'success');
                                return true;
                            }
                        }
                    }
                    
                    return false;
                });
            }
            
            // 4. Match parcial (apenas host, pegar primeira instância encontrada)
            // Também tentar match sem domnio
            if (!foundServer) {
                foundServer = allServers.find(server => {
                    const serverNameLower = server.name.toLowerCase();
                    const serverIdLower = server.server_id.toLowerCase();
                    const serverHost = removeDomain(serverNameLower.split('\\')[0] || serverNameLower.split('_')[0] || '');
                    const serverIdHost = removeDomain(serverIdLower.split('_')[0] || '');
                    
                    return serverNameLower.startsWith(hostLower + '\\') || 
                           serverNameLower.startsWith(hostLower + '_') ||
                           serverIdLower.startsWith(hostLower + '_') ||
                           serverHost === hostLower ||
                           serverIdHost === hostLower;
                });
            }
            
            // 5. Match flexvel (busca por substring)
            // Considerar também sem domnio
            if (!foundServer) {
                foundServer = allServers.find(server => {
                    const serverNameLower = server.name.toLowerCase();
                    const serverIdLower = server.server_id.toLowerCase();
                    const searchTerm = instanceName.toLowerCase();
                    const searchTermNoDomain = removeDomain(searchTerm.split('\\')[0] || searchTerm.split('_')[0] || searchTerm);
                    const serverHostNoDomain = removeDomain(serverNameLower.split('\\')[0] || serverNameLower.split('_')[0] || serverNameLower);
                    const serverIdHostNoDomain = removeDomain(serverIdLower.split('_')[0] || serverIdLower);
                    
                    return serverNameLower.includes(searchTerm) || 
                           serverIdLower.includes(searchTerm) ||
                           searchTerm.includes(serverNameLower) ||
                           searchTerm.includes(serverIdLower) ||
                           serverHostNoDomain === searchTermNoDomain ||
                           serverIdHostNoDomain === searchTermNoDomain ||
                           (searchTermNoDomain && serverNameLower.includes(searchTermNoDomain)) ||
                           (searchTermNoDomain && serverIdLower.includes(searchTermNoDomain));
                });
            }
            
            if (foundServer) {
                debugLog(` Servidor encontrado: ${foundServer.name} (${foundServer.server_id})`, 'success');
                closeInstancesModal();
                
                // Se é instance-availability OU db-availability e a instância est OFF, fazer ping para confirmar
                if (kpiType === 'instance-availability' || kpiType === 'db-availability') {
                    debugLog(`[INFO] Verificando status da instância offline: ${foundServer.name}`, 'info');
                    
                    // Extrair apenas o hostname (sem instância) do foundServer
                    const serverId = foundServer.server_id || foundServer.name || '';
                    const hostname = extractHostname(serverId);
                    
                    // Mostrar loading não modal antes de fechar
                    const modalBody = document.querySelector('#instancesModal .modal-body');
                    if (modalBody) {
                        modalBody.innerHTML = createPremiumLoading(`Verificando conectividade de ${hostname}...`);
                    }
                    
                    // Fazer ping apenas não háostname (sem instância)
                    const pingResult = await pingServer(hostname);
                    
                    // Fechar modal
                    closeInstancesModal();
                    
                    // Mostrar resultado do ping em um modal customizado (texto selecionível)
                    if (!pingResult.success) {
                        // Instância est OFF - hostname não responde ao ping
                        showSelectableModal(
                            'Instância OFFLINE',
                            `
                            <div style="line-height: 1.8; color: #e5e7eb; user-select: text;">
                                <p><strong>Instância:</strong> ${foundServer.name}</p>
                                <p><strong>Hostname:</strong> ${hostname}</p>
                                <p><strong>Status:</strong> <span style="color: #ef4444;">OFFLINE</span></p>
                                <p><strong>Ping:</strong> ${pingResult.message || 'Hostname não responde ao ping'}</p>
                                <hr style="border-color: #334155; margin: 16px 0;">
                                <p style="color: #94a3b8; font-size: 13px;">
                                    O hostname não est respondendo ao ping. O servidor pode estar desligado ou inacessvel na rede.
                                </p>
                            </div>
                            `,
                            'OK'
                        );
                    } else {
                        // Instância responde ao ping - servidor est acessvel, mas pode ter serviços parados
                        showSelectableModal(
                            'Ping OK - Verificar Serviços',
                            `
                            <div style="line-height: 1.8; color: #e5e7eb; user-select: text;">
                                <p><strong>Instância:</strong> ${foundServer.name}</p>
                                <p><strong>Hostname:</strong> ${hostname}</p>
                                <p><strong>Status:</strong> <span style="color: #10b981;">PING OK</span></p>
                                <p><strong>Ping:</strong> ${pingResult.response_time_ms ? pingResult.response_time_ms.toFixed(2) + ' ms' : 'OK'}</p>
                                <hr style="border-color: #334155; margin: 16px 0;">
                                <p style="color: #94a3b8; font-size: 13px; margin-bottom: 16px;">
                                    O servidor est respondendo ao ping, mas a instância SQL Server pode estar offline. 
                                    Os serviços SQL Server podem estar parados.
                                </p>
                                <div style="margin-top: 16px;">
                                    <a href="#" id="checkServicesLink" style="
                                        display: inline-block;
                                        padding: 8px 16px;
                                        background: #3b82f6;
                                        color: white;
                                        text-decoration: none;
                                        border-radius: 4px;
                                        font-weight: 500;
                                        transition: background 0.2s;
                                    " onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'">
                                        [INFO] Verificar Serviços SQL Server
                                    </a>
                                </div>
                            </div>
                            `,
                            'Abrir Overview da Instância',
                            () => {
                            selectServer(foundServer);
                        }
                        );
                        
                        // Adicionar event listener para o link de verificar serviços
                        setTimeout(() => {
                            const checkServicesLink = document.getElementById('checkServicesLink');
                            if (checkServicesLink) {
                                checkServicesLink.addEventListener('click', (e) => {
                                    e.preventDefault();
                                    closeSelectableModal();
                                    // Abrir diretamente a aba Services (sem passar pelo Overview)
                                    if (typeof createTab === 'function') {
                                        createTab(foundServer, 'services');
                                    }
                                });
                            }
                        }, 100);
                    }
                    return;
                }
                
                // Mapear kpiType para a aba correta ou query do SQL Diagnostics
                // Valores com prefixo 'tab:' abrem uma aba específica
                // Valores sem prefixo abrem SQL Diagnostics com a query correspondente
                const mapping = KPI_TO_QUERY_MAP[kpiType];

                if (mapping) {
                    // Verificar se é uma aba específica (prefixo 'tab:')
                    if (mapping.startsWith('tab:')) {
                        const tabType = mapping.replace('tab:', '');
                        debugLog(`[INFO] Abrindo aba '${tabType}' para: ${foundServer.name} (KPI: ${kpiType})`, 'info');
                        // Abrir diretamente a aba específica (ex: alwayson, services, etc)
                        createTab(foundServer, tabType);

                        // Se for filegroup-usage, abrir automaticamente o drilldown de FileGroups problemticos
                        if (kpiType && kpiType.startsWith('filegroup-usage')) {
                            const serverId = foundServer.server_id || foundServer.name.replace('\\', '_');
                            setTimeout(() => {
                                if (kpiType === 'filegroup-usage-critical') {
                                    // Mostrar apenas FileGroups criticos (>= 98%)
                                    debugLog(`Abrindo drilldown de FileGroups CRITICAL para: ${serverId}`, 'info');
                                    showFgCriticalDetails(serverId);
                                } else if (kpiType === 'filegroup-usage-warning') {
                                    // Mostrar apenas FileGroups warning (95-98%)
                                    debugLog(`Abrindo drilldown de FileGroups WARNING para: ${serverId}`, 'info');
                                    showFgWarningDetails(serverId);
                                } else if (kpiType === 'filegroup-usage-attention') {
                                    // Mostrar apenas FileGroups attention (90-95%)
                                    debugLog(`Abrindo drilldown de FileGroups ATTENTION para: ${serverId}`, 'info');
                                    showFgAttentionDetails(serverId);
                                } else {
                                    // filegroup-usage generico: mostrar todos os FileGroups
                                    debugLog(`Abrindo drilldown de TODOS os FileGroups para: ${serverId}`, 'info');
                                    showAllFileGroupsDetails(serverId);
                                }
                            }, 800); // Aguardar aba Space carregar
                        }
                    } else {
                        //  uma query do SQL Diagnostics
                        const queryId = mapping;
                        debugLog(`[INFO] Abrindo SQL Diagnostics query '${queryId}' para: ${foundServer.name} (KPI: ${kpiType})`, 'info');
                        // Abrir aba de SQL Diagnostics
                        createTab(foundServer, 'sql-diagnostics');

                        // Aguardar a aba ser criada e depois executar a query específica
                        setTimeout(() => {
                            // 1. Tentar encontrar o card de query pelo ID (ex: query-card-blocking)
                            const queryCard = document.getElementById(`query-card-${queryId}`);
                            if (queryCard) {
                                queryCard.click();
                                debugLog(` Query card '${queryId}' clicado com sucesso`, 'success');
                                return;
                            }

                            // 2. Fallback: procurar por data-query-id
                            const queryByData = document.querySelector(`[data-query-id="${queryId}"]`);
                            if (queryByData) {
                                queryByData.click();
                                debugLog(` Query '${queryId}' executada via data-query-id`, 'success');
                                return;
                            }

                            // 3. último fallback: procurar por texto ou onclick
                            const allQueryCards = document.querySelectorAll('.query-card, [onclick*="loadQueryDiagnostic"]');
                            for (const card of allQueryCards) {
                                if (card.id.includes(queryId) ||
                                    card.onclick.toString().includes(queryId)) {
                                    card.click();
                                    debugLog(` Query '${queryId}' encontrada e executada via fallback`, 'success');
                                    return;
                                }
                            }

                            debugLog(`[INFO] Query card '${queryId}' não encontrado`, 'warning');
                        }, 600); // 600ms para garantir que o tab carregou
                    }
                } else {
                    // Se não há mapeamento, abrir Overview normalmente
                    debugLog(`[INFO] Abrindo Overview para: ${foundServer.name} (KPI: ${kpiType || 'N/A'} sem mapeamento)`, 'info');
                    selectServer(foundServer);
                }
                return; // Importante: retornar após processar o servidor encontrado
            } else {
                debugLog(` Servidor não encontrado para instância: ${instanceName}`, 'error');
                debugLog(`[INFO] Tentou buscar: host="${host}", instance="${instance}"`, 'info');
                debugLog(`[INFO] Servidores disponveis (primeiros 5): ${allServers.slice(0, 5).map(s => s.name).join(', ')}`, 'info');
                alert(`Servidor "${instanceName}" não encontrado na lista de servidores.\n\nTente buscar manualmente na barra de pesquisa.`);
                return;
            }
            } catch (error) {
