        // Funo para copiar o conteúdo da query/plan
        function copyQueryToClipboard() {
            const content = document.getElementById('queryDetailContent');
            if (!content) {
                showToast('Erro ao copiar', 'error');
                return;
            }

            const text = content.textContent || content.innerText;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast('Copiado para a rea de transferncia!', 'success');
                }).catch(err => {
                    fallbackCopy(text);
                });
            } else {
                fallbackCopy(text);
            }
        }

        // Fallback para copiar texto (navegadores mais antigos)
        function fallbackCopy(text) {
            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.left = '-9999px';
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand('copy');
                showToast('Copiado para a rea de transferncia!', 'success');
            } catch (err) {
                showToast('Erro ao copiar. Selecione o texto manualmente.', 'error');
            }
            document.body.removeChild(textArea);
        }

        // Toast simples (centralizado na tela)
        function showToast(message, type = 'success') {
            try {
                let container = document.getElementById('toastContainer');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'toastContainer';
                    container.style.position = 'fixed';
                    container.style.top = '50%';
                    container.style.left = '50%';
                    container.style.transform = 'translate(-50%, -50%)';
                    container.style.display = 'flex';
                    container.style.flexDirection = 'column';
                    container.style.gap = '8px';
                    container.style.pointerEvents = 'none';  // No bloquear cliques
                    document.body.appendChild(container);
                }
                // Sempre garantir z-index alto para aparecer sobre modais
                container.style.zIndex = '99999';

                const toast = document.createElement('div');
                toast.className = 'toast-notification';
                toast.style.minWidth = '220px';
                toast.style.maxWidth = '320px';
                toast.style.padding = '10px 14px';
                toast.style.borderRadius = '6px';
                toast.style.fontSize = '13px';
                toast.style.color = '#e5e7eb';
                toast.style.boxShadow = '0 4px 10px rgba(0,0,0,0.35)';
                toast.style.background = type === 'error'
                    ? 'linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)'
                    : 'linear-gradient(135deg, #059669 0%, #047857 100%)';
                toast.style.display = 'flex';
                toast.style.alignItems = 'center';
                toast.style.gap = '8px';

                toast.innerHTML = `
                    <span>
                        <i class="fas ${type === 'error' ? 'fa-times-circle' : 'fa-check-circle'}"></i>
                    </span>
                    <span>${message}</span>
                `;

                container.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(4px)';
                    toast.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
                    setTimeout(() => {
                        if (toast.parentNode) {
                            toast.parentNode.removeChild(toast);
                        }
                    }, 220);
                }, 2500);
            } catch (e) {
                console.warn('Erro ao mostrar toast:', e);
            }
        }

        // Helper genérico para copiar texto (usado em modais simples)
        function copyTextToClipboard(text) {
            if (!text) return;
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(() => {
                        debugLog(' Texto copiado para clipboard (navigator.clipboard)', 'success');
                        showToast('Script copiado com sucesso.', 'success');
                    }).catch(err => {
                        console.warn('navigator.clipboard falhou, usando fallback em copyTextToClipboard:', err);
                        fallbackCopyText(text);
                    });
                } else {
                    fallbackCopyText(text);
                }
            } catch (err) {
                console.warn('Erro inesperado em copyTextToClipboard, usando fallback:', err);
                fallbackCopyText(text);
            }
        }

        function fallbackCopyText(text) {
            try {
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.focus();
                textarea.select();
                const successful = document.execCommand('copy');
                document.body.removeChild(textarea);

                if (successful) {
                    debugLog(' Texto copiado para clipboard (fallback execCommand)', 'success');
                    showToast('Script copiado com sucesso.', 'success');
                } else {
                    throw new Error('document.execCommand("copy") retornou false');
                }
            } catch (err) {
                console.error('Erro ao copiar texto (fallback):', err);
                showToast('Erro ao copiar script.', 'error');
            }
        }

