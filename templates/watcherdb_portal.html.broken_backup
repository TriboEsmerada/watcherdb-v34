        const question = input.value.trim();
        input.value = '';

        // Add user message
        this.addMessage('user', question);

        // Show loading
        this.addMessage('bot', '<div class="loading-state"><i class="fas fa-spinner fa-spin"></i> Processando...</div>', true);

        try {
            const response = await fetch(`${INTELLIGENCE_API_BASE}/copilot/ask`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    question: question,
                    include_recommendations: true,
                    language: 'pt-BR'
                })
            });

            if (!response.ok) throw new Error('Erro ao processar pergunta');

            const answer = await response.json();

            // Remove loading message
            this.removeLastMessage();

            // Add bot response
            let responseHtml = `<p style="margin: 0 0 8px 0;">${answer.answer}</p>`;
            if (answer.recommendations.length > 0) {
                responseHtml += `
                    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--color-bg-elevated);">
                        <strong>Recomendacoes:</strong>
                        <ul style="margin: 8px 0 0 16px; padding: 0;">
                            ${answer.recommendations.map(r => `<li>${r}</li>`).join('')}
                        </ul>
                    </div>
                `;
            }
            this.addMessage('bot', responseHtml);

        } catch (error) {
            console.error('Error:', error);
            this.removeLastMessage();
            this.addMessage('bot', `<p style="color: var(--color-danger);">Erro: ${error.message}</p>`);
        }
    },

    addMessage(type, content, isLoading = false) {
        const container = document.getElementById('copilot-messages');
        if (!container) return;

        const message = document.createElement('div');
        message.className = `copilot-message ${type}`;
        if (isLoading) message.classList.add('loading-message');
        message.style.cssText = 'margin-bottom: 16px;';

        const avatarBg = type === 'user' ? 'var(--color-success)' : 'var(--color-info)';
        const icon = type === 'user' ? 'fa-user' : 'fa-robot';
        const bubbleStyle = type === 'user'
            ? 'background: var(--color-info); color: white; border-top-right-radius: 4px;'
            : 'background: var(--color-bg-tertiary); border-top-left-radius: 4px;';

        message.innerHTML = `
            <div style="display: flex; gap: 12px; ${type === 'user' ? 'flex-direction: row-reverse;' : ''}">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: ${avatarBg}; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <i class="fas ${icon}" style="color: white;"></i>
                </div>
                <div style="padding: 12px; border-radius: 12px; max-width: 80%; ${bubbleStyle}">
                    ${content}
                </div>
            </div>
        `;

        container.appendChild(message);
        container.scrollTop = container.scrollHeight;
        this.messages.push({ type, content });
    },

    removeLastMessage() {
        const container = document.getElementById('copilot-messages');
        const loadingMsg = container.querySelector('.loading-message');
        if (loadingMsg) loadingMsg.remove();
    },

    async generateReport(type = 'daily_summary') {
        const container = document.getElementById('copilot-report');
        if (!container) return;

        container.innerHTML = `
            <div class="loading-state">
                <i class="fas fa-spinner fa-spin"></i>
                <span>Gerando relatorio...</span>
            </div>
        `;

        try {
            const response = await fetch(`${INTELLIGENCE_API_BASE}/copilot/report`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    report_type: type,
                    period_hours: 24,
                    format: 'markdown'
                })
            });

            if (!response.ok) throw new Error('Erro ao gerar relatorio');

            const report = await response.json();

            container.innerHTML = `
                <div style="background: var(--color-bg-tertiary); border-radius: 8px; padding: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <strong><i class="fas fa-file-alt"></i> ${report.title}</strong>
                    </div>
                    <pre style="white-space: pre-wrap; font-family: inherit; font-size: 0.9em; margin: 0; max-height: 300px; overflow-y: auto;">${report.content}</pre>
                    ${report.key_findings.length > 0 ? `
                        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-bg-elevated);">
                            <strong>Principais Descobertas:</strong>
                            <ul style="margin: 8px 0 0 16px;">
                                ${report.key_findings.map(f => `<li>${f}</li>`).join('')}
                            </ul>
                        </div>
                    ` : ''}
                </div>
            `;
        } catch (error) {
            container.innerHTML = `
                <div class="alert-card critical">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>${error.message}</span>
                </div>
            `;
        }
    }
};

// ===========================================
// COPILOT INTEGRATION MODULE
// ===========================================
const CopilotIntegration = {
    async askAboutInstance(instanceId, riskLevel) {
        const question = this.generateInstanceQuestion(instanceId, riskLevel);
        await this.openCopilotWithQuestion(question, { instanceId, riskLevel, context: 'maintenance_score' });
    },

    async askAboutChaosPattern(patternType, patternData) {
        const question = this.generateChaosQuestion(patternType, patternData);
        await this.openCopilotWithQuestion(question, { patternType, context: 'chaos_detection' });
    },

    async askAboutAlert(alertType, alertMessage) {
        const question = `Como resolver o alerta: "${alertMessage}"`;
        await this.openCopilotWithQuestion(question, { alertType, context: 'alerts' });
    },

    generateInstanceQuestion(instanceId, riskLevel) {
        const formattedInstance = instanceId.replace('_', '\\\\');
        switch (riskLevel) {
            case 'CRITICAL':
                return `A instancia ${formattedInstance} esta em estado CRITICO. Quais acoes imediatas devo tomar`;
            case 'WARNING':
                return `A instancia ${formattedInstance} esta em WARNING. Quais problemas devo investigar`;
            default:
                return `Qual o status detalhado da instancia ${formattedInstance}`;
        }
    },

    generateChaosQuestion(patternType, patternData) {
        switch (patternType) {
            case 'CASCADE':
                return `Foi detectada uma cascata de problemas. Qual a provavel causa raiz e como interromper a propagacao`;
            case 'SIMULTANEOUS':
                return `Multiplos servidores estao com problemas simultaneos. Isso indica problema de infraestrutura`;
            case 'PERIODIC':
                return `Foi detectado um padrao periodico de problemas. O que pode estar causando isso`;
            default:
                return `O que significa o padrao "${patternType}" detectado não ambiente`;
        }
    },

    async openCopilotWithQuestion(question, context = {}) {
        // Open Copilot modal
        showInnovativeTab('copilot');

        // Wait for DOM to update
        await new Promise(resolve => setTimeout(resolve, 500));

        // Set the question in input and send
        const input = document.getElementById('copilot-input');
        if (input) {
            input.value = question;
            input.focus();
            setTimeout(() => DBACopilot.sendMessage(), 300);
        }
    },

    async requestDetailedAnalysis(instanceId) {
        const question = `Faca uma analise detalhada da instancia ${instanceId.replace('_', '\\\\')}.
Inclua: status atual, riscos identificados, metricas importantes e recomendacoes de acao.`;
        await this.openCopilotWithQuestion(question, { instanceId, context: 'detailed_analysis' });
    },

    async requestActionPlan(instanceId, issues = []) {
        const issuesList = issues.length > 0 ? issues.join(', ') : 'problemas criticos';
        const question = `Crie um plano de acao para resolver os seguintes problemas na instancia ${instanceId.replace('_', '\\\\')}: ${issuesList}`;
        await this.openCopilotWithQuestion(question, { instanceId, issues, context: 'action_plan' });
    }
};

// Export to window
window.MaintenanceScore = MaintenanceScore;
window.ChaosDetection = ChaosDetection;
window.DBACopilot = DBACopilot;
window.CopilotIntegration = CopilotIntegration;

console.log(' Innovative Features Modules loaded (API: ' + INTELLIGENCE_API_BASE + ')');
</script>

<script>
// Funcao para mostrar tabs inovadoras em modal fullscreen
function showInnovativeTab(tabName) {
    const container = document.getElementById('innovative-modal-container');

    let content = '';
    let title = '';
    let icon = '';

    switch(tabName) {
        case 'maintenance-score':
            title = 'Predictive Maintenance Score';
            icon = 'fa-heartbeat';
            content = `<div id="maintenance-score-content"><div class="loading-state"><i class="fas fa-spinner fa-spin"></i><span>Calculando scores de manutencao preditiva...</span></div></div>`;
            break;
        case 'chaos-detection':
            title = 'Chaos Detection';
            icon = 'fa-project-diagram';
            content = `<div id="chaos-detection-content"><div class="loading-state"><i class="fas fa-spinner fa-spin"></i><span>Detectando padrãoes de anomalias...</span></div></div>`;
            break;
        case 'copilot':
            title = 'DBA Copilot';
            icon = 'fa-robot';
            content = `<div id="copilot-content"><div class="loading-state"><i class="fas fa-spinner fa-spin"></i><span>Inicializando Copilot...</span></div></div>`;
            break;
    }

    container.innerHTML = `
        <div class="innovative-fullscreen-modal">
            <div class="innovative-modal-header">
                <div class="modal-title">
                    <i class="fas ${icon}"></i>
                    <h2>${title}</h2>
                </div>
                <button class="modal-close-btn" onclick="closeInnovativeModal()">
                    <i class="fas fa-times"></i> Fechar
                </button>
            </div>
            <div class="innovative-modal-body">
                ${content}
            </div>
        </div>
    `;

    container.style.display = 'block';
    document.body.style.overflow = 'hidden';

    // Carregar dados
    setTimeout(() => {
        switch(tabName) {
            case 'maintenance-score':
                if (typeof MaintenanceScore !== 'undefined') MaintenanceScore.load();
                break;
            case 'chaos-detection':
                if (typeof ChaosDetection !== 'undefined') ChaosDetection.load();
                break;
            case 'copilot':
                if (typeof DBACopilot !== 'undefined') DBACopilot.init();
                break;
        }
    }, 100);
}

function closeInnovativeModal() {
    const container = document.getElementById('innovative-modal-container');
    container.innerHTML = '';
    container.style.display = 'none';
    document.body.style.overflow = '';
}

// ESC para fechar modal
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeInnovativeModal();
    }
});

console.log(' Innovative Features integration loaded');
</script>

