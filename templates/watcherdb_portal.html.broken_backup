            if (ms < 1000) return `${Math.round(ms)}ms`;
            if (ms < 60000) return `${(ms / 1000).toFixed(1)}s`;
            return `${(ms / 60000).toFixed(1)}min`;
        }
        
        // Inicializar tooltips
        function initializeKPITooltips() {
            const cards = document.querySelectorAll('.kpi-card[data-kpi-meta]');
            
            cards.forEach(card => {
                const metaData = card.getAttribute('data-kpi-meta');
                if (!metaData || metaData === '') return;
                
                let tooltip = null;
                let tooltipTimeout = null;
                
                // Criar tooltip logo não incio para poder adicionar event listeners
                tooltip = document.createElement('div');
                tooltip.className = 'kpi-tooltip';
                document.body.appendChild(tooltip);
                
                const showTooltip = (e) => {
                    if (tooltipTimeout) {
                        clearTimeout(tooltipTimeout);
