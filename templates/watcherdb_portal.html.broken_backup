                const originalText = summaryDiv.dataset.originalText || summaryDiv.innerHTML;
                summaryDiv.dataset.originalText = originalText;
                const originalCount = (originalText.match(/\d+/) || [totalCount])[0];
                summaryDiv.innerHTML = `Mostrando <strong style="color: #60a5fa;">${visibleCount}</strong> de ${originalCount} (filtro: <strong style="color: #60a5fa;">${env}</strong>)`;
            }
        }

        // Limpar filtro de ambiente
        function clearEnvFilter() {
            currentEnvFilter = null;

            // Restaurar visual das barras
            document.querySelectorAll('.env-bar-row').forEach(row => {
                row.style.background = 'transparent';
                row.style.border = 'none';
                row.style.opacity = '1';
                row.classList.remove('active');
            });

            // Esconder info do filtro
            const filterInfo = document.getElementById('envFilterInfo');
            if (filterInfo) {
                filterInfo.style.display = 'none';
            }

            // Mostrar todos os itens
            document.querySelectorAll('.instance-item').forEach(item => {
                item.style.display = 'block';
            });

            // Restaurar contador original
            const summaryDiv = document.querySelector('#instancesModalBody > div[style*="color: #94a3b8"]');
            if (summaryDiv && summaryDiv.dataset.originalText) {
                summaryDiv.innerHTML = summaryDiv.dataset.originalText;
            }
