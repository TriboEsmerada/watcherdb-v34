    <script>
        // ========================================
        // GLOBAL STATE
        // ========================================
        let allServers = [];
        let filteredServers = [];
        let selectedServer = null;
        let activeAbortControllers = new Map(); // Para cancelar requisições em andamento
        let currentTab = 'overview';
        
        // Tab Management
        let openTabs = new Map(); // Map<tabId, {server, tabType, content, element, interval}>
        let activeTabId = null;
        let tabCounter = 0;
        let tabIntervals = new Map(); // Map<tabId, intervalId> - para limpar intervalos quando fechar aba
        let tabTimeouts = new Map(); // Map<tabId, Set<timeoutId>> - para limpar timeouts quando fechar aba
        let tabAbortControllers = new Map(); // Map<tabId, Set<AbortController>> - para rastrear controllers por aba
        let draggedTabId = null; // Para reordenao via drag & drop
        
        // ============================================================================
        // SISTEMA DE CACHE INTELIGENTE COM TTL DIFERENCIADO
        // ============================================================================

        // Sistema de cache genérico para todas as abas (Map<tabType_serverId, {data, timestamp, hits}>)
        let tabCache = new Map();

        // TTL diferenciado por tipo de aba (em milissegundos)
        // Dados que mudam raramente tm TTL maior
        const CACHE_TTL_BY_TYPE = {
            'overview': 120000,      // 2 minutos - overview geral, muda pouco
            'space': 300000,         // 5 minutos - espao em disco muda devagar
            'backup': 180000,        // 3 minutos - backups acontecem periodicamente
            'memory': 90000,         // 1.5 minutos - memória pode oscilar mais
            'cpu': 60000,            // 1 minuto - CPU varia mais rapidamente
            'queries': 120000,       // 2 minutos - queries problemáticas mudam pouco
            'alwayson': 240000,      // 4 minutos - AlwaysOn é relativamente estvel
            'logs': 90000,           // 1.5 minutos - logs so mais dinâmicos
            'monitoring': 120000,    // 2 minutos - monitoramento geral
            'default': 120000        // 2 minutos - padrão para tipos não especificados
        };

        // Configurao do cache
        const CACHE_CONFIG = {
            MAX_SIZE: 50,                    // Máximo de entradas não cache
            CLEANUP_INTERVAL: 300000,        // Limpeza automtica a cada 5 minutos
            ABSOLUTE_MAX_AGE: 600000,        // Idade mxima absoluta: 10 minutos
            ENABLE_STATS: true               // Habilitar estatísticas de cache
        };

        // Estatsticas de cache
        let cacheStats = {
            hits: 0,
            misses: 0,
            evictions: 0,
            lastCleanup: Date.now()
        };

        // Funão háelper para obter TTL de um tipo de aba
        function getCacheTTL(tabType) {
            return CACHE_TTL_BY_TYPE[tabType] || CACHE_TTL_BY_TYPE['default'];
        }

        // Funo para verificar e obter cache
        function getTabCache(tabType, serverId) {
            const cacheKey = `${tabType}_${serverId}`;
            const cached = tabCache.get(cacheKey);
            const now = Date.now();
            const ttl = getCacheTTL(tabType);
            
            if (cached) {
                const age = now - cached.timestamp;
                const cacheAgeSeconds = Math.round(age / 1000);
                const ttlSeconds = Math.round(ttl / 1000);

                // Verificar se cache ainda é válido
                if (age < ttl && age < CACHE_CONFIG.ABSOLUTE_MAX_AGE) {
                    // Cache hit
                    cached.hits = (cached.hits || 0) + 1;
                    cached.lastAccessed = now;
                    if (CACHE_CONFIG.ENABLE_STATS) cacheStats.hits++;

                    debugLog(` Cache HIT para ${tabType} (${serverId}): ${cacheAgeSeconds}s / ${ttlSeconds}s (${cached.hits} hits)`, 'info');
                    return {
                        valid: true,
                        data: cached.data,
                        age: cacheAgeSeconds,
                        ttl: ttlSeconds,
                        hits: cached.hits
                    };
                } else {
                    // Cache expirado
                    debugLog(` Cache EXPIRADO para ${tabType} (${serverId}): ${cacheAgeSeconds}s > ${ttlSeconds}s`, 'info');
                    tabCache.delete(cacheKey);
                }
            }

            // Cache miss
            if (CACHE_CONFIG.ENABLE_STATS) cacheStats.misses++;
            debugLog(` Cache MISS para ${tabType} (${serverId})`, 'info');

            return { valid: false, data: null, age: 0, ttl: 0, hits: 0 };
        }

        // Funo para salvar não cache
        function setTabCache(tabType, serverId, data) {
            const cacheKey = `${tabType}_${serverId}`;
            const now = Date.now();
            const ttl = getCacheTTL(tabType);

            tabCache.set(cacheKey, {
                data: data,
                timestamp: now,
                lastAccessed: now,
                hits: 0,
                tabType: tabType,
                serverId: serverId
            });

            const ttlMinutes = Math.round(ttl / 60000);
            debugLog(`[INFO] Cache SET: ${tabType} (${serverId}) - TTL: ${ttlMinutes}min`, 'info');

            // Verificar se precisa limpar cache por tamanho
            if (tabCache.size > CACHE_CONFIG.MAX_SIZE) {
                optimizeCache();
            }
        }

        // Funo para limpar cache específico
        function clearTabCache(tabType, serverId) {
            const cacheKey = `${tabType}_${serverId}`;
            const deleted = tabCache.delete(cacheKey);
            if (deleted) {
                debugLog(`[INFO] Cache CLEAR: ${tabType} (${serverId})`, 'info');
            }
        }

        // Funo para limpar todo o cache de um servidor
        function clearServerCache(serverId) {
            let cleared = 0;
            for (const [key, value] of tabCache.entries()) {
                if (value.serverId === serverId) {
                    tabCache.delete(key);
                    cleared++;
                }
            }
            if (cleared > 0) {
                debugLog(`[INFO] Cache CLEAR: ${cleared} entrada(s) do servidor ${serverId}`, 'info');
            }
        }

        // Funo para otimizar cache (remover entradas antigas ou menos usadas)
        function optimizeCache() {
            const now = Date.now();
            const entries = Array.from(tabCache.entries());

            // Filtrar entradas expiradas
            let removed = 0;
            for (const [key, value] of entries) {
                const age = now - value.timestamp;
                const ttl = getCacheTTL(value.tabType);

                if (age > ttl || age > CACHE_CONFIG.ABSOLUTE_MAX_AGE) {
                    tabCache.delete(key);
                    removed++;
                }
            }

            // Se ainda estiver acima do limite, remover as menos usadas
            if (tabCache.size > CACHE_CONFIG.MAX_SIZE) {
                const remaining = Array.from(tabCache.entries());
                remaining.sort((a, b) => {
                    // Ordenar por: hits (menor primeiro), depois por lastAccessed (mais antigo primeiro)
                    const hitsA = a[1].hits || 0;
                    const hitsB = b[1].hits || 0;
                    if (hitsA !== hitsB) return hitsA - hitsB;
                    return a[1].lastAccessed - b[1].lastAccessed;
                });

                const toRemove = remaining.slice(0, remaining.length - CACHE_CONFIG.MAX_SIZE);
                toRemove.forEach(([key]) => {
                    tabCache.delete(key);
                    removed++;
                });
            }

            if (removed > 0) {
                if (CACHE_CONFIG.ENABLE_STATS) cacheStats.evictions += removed;
                debugLog(`[INFO] Cache OTIMIZADO: ${removed} entrada(s) removida(s) - Tamanho: ${tabCache.size}`, 'info');
            }
        }

        // Limpeza automtica periódica do cache
        setInterval(() => {
            const before = tabCache.size;
            optimizeCache();
            const after = tabCache.size;
            const removed = before - after;

            cacheStats.lastCleanup = Date.now();

            if (removed > 0) {
                debugLog(`[INFO] Limpeza automtica: ${removed} entrada(s) removida(s)`, 'info');
            }
        }, CACHE_CONFIG.CLEANUP_INTERVAL);
        
        // Search Frequency Tracking
        const SEARCH_FREQUENCY_KEY = 'watcherdb_server_search_frequency';
        
        // ========================================
        // SPLASH SCREEN
        // ========================================
        
        // Funo para esconder splash screen (chamada após carregar tudo)
        function hideSplashScreen() {
            const splash = document.getElementById('splashScreen');
            if (splash) {
                // Adicionar classe hidden para iniciar transio de fade-out
                splash.classList.add('hidden');

                // Remover classe do body para mostrar conteúdo principal
                document.body.classList.remove('splash-active');

                // Remover splash do DOM após transio (500ms)
                setTimeout(() => {
                    splash.remove();
                    debugLog('[INFO] Splash screen removido', 'info');
                }, 500);
            }
        }
        
        function getSearchFrequency() {
            try {
                const stored = localStorage.getItem(SEARCH_FREQUENCY_KEY);
                return stored ? JSON.parse(stored) : {};
            } catch (e) {
                return {};
            }
        }
        
        function saveSearchFrequency(frequency) {
            try {
                localStorage.setItem(SEARCH_FREQUENCY_KEY, JSON.stringify(frequency));
            } catch (e) {
                console.error('Erro ao salvar frequncia de pesquisas:', e);
            }
        }
        
        function incrementSearchCount(serverId) {
            const frequency = getSearchFrequency();
            frequency[serverId] = (frequency[serverId] || 0) + 1;
            saveSearchFrequency(frequency);
            return frequency[serverId];
        }
        
        function sortServersByFrequency(servers) {
            const frequency = getSearchFrequency();
            return servers.sort((a, b) => {
                const countA = frequency[a.server_id] || 0;
                const countB = frequency[b.server_id] || 0;
                if (countA !== countB) {
                    return countB - countA; // Maior frequncia primeiro
                }
                // Se mesma frequncia, ordenar alfabeticamente
                return a.name.localeCompare(b.name);
            });
        }
        
        // ========================================
        // Minimal debug - não on-screen panel
        // ========================================
        function debugLog(message, type = 'info') {
            // Verificar se debug est habilitado (exceto para erros e warnings que sempre aparecem)
            const enableDebug = localStorage.getItem('enableDebugLogs') === 'true';
            if (!enableDebug && (type === 'info' || type === 'success')) {
                return; // No logar info/success se debug estiver desabilitado
            }
            
            // Keep console output only
            if (type === 'error') console.error(message);
            else if (type === 'warn') console.warn(message);
            else console.log(message);
        }

        // Traduz status de Memory Pressure para portugus
        function translateMemoryPressureStatus(status) {
            const translations = {
                'HEALTHY': 'SAUDVEL',
                'WARNING': 'ATENO',
                'CRITICAL': 'CRÍTICO',
                'HIGH': 'ALTO',
                'MODERATE': 'MODERADO',
                'LOW': 'BAIXO',
                'LOW_USAGE': 'USO BAIXO',
                'AWAITING_INIT': 'INICIALIZANDO',
                'NOT_CONFIGURED': 'NO CONFIGURADO',
                'UNKNOWN': 'DESCONHECIDO'
            };
            return translations[status] || status;
        }

        // ========================================
        // INITIALIZATION
        // ========================================
        async function init() {
            debugLog('[INFO] Iniciando Watcher DB...', 'info');

            // Adicionar funão háelper ao console para debug
            window.resetSQLDiagConfig = function() {
                localStorage.removeItem('sqlDiagnosticsConfig');
                console.log(' Configurao do SQL Diagnostics resetada. Recarregue a pgina (F5).');
            };
            console.log('[INFO] Dica: Se alguma query não aparecer, execute: resetSQLDiagConfig() e recarregue a pgina');

            try {
                // Limpar cache de Jobs para garantir que sees apaream recolhidas
                tabCache.forEach((value, key) => {
                    if (key.startsWith('jobs_')) {
                        tabCache.delete(key);
                    }
                });

                // Verificar e atualizar configuração do SQL Diagnostics para incluir log-space
                const currentConfig = getSQLDiagnosticsConfig();
                if (!currentConfig.visibleQueries.includes('log-space')) {
                    debugLog('[INFO] Query log-space não estava nas queries visveis, adicionando...', 'warn');
                    currentConfig.visibleQueries.push('log-space');
                    saveSQLDiagnosticsConfig(currentConfig);
                    debugLog(' Query log-space adicionada só queries visveis', 'success');
                }

                restoreSidebarState(); // Restaurar estado da sidebar
                await loadServers();
                setupEventListeners();
                renderDashboardCards();

                // Aplicar intervalo de refresh dos KPIs salvo
                applyKpiRefreshInterval();

                debugLog(' Watcher DB carregado com sucesso!', 'success');
            } catch (error) {
                debugLog(` Erro ao inicializar: ${error.message}`, 'error');
            } finally {
                // Esconder splash screen após carregar tudo (ou após erro)
                hideSplashScreen();
            }
        }
        
        function setupEventListeners() {
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('input', (e) => {
                const clearBtn = document.getElementById('searchClear');
                if (e.target.value) {
                    clearBtn.classList.add('show');
                } else {
                    clearBtn.classList.remove('show');
                }
                
                debounce(handleSearch, 300)(e);
            });
        }
        
        function clearSearch() {
            const searchInput = document.getElementById('searchInput');
            const clearBtn = document.getElementById('searchClear');
            searchInput.value = '';
            clearBtn.classList.remove('show');
            
            // Aplicar ordenao salva quando limpar busca
            const sortOrder = localStorage.getItem('serverSortOrder') || 'frequency';
            if (sortOrder === 'frequency') {
                filteredServers = sortServersByFrequency([...allServers]);
            } else if (sortOrder === 'alphabetical') {
                filteredServers = [...allServers].sort((a, b) => a.name.localeCompare(b.name));
            } else if (sortOrder === 'environment') {
                filteredServers = [...allServers].sort((a, b) => {
                    const envOrder = { 'production': 1, 'quality': 2, 'development': 3, 'unknown': 4 };
                    const envA = envOrder[a.environment.toLowerCase()] || 99;
                    const envB = envOrder[b.environment.toLowerCase()] || 99;
                    if (envA !== envB) return envA - envB;
                    return a.name.localeCompare(b.name);
                });
            } else {
                filteredServers = [...allServers];
            }
            
            renderServerList();
            updateServerCount();
