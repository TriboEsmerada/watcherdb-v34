                `;
            }
        }

        // ========================================
        // SQL DIAGNOSTICS TAB
        // ========================================
        async function loadSQLDiagnostics() {
            // IMPORTANTE: Garantir que estamos usando o servidor correto
            if (!selectedServer || !selectedServer.server_id) {
                debugLog(` selectedServer inválido ao carregar SQL Diagnostics`, 'error');
                const content = activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea');
                if (content) {
                    content.innerHTML = `
                        <div class="card" style="background: #7f1d1d; border-color: #991b1b;">
                            <h4 style="color: #fca5a5;"><i class="fas fa-exclamation-triangle"></i> Erro</h4>
                            <p style="color: #fecaca;">Servidor não selecionado ou inválido.</p>
                        </div>
                    `;
                }
                return;
            }
            
            // Verificar se não é dashboard-kpis
            if (selectedServer.server_id === 'dashboard-kpis') {
                debugLog(`[INFO] Tentativa de carregar SQL Diagnostics para dashboard-kpis, ignorando`, 'warn');
                return;
            }
            
            const content = activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea');
            if (!content) {
                debugLog(` contentElement não encontrado para SQL Diagnostics`, 'error');
                return;
            }
            
            const serverId = selectedServer.server_id;
            
            debugLog(`[INFO] Carregando SQL Diagnostics...`, 'info');
            debugLog(`[INFO] Server ID: ${serverId}`, 'info');
            debugLog(`[INFO] Server Name: ${selectedServer.name}`, 'info');
            debugLog(`[INFO] Active Tab ID: ${activeTabId}`, 'info');
            
            content.innerHTML = `
                <div class="loading">
                    <div class="spinner"></div>
                    <p style="margin-top: 16px; color: #94a3b8;">Carregando diagnósticos SQL...</p>
                </div>
            `;
            
            try {
                // Carregar databases do servidor
                let databases = [];
                try {
                    const dbRes = await createFetchWithAbort(`/api/queries/databases/${serverId}`);
                    if (dbRes && dbRes.ok) {
                        const dbData = await dbRes.json();
                        databases = dbData.databases || [];
                    }
                } catch (dbErr) {
                    if (dbErr.isAbort) return; // Ignorar abort
                    debugLog(`[INFO] Erro ao carregar databases: ${dbErr.message}`, 'warn');
                }
                
                // Lista de queries padrão
                const standardQueries = [
                    { id: 'blocking', name: 'Bloqueios', endpoint: `/api/queries/blocking/${serverId}`, category: 'standard' },
                    { id: 'deadlocks', name: 'Deadlocks', endpoint: `/api/queries/deadlocks/${serverId}`, category: 'standard' },
                    { id: 'database-io-stats', name: 'Database I/O Stats', endpoint: `/api/queries/database-io-stats/${serverId}`, category: 'standard' },
                    { id: 'slow-queries', name: 'Queries Lentas', endpoint: `/api/queries/slow-queries/${serverId}`, category: 'standard' },
                    { id: 'log-space', name: 'Transaction Log', endpoint: `/api/queries/log-space/${serverId}`, category: 'standard' },
                    { id: 'sql-agent-jobs', name: 'Jobs SQL Agent', endpoint: `/api/queries/sql-agent-jobs/${serverId}`, category: 'standard' },
                    { id: 'sessions', name: 'Sesses Problemticas', endpoint: `/api/queries/sessions/${serverId}`, category: 'standard' },
                    { id: 'index-fragmentation', name: 'Fragmentao de ndices', endpoint: `/api/queries/index-fragmentation/${serverId}`, category: 'standard' },
