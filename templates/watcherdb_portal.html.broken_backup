        // ============================================================================

        /**
         * Carrega alertas preditivos do backend
         */
        // ========================================
        // ALWAYS ON TAB
        // ========================================
        async function loadAlwaysOn() {
            const content = activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea');
            if (!content) return;
            const serverId = selectedServer.server_id;
            
            debugLog(`[INFO] Carregando Always On...`, 'info');
            debugLog(`[INFO] Server ID: ${serverId}`, 'info');
            
            content.innerHTML = createPremiumLoading('Verificando Always On...');
            
            try {
                // Funo auxiliar para fazer fetch com timeout (com tracking para cancelamento)
                const fetchWithTimeout = async (url, timeout = 10000) => {
                    try {
                        const controller = new AbortController();
                        const tabId = activeTabId; // Associar ? aba ativa
                        
                        // Adicionar ao sistema de tracking
                        if (tabId) {
                            if (!tabAbortControllers.has(tabId)) {
                                tabAbortControllers.set(tabId, new Set());
                            }
                            tabAbortControllers.get(tabId).add(controller);
                        }
                        
                        const timeoutId = setTimeout(() => {
                            controller.abort();
                            if (tabId && tabTimeouts.has(tabId)) {
                                tabTimeouts.get(tabId).delete(timeoutId);
                            }
                        }, timeout);
                        
                        // Rastrear timeout
                        if (tabId) {
                            if (!tabTimeouts.has(tabId)) {
                                tabTimeouts.set(tabId, new Set());
                            }
                            tabTimeouts.get(tabId).add(timeoutId);
                        }
                        
                        const response = await fetch(url, { signal: controller.signal }).catch(err => {
                            clearTimeout(timeoutId);
                            if (tabId && tabTimeouts.has(tabId)) {
                                tabTimeouts.get(tabId).delete(timeoutId);
                            }
                            if (err.name === 'AbortError') {
                                debugLog(`[INFO] Timeout ou cancelamento ao buscar ${url} (${timeout}ms)`, 'warn');
                                throw new Error(`Timeout após ${timeout}ms`);
                            }
                            debugLog(`[INFO] Erro de rede ao buscar ${url}: ${err.message}`, 'warn');
                            throw err;
                        }).finally(() => {
                            clearTimeout(timeoutId);
                            if (tabId && tabTimeouts.has(tabId)) {
                                tabTimeouts.get(tabId).delete(timeoutId);
                            }
                            // Remover controller do tracking
                            if (tabId && tabAbortControllers.has(tabId)) {
                                tabAbortControllers.get(tabId).delete(controller);
                                if (tabAbortControllers.get(tabId).size === 0) {
                                    tabAbortControllers.delete(tabId);
                                }
                            }
                        });
                        
                        return response;
                    } catch (err) {
                        debugLog(`[INFO] Erro ao buscar ${url}: ${err.message}`, 'warn');
                        // Retornar um objeto que simula uma resposta HTTP com erro
                        return {
                            ok: false,
                            status: err.message.includes('Timeout') ? 408 : 0,
                            error: err.message,
                            json: async () => ({ error: err.message })
                        };
                    }
                };
                
                // Converter serverId para formato esperado pelo endpoint
                // serverId pode ser "SQLMDMPRD01_101" ou "SQLMDMPRD01\101" ou "SQLMDMPRD01_I01"
                // O endpoint espera server_name e instance como query param
                // IMPORTANTE: O formato pode ser "SQLMDMPRD01_101" mas a instance real é "I01"
                // Vamos tentar usar o serverId diretamente primeiro, depois tentar parsear
                let serverNameForApi = serverId;
                let instanceParam = '';
                
                // Primeiro, tentar usar o endpoint /overview que aceita server_id diretamente
                // Se isso não funcionar, tentar parsear
                const useOverviewEndpoint = true; // Usar endpoint /overview que aceita server_id
                
                if (!useOverviewEndpoint) {
                    // Método antigo: parsear serverId
                    if (serverId.includes('_')) {
                        // Converter "SQLMDMPRD01_101" para "SQLMDMPRD01" com instance="101"
                        // Ou "SQLMDMPRD01_I01" para "SQLMDMPRD01" com instance="I01"
                        const parts = serverId.split('_');
                        serverNameForApi = parts[0];
                        instanceParam = parts.length > 1 ? parts[1] : '';
                    } else if (serverId.includes('\\')) {
                        // Converter "SQLMDMPRD01\101" para "SQLMDMPRD01" com instance="101"
                        const parts = serverId.split('\\');
                        serverNameForApi = parts[0];
                        instanceParam = parts.length > 1 ? parts[1] : '';
                    }
                }
                
                debugLog(`[INFO] ServerId original: ${serverId}`, 'info');
                debugLog(`[INFO] ServerName para API: ${serverNameForApi}`, 'info');
                debugLog(`[INFO] Instance param: ${instanceParam}`, 'info');
                
                // Construir URL - usar endpoint /overview que aceita server_id diretamente
                // Isso é mais confivel porque não precisa parsear o formato
                let serverUrl = `/api/alwayson/server/${encodeURIComponent(serverId)}/overview`;
                
                // Para eventos, ainda precisamos parsear (endpoint antigo)
                let eventsUrl = `/api/alwayson/events/${encodeURIComponent(serverNameForApi)}?days=30`;
                if (instanceParam) {
                    eventsUrl += `&instance=${encodeURIComponent(instanceParam)}`;
                } else if (serverId.includes('_')) {
                    // Tentar extrair instance do serverId
                    const parts = serverId.split('_');
                    if (parts.length > 1) {
                        eventsUrl += `&instance=${encodeURIComponent(parts[1])}`;
                    }
                }
                
                debugLog(`[INFO] URLs: serverUrl=${serverUrl}, eventsUrl=${eventsUrl}`, 'info');
                
                // ETAPA 1: Validao rápida se é Always On (timeout curto para evitar espera desnecessria)
                debugLog(`[INFO] Etapa 1: Validando se é Always On (timeout curto)...`, 'info');
                content.innerHTML = createPremiumLoading('Verificando Always On...');
                
                let quickValidationRes;
                try {
                    // Timeout curto (3 segundos) para validao rápida - reduzido para evitar travamento
                    quickValidationRes = await fetchWithTimeout(serverUrl, 3000);
                } catch (err) {
                    debugLog(`[INFO] Erro na validao rápida: ${err.message}`, 'warn');
                    // Se timeout, assumir desconhecido e continuar (no bloquear)
                    quickValidationRes = { ok: false, status: 0, error: err.message, json: async () => ({ is_alwayson: null, error: err.message }) };
                }
                
                let quickValidation = { is_alwayson: null }; // null = desconhecido por padrão
                if (quickValidationRes && quickValidationRes.ok) {
                    try {
                        quickValidation = await quickValidationRes.json();
                        debugLog(` Validao rápida: is_alwayson=${quickValidation.is_alwayson}`, 'info');
                    } catch (e) {
                        debugLog(`[INFO] Erro ao parsear validao rápida: ${e.message}`, 'warn');
                        // Se não conseguiu parsear, assumir desconhecido e continuar
                        quickValidation = { is_alwayson: null };
                    }
                } else if (quickValidationRes && quickValidationRes.status === 404) {
                    // 404 significa que não é Always On
                    quickValidation = { is_alwayson: false, not_alwayson: true };
                    debugLog(`[INFO] Validao rápida: 404 - não é Always On`, 'info');
                } else if (quickValidationRes && (quickValidationRes.status === 0 || quickValidationRes.error)) {
                    // Timeout ou erro na validao rápida - pode ser que seja Always On mas est lento
                    // Continuar para tentar carregar dados completos
                    debugLog(`[INFO] Timeout/erro na validao rápida - continuando para carregar dados completos...`, 'info');
                    quickValidation = { is_alwayson: null }; // null = desconhecido, continuar
                } else {
                    // Outro erro HTTP - assumir desconhecido e continuar
                    debugLog(`[INFO] Validao rápida retornou status ${quickValidationRes.status} - continuando...`, 'warn');
                    quickValidation = { is_alwayson: null };
                }
                
                // Se não é Always On (confirmado), mostrar mensagem amigvel e parar
                if (quickValidation.is_alwayson === false || quickValidation.not_alwayson === true) {
                    debugLog(`[INFO] Instância não é Always On - exibindo mensagem informativa`, 'info');
                    const serverName = selectedServer ? selectedServer.name : serverId;
                    content.innerHTML = `
                        <div style="padding: var(--space-lg);">
                            ${createPageTitle('fas fa-sync-alt', 'Always On', serverName, '#64748b')}
                            <div class="card" style="background: linear-gradient(135deg, #1e293b, #0f172a); border-left: 4px solid #64748b; margin-top: 24px;">
                                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px;">
                                    <i class="fas fa-info-circle" style="font-size: 48px; color: #64748b;"></i>
                                    <div>
                                        <h4 style="color: #e2e8f0; margin: 0 0 8px 0;">Instância não configurada como Always On</h4>
                                        <p style="color: #94a3b8; margin: 0; font-size: 14px;">
                                            Esta instância não possui Always On Availability Groups configurado.
                                        </p>
                                    </div>
                                </div>
                                <div style="background: #1e293b; border-radius: 8px; padding: 16px; margin-top: 16px;">
                                    <p style="color: #cbd5e1; font-size: 13px; line-height: 1.6; margin: 0;">
                                        <strong style="color: #e2e8f0;">Sobre Always On:</strong><br>
                                        Always On Availability Groups é um recurso de alta disponibilidade e recuperao de desastre do SQL Server. 
                                        Se voc esperava ver informações de Always On aqui, verifique se:
                                    </p>
                                    <ul style="color: #cbd5e1; font-size: 13px; line-height: 1.8; margin: 12px 0 0 20px; padding: 0;">
                                        <li>A instância est configurada corretamente não arquivo <code style="background: #0f172a; padding: 2px 6px; border-radius: 4px; color: #60a5fa;">alwayson_inventory.json</code></li>
                                        <li>O Always On est habilitado e configurado não SQL Server</li>
                                        <li>O servidor est acessvel e respondendo</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    `;
                    return;
                }
                
                // Se chegou aqui, é Always On ou desconhecido - carregar dados completos
                // Mas se a validao rápida demorou muito, pular direto para carregar dados completos
                debugLog(` Validao:  Always On ou desconhecido - carregando dados completos...`, 'info');
                content.innerHTML = createPremiumLoading('Carregando dados do Always On...');
                
                // Verificar cache primeiro (usando sistema genérico)
                const cacheResult = getTabCache('always-on', serverId);
                let useCache = false;
                let overview = { success: false, total_ags: 0, ags: [] };
                let serverStatus = { success: false };
                let eventsPayload = { total_events: 0, events: [], patterns: [] };
                
                if (cacheResult.valid) {
                    const cached = cacheResult.data;
                    overview = cached.overview;
                    serverStatus = cached.serverStatus;
                    eventsPayload = cached.eventsPayload;
                    
                    // Debug: verificar se cache tem campo status
                    const cacheHasStatus = !!(serverStatus && serverStatus.status);
                    console.log('[AlwaysOn] Cache verificado:', {
                        hasStatus: cacheHasStatus,
                        cacheAge: cacheResult.age,
                        serverStatusKeys: Object.keys(serverStatus || {})
                    });
                    
                    // Se cache não tem campo status (estrutura antiga), invalidar e buscar novamente
                    if (!cacheHasStatus && serverStatus && serverStatus.is_alwayson) {
                        console.log('[AlwaysOn] Cache inválido (sem campo status) - forando nova requisição');
                        useCache = false;
                        // Limpar cache antigo
                        clearTabCache('always-on', serverId);
                    } else {
                        useCache = true;
                    }
                }
                
                // Se não usar cache, fazer requisições paralelas
                if (!useCache) {
                    // Buscar overview geral e status do servidor com timeout
                    // Usar endpoint /overview que aceita server_id diretamente (mais confivel)
                    debugLog(` Iniciando requisições Always On (paralelas)...`, 'info');
                    
                    // PARALELIZAR as 2 requisições principais (removendo overview que trava)
                    // Overview geral foi removido porque tenta conectar a todos os 42 servidores Always On
                    // e est travando a aplicao. No é crítico para exibir informações do servidor específico.
                    const startTime = Date.now();
                    const [serverRes, eventsRes] = await Promise.all([
                        
                        // Requisio 2: Status do servidor (a mais importante - timeout maior para servidores lentos)
