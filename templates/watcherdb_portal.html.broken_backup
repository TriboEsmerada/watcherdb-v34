                    </div>
                    <div class="table-container" style="max-height: calc(90vh - 450px); overflow: auto;">
                        <table>
                            <thead>
                                <tr>
                `;

                // Headers das colunas de viles
                villainColumns.forEach((key, index) => {
                    const headerName = villainColumnNames[key] || key;
                    tempdbHtml += `
                        <th style="cursor: pointer; user-select: none; position: relative; padding-right: 24px; white-space: nowrap;"
                            onclick="sortTableColumn(${index})"
                            title="Clique para ordenar">
                            ${headerName}
