            // Inserir antes do card de informações do servidor
            const statsGrid = contentArea.querySelector('.stats-grid');
            if (statsGrid) {
                statsGrid.insertAdjacentHTML('afterend', alertsHtml);
            } else {
                // Se não encontrar stats-grid, adicionar não final do contentArea
                contentArea.insertAdjacentHTML('beforeend', alertsHtml);
            }
            
            // Funes auxiliares para processar respostas
            const fetchWithTimeout = async (url, timeout = 120000) => {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), timeout);
                try {
                    const response = await fetch(url, { signal: controller.signal });
                    clearTimeout(timeoutId);
                    return response;
                } catch (error) {
                    clearTimeout(timeoutId);
                    if (error.name === 'AbortError') {
                        throw new Error('Timeout ao buscar dados');
                    }
                    throw error;
                }
            };
            
            const processResponse = async (responsePromise, fallback) => {
                try {
                    const response = await responsePromise;
                    if (!response || !response.ok) return fallback;
                    return await response.json();
                } catch (error) {
                    debugLog(`[INFO] Erro ao processar resposta: ${error.message}`, 'warning');
                    return fallback;
