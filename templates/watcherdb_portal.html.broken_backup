                alert('Nenhum servidor selecionado. Selecione um servidor primeiro.');
                return;
            }
            
            // Extrair hostname do servidor selecionado
            const serverId = selectedServer.server_id || selectedServer.name || '';
            const hostname = extractHostname(serverId);
            
            if (!hostname) {
                alert('Não foi possível extrair o hostname do servidor.');
                return;
            }
            
            // Mostrar loading
            const pingButton = document.getElementById('pingButton');
            const originalButtonText = pingButton.innerHTML;
            pingButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Testando...';
            pingButton.disabled = true;
            
            try {
                const pingResult = await pingServer(hostname);
                
                // Mostrar resultado
                const statusText = pingResult.success ? 'ONLINE' : 'OFFLINE';
                const responseTime = pingResult.response_time_ms > 0 ?
                     pingResult.response_time_ms.toFixed(2) + ' ms' :
                     'N/A';

                alert(`
Teste de Conectividade - ${hostname}

Status: ${statusText}
Resultado: ${pingResult.message || 'Sem resposta'}
Tempo de Resposta: ${responseTime}
                `.trim());
                
            } catch (error) {
                alert(`Erro ao testar conexão: ${error.message}`);
            } finally {
                // Restaurar boto
                pingButton.innerHTML = originalButtonText;
                pingButton.disabled = false;
            }
        };
        
