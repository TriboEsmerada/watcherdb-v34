        // Exportar para CSV
        function exportSQLResultsToCSV() {
            const { queryName, results, columns } = window.sqlResultsData;

            if (results.length === 0) {
                alert('Nenhum resultado para exportar');
                return;
            }

            // Usar colunas fornecidas ou extrair do primeiro resultado
            const tableColumns = columns.length > 0 ? columns : Object.keys(results[0]);

            // Criar CSV
            let csv = tableColumns.join(',') + '\n';

            results.forEach(row => {
                const values = tableColumns.map(col => {
                    const value = row[col];
                    if (value === null || value === undefined) return '';
                    // Escapar valores que contenham vrgula ou aspas
                    const strValue = String(value);
                    if (strValue.includes(',') || strValue.includes('"') || strValue.includes('\n')) {
                        return `"${strValue.replace(/"/g, '""')}"`;
                    }
                    return strValue;
                });
                csv += values.join(',') + '\n';
            });

            // Download
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);

            const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, -5);
            const filename = `${queryName.replace(/\s+/g, '_')}_${timestamp}.csv`;

            link.setAttribute('href', url);
            link.setAttribute('download', filename);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            debugLog(` CSV exportado: ${filename}`, 'success');
        }

        // Copiar script SQL (com fallback para navegadores sem navigator.clipboard)
        function copySQLScript() {
            const { sqlScript } = window.sqlResultsData;

            if (!sqlScript) {
                alert('Script SQL não disponível para esta query');
                return;
            }

            const doVisualFeedback = () => {
                try {
                    const btn = event.target.closest('button');
                    if (!btn) return;
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i> Copiado!';
                    btn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';

                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.style.background = '';
                    }, 2000);
                } catch (e) {
                    // Ignorar erros visuais
                }
            };

            const fallbackCopy = () => {
                try {
                    const textarea = document.createElement('textarea');
                    textarea.value = sqlScript;
                    textarea.style.position = 'fixed';
                    textarea.style.opacity = '0';
                    document.body.appendChild(textarea);
                    textarea.focus();
                    textarea.select();

                    const successful = document.execCommand('copy');
                    document.body.removeChild(textarea);

                    if (successful) {
                        debugLog(' Script SQL copiado para clipboard (fallback execCommand)', 'success');
                        doVisualFeedback();
                    } else {
                        throw new Error('document.execCommand("copy") retornou false');
                    }
                } catch (err) {
                    console.error('Erro ao copiar (fallback):', err);
                    alert('Erro ao copiar script SQL');
                }
            };

            try {
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(sqlScript).then(() => {
                        debugLog(' Script SQL copiado para clipboard (navigator.clipboard)', 'success');
                        doVisualFeedback();
                        showToast('Script SQL copiado com sucesso.', 'success');
                    }).catch(err => {
                        console.warn('navigator.clipboard falhou, usando fallback:', err);
                        fallbackCopy();
                    });
                } else {
                    // Ambiente sem navigator.clipboard (ou não seguro): usar fallback
                    fallbackCopy();
                }
            } catch (err) {
                console.warn('Erro inesperado ao copiar, usando fallback:', err);
                fallbackCopy();
            }
        }

