         */
        async function loadPredictiveAlerts(serverId) {
            debugLog(`[INFO] Carregando alertas preditivos para ${serverId}`, 'info');
            
            try {
                const apiUrl = `/api/monitoring/space/server/${serverId}/predictive-alerts`;
                debugLog(`[INFO] API: ${apiUrl}`, 'info');
                
                const response = await createFetchWithAbort(apiUrl);
                const data = await response.json();
                
                if (!data.success) {
                    throw new Error(data.error || 'Erro ao buscar alertas');
                }
                
                debugLog(` ${data.total_alerts} alertas preditivos carregados`, 'success');
                debugLog(`[INFO] Health Score: ${data.predictive_health_score}%`, 'info');
                
                return data;
                
            } catch (error) {
                debugLog(` Erro nos alertas preditivos: ${error.message}`, 'error');
                throw error;
            }
        }

        /**
         * Renderiza painel de alertas preditivos na aba Overview
         * Chame esta funo dentro de renderOverview()
         */
        async function renderPredictiveAlertsPanel(serverId) {
            // Só renderizar se estiver na aba Overview
            if (activeTabId) {
                const tab = openTabs.get(activeTabId);
                if (tab && tab.tabType !== 'overview') {
                    debugLog('[INFO] Alertas preditivos só so exibidos na aba Overview', 'info');
                    return;
                }
            }
            
            // Usar o contentElement da aba ativa se houver, seno usar contentArea
            let contentArea = null;
            if (activeTabId) {
                const tab = openTabs.get(activeTabId);
                if (tab && tab.contentElement) {
                    contentArea = tab.contentElement;
                }
            }
            
            // Fallback para contentArea global se não háouver aba ativa
            if (!contentArea) {
                contentArea = document.getElementById('contentArea');
            }
            
            // Verificar se contentArea existe
            if (!contentArea) {
                debugLog('[INFO] contentArea não encontrado para renderPredictiveAlertsPanel', 'warning');
                return;
            }
            
            // Verificar se já existe um painel de alertas preditivos (evitar duplicação)
            if (contentArea.querySelector('#predictiveAlertsPanel')) {
                debugLog('[INFO] Painel de alertas preditivos já existe, pulando renderização', 'info');
                return;
            }
            
            const alertsHtml = `
                <div id="predictiveAlertsPanel" class="card" style="border-left: 4px solid #8b5cf6; margin-bottom: 16px; position: relative;">
                    <h4 style="color: #a78bfa; position: relative; padding-right: 100px;">
