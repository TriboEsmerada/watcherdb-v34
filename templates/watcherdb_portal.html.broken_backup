        async function openTempDBDiagnostics(serverId) {
            debugLog(`[INFO] Abrindo TempDB Diagnostics para ${serverId}`, 'info');

            try {
                // Endpoint da query de TempDB
                const endpoint = `/api/queries/tempdb/${serverId}`;
                const queryName = 'Monitoramento TempDB';

                // Chamar a funo loadQueryDiagnostic diretamente
                await loadQueryDiagnostic('tempdb', endpoint, queryName, false, false, '');

                debugLog(` TempDB Diagnostics carregado com sucesso`, 'success');

            } catch (error) {
                debugLog(` Erro ao carregar TempDB Diagnostics: ${error.message}`, 'error');
                alert(`Erro ao carregar diagnóstico do TempDB: ${error.message}`);
            }
        }

        // ========================================
        // DIAGNSTICO INTELIGENTE DE VILO TEMPDB
        // Analisa query, correlaciona com estatísticas, ndices e fragmentao
        // ========================================
        async function showTempDBDiagnosisModal(serverId, sessionId) {
            debugLog(`[INFO] Iniciando diagnóstico TempDB para session ${sessionId} em ${serverId}`, 'info');

            // Criar ou obter modal
            let modal = document.getElementById('tempdbDiagnosisModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'tempdbDiagnosisModal';
                modal.className = 'modal';
                modal.style.zIndex = '10002';
                document.body.appendChild(modal);

                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });
            }

            // Mostrar loading
            modal.innerHTML = `
                <div class="modal-content" style="max-width: 1000px; max-height: 90vh;">
                    <div class="modal-header" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(15, 23, 42, 0.95) 100%); border-bottom: 2px solid #8b5cf6;">
                        <div>
                            <h2 style="font-size: 18px; margin: 0; color: #8b5cf6;">
                                <i class="fas fa-stethoscope" style="margin-right: 8px;"></i>
                                Diagnóstico TempDB - Sesso ${sessionId}
                            </h2>
                            <p style="font-size: 12px; margin-top: 4px; color: #94a3b8;">
                                Servidor: <span style="color: #e2e8f0;">${serverId}</span>
                            </p>
                        </div>
                        <button class="close-modal-btn" onclick="document.getElementById('tempdbDiagnosisModal').style.display='none'">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body" style="padding: 24px; text-align: center;">
                        <div style="padding: 40px;">
                            <i class="fas fa-spinner fa-spin" style="font-size: 48px; color: #8b5cf6; margin-bottom: 16px;"></i>
                            <p style="color: #94a3b8; font-size: 14px;">Analisando sessão e correlacionando dados...</p>
                            <p style="color: #64748b; font-size: 12px; margin-top: 8px;">
                                Verificando estatísticas, ndices faltantes e fragmentao...
                            </p>
                        </div>
                    </div>
                </div>
            `;
            modal.style.display = 'block';

            try {
                const endpoint = `/api/queries/tempdb-diagnose/${serverId}/${sessionId}`;
                debugLog(`[INFO] Chamando ${endpoint}`, 'info');

                const response = await fetch(endpoint);
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status} ${response.statusText}`);
                }

                const data = await response.json();
                debugLog(` Diagnóstico recebido: ${JSON.stringify(data).substring(0, 200)}...`, 'success');

                // Renderizar resultado
                renderTempDBDiagnosisResult(modal, data, serverId, sessionId);

            } catch (error) {
                debugLog(` Erro não diagnóstico TempDB: ${error.message}`, 'error');
                modal.innerHTML = `
                    <div class="modal-content" style="max-width: 600px;">
                        <div class="modal-header" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(15, 23, 42, 0.95) 100%); border-bottom: 2px solid #ef4444;">
