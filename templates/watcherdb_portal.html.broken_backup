        // Renderizar tabela de logs com filtros aplicados
        function renderServiceLogsTable() {
            const modalBody = document.getElementById('serviceLogsModalBody');
            const logs = currentServiceLogsData;
            if (!logs || logs.length === 0) return;

            // Contar logs por nivel (totais)
            const errorCount = logs.filter(l => l.Level === 'Error' || l.Level === 'Critical').length;
            const warningCount = logs.filter(l => l.Level === 'Warning').length;
            const infoCount = logs.filter(l => l.Level === 'Information' || !l.Level).length;

            // Contar logs por fonte (totais)
            const sqlErrorLogs = logs.filter(l => l.SourceType === 'SQLErrorLog').length;
            const defaultTraceLogs = logs.filter(l => l.SourceType === 'DefaultTrace').length;
            const eventViewerLogs = logs.filter(l => l.SourceType === 'EventLog' || l.SourceType === 'WinEvent' || !l.SourceType).length;

            // Aplicar filtros
            let filteredLogs = logs;
            if (serviceLogsFilter.level) {
                if (serviceLogsFilter.level === 'error') {
                    filteredLogs = filteredLogs.filter(l => l.Level === 'Error' || l.Level === 'Critical');
                } else if (serviceLogsFilter.level === 'warning') {
                    filteredLogs = filteredLogs.filter(l => l.Level === 'Warning');
                } else if (serviceLogsFilter.level === 'info') {
                    filteredLogs = filteredLogs.filter(l => l.Level === 'Information' || !l.Level);
                }
            }
            if (serviceLogsFilter.source) {
                if (serviceLogsFilter.source === 'SQLErrorLog') {
                    filteredLogs = filteredLogs.filter(l => l.SourceType === 'SQLErrorLog');
