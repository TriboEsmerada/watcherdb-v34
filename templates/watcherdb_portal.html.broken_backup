        // Maximizar/Restaurar modal
        function toggleModalMaximize() {
            const modal = document.getElementById('sqlResultsModal');
            const modalContent = document.querySelector('.sql-results-modal-content');
            const icon = document.getElementById('sqlModalMaximizeIcon');

            // Se modal estiver minimizada, restaurar ao invés de maximizar
            if (modal.classList.contains('minimized')) {
                modal.classList.remove('minimized');
                return;
            }

            if (modalContent.classList.contains('maximized')) {
                // Restaurar tamanho normal
                modalContent.classList.remove('maximized');
                icon.classList.remove('fa-compress');
                icon.classList.add('fa-expand');
            } else {
                // Maximizar
                modalContent.classList.add('maximized');
                icon.classList.remove('fa-expand');
                icon.classList.add('fa-compress');
            }
        }

        // Minimizar/Restaurar modal
        function minimizeModal() {
            const modal = document.getElementById('sqlResultsModal');
            const isMinimized = modal.classList.contains('minimized');

            if (isMinimized) {
                // Restaurar
                modal.classList.remove('minimized');
            } else {
                // Minimizar
                modal.classList.add('minimized');

                // Adicionar evento de clique não háeader para restaurar
                const header = document.querySelector('.sql-results-modal-header');
                const clickHandler = function(e) {
                    // No restaurar se clicar nos botes
                    if (!e.target.closest('button')) {
                        modal.classList.remove('minimized');
                        header.removeEventListener('click', clickHandler);
                    }
                };
                header.addEventListener('click', clickHandler);
            }
        }

