                                        ${isCurrentReplica ? ' <span style="background: #3b82f6; color: white; padding: 2px 6px; border-radius: 4px; font-size: 11px; margin-left: 8px;">ATUAL</span>' : ''}
                                        <span style="color: #64748b; font-size: 12px; font-weight: normal; margin-left: 8px;">(${replicaDbs.length} bases)</span>
                                        ${hasCriticalProblems ? ' <span style="background: #ef4444; color: white; padding: 2px 6px; border-radius: 4px; font-size: 11px; margin-left: 8px;">[INFO] CRÍTICO</span>' : ''}
                                        ${hasWarningProblems && !hasCriticalProblems ? ' <span style="background: #f59e0b; color: white; padding: 2px 6px; border-radius: 4px; font-size: 11px; margin-left: 8px;">[INFO] AVISO</span>' : ''}
                                        <i class="fas fa-chevron-down" style="float: right; font-size: 14px;"></i>
                                    </h4>
                                    <div class="section-content" style="margin-top: 16px; display: none;">
                                        <div style="max-height: 400px; overflow-y: auto; overflow-x: auto;">
                                            <table style="width: 100%; border-collapse: collapse; color: #e5e7eb;">
                                                <thead>
                                                    <tr style="background: #0f172a; text-align: left; position: sticky; top: 0; z-index: 10;">
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">Base</th>
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">Sync State</th>
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">Health</th>
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">DB State</th>
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">Suspensa</th>
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">Log Send Queue</th>
                                                        <th style="padding: 12px; border-bottom: 2px solid ${borderColor}; color: ${borderColor};">Redo Queue</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    ${replicaDbs.map(d => {
                                                        // Determinar se a base tem problemas críticos ou de aviso
                                                        const dbHasCritical = d.synchronization_health === 'NOT_HEALTHY' || 
                                                            (d.database_state && d.database_state !== 'ONLINE') || 
                                                            d.is_suspended === true;
                                                        
                                                        const dbHasWarning = d.synchronization_health === 'PARTIALLY_HEALTHY' ||
                                                            (d.log_send_queue_size && d.log_send_queue_size !== 'N/A' && !isNaN(parseFloat(d.log_send_queue_size)) && parseFloat(d.log_send_queue_size) > 1000) ||
                                                            (d.redo_queue_size && d.redo_queue_size !== 'N/A' && !isNaN(parseFloat(d.redo_queue_size)) && parseFloat(d.redo_queue_size) > 1000);
                                                        
                                                        const rowBgColor = dbHasCritical ? 'rgba(239, 68, 68, 0.1)' : 
                                                                         dbHasWarning ? 'rgba(245, 158, 11, 0.1)' : 
                                                                         'transparent';
                                                        
                                                        const healthColor = d.synchronization_health === 'HEALTHY' ? '#10b981' : 
                                                                          d.synchronization_health === 'PARTIALLY_HEALTHY' ? '#f59e0b' : '#ef4444';
                                                        
                                                        return `
                                                        <tr style="background: ${rowBgColor}; border-bottom: 1px solid #334155;">
                                                            <td style="padding: 12px;"><strong>${d.database_name}</strong></td>
