        // Funo para inicializar CodeMirror
        function initializeCodeMirror(textareaId) {
            const textarea = document.getElementById(textareaId);
            if (!textarea) return;
            
            // Se já existe um editor, não criar outro
            if (codeMirrorEditors.has(textareaId)) {
                return;
            }
            
            const editor = CodeMirror.fromTextArea(textarea, {
                mode: 'text/x-sql',
                theme: 'monokai',
                lineNumbers: true,
                indentWithTabs: true,
                smartIndent: true,
                lineWrapping: true,
                matchBrackets: true,
                autofocus: false,
                readOnly: false
            });
            
            codeMirrorEditors.set(textareaId, editor);
            
            // Atualizar textarea quando editor mudar
            editor.on('change', function() {
                editor.save();
            });
        }
        
