                    </span>
                </div>

                <div style="background: var(--color-bg-tertiary); border-radius: 4px; height: 8px; overflow: hidden; margin-bottom: 12px;">
                    <div style="background: ${levelColor}; height: 100%; width: ${score.score}%; transition: width 0.3s;"></div>
