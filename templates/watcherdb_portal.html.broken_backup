                                    <span style="background: #334155; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-weight: bold;">
                                        ${alert.total_datafiles}
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span style="background: ${limitColor}20; color: ${limitColor}; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-weight: bold;" 
                                          title="${alert.datafiles_at_limit} de ${alert.total_datafiles} files (${filesAtLimitPercent}%)">
                                        ${alert.datafiles_at_limit}
                                    </span>
                                </td>
                                <td style="text-align: right; font-family: monospace;">
                                    ${alert.total_size_gb.toFixed(1)} GB
                                </td>
                                <td style="text-align: right; font-family: monospace;">
                                    ${alert.total_maxsize_gb < 999999 ? alert.total_maxsize_gb.toFixed(1) + ' GB' : 'UNLIM'}
                                </td>
                                <td style="text-align: right; font-family: monospace; font-weight: bold; color: ${alert.available_growth_gb < 50 ? '#ef4444' : '#10b981'};">
                                    ${alert.available_growth_gb < 999999 ? alert.available_growth_gb.toFixed(1) + ' GB' : 'UNLIM'}
                                </td>
                                <td style="text-align: right; font-family: monospace; font-weight: bold; color: ${sev.color};">
                                    ${alert.current_usage_percent.toFixed(1)}%
