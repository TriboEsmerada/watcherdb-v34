                }
                
                debugLog(`[INFO] CPU Percent calculado: ${cpuPercent}`, cpuPercent !== null ? 'success' : 'warning');
                debugLog(`[INFO] Memory Percent calculado: ${memoryPercent}`, memoryPercent !== null ? 'success' : 'warning');
                debugLog(`[INFO] Space Score: ${spaceScore}`, spaceScore !== null ? 'success' : 'warning');
                
                // Indicador de cache
                const cacheIndicator = useCache ? `
                    <div style="background: #1e3a8a; border: 1px solid #3b82f6; border-radius: 6px; padding: 8px 12px; margin-bottom: 16px; color: #93c5fd; font-size: 12px;">
