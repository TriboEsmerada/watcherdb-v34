                debugLog(`[INFO] Space Score: ${spaceScore} (tipo: ${typeof spaceScore}), Status: ${spaceStatus}`, spaceScore !== null ? 'success' : 'warning');
                
                // Log para debug - verificar se CPU est sendo processado
