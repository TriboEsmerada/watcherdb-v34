                    { key: 'high', label: '[INFO] ALTO', color: '#f97316' },
                    { key: 'medium', label: '[INFO] MDIO', color: '#eab308' },
                    { key: 'low', label: '[INFO] BAIXO', color: '#22c55e' }
                ];
                
                severities.forEach(sev => {
                    const alerts = data.alerts_by_severity[sev.key];
                    if (alerts.length === 0) return;
                    
                    html += `
                        <div class="card" style="border-left: 4px solid ${sev.color}; margin-bottom: 16px;">
                            <h4 style="color: ${sev.color}; margin-bottom: 16px;">
                                ${sev.label} (${alerts.length} filegroups)
