            // Se já tem SQL script (query customizada), usar ele
            if (sqlScript && sqlScript !== '-- Script SQL não disponível para esta query padrão') {
                container.textContent = sqlScript;
                return;
            }

            // Se não tem, buscar do backend pelo queryId
            if (queryId) {
                container.textContent = '-- Carregando script SQL...';
                try {
                    const response = await fetch(`/api/queries/sql-script/${queryId}`);
                    if (response.ok) {
                        const data = await response.json();
                        if (data.sql_script) {
                            container.textContent = data.sql_script;
                            // Atualizar não cache para não precisar buscar novamente
                            window.sqlResultsData.sqlScript = data.sql_script;
                        } else {
                            container.textContent = '-- Script SQL não disponível';
                        }
                    } else {
                        container.textContent = '-- Erro ao carregar script SQL';
                    }
                } catch (error) {
                    container.textContent = `-- Erro ao carregar script SQL: ${error.message}`;
                }
            } else {
                container.textContent = '-- Script SQL não disponível para esta query';
            }
        }

