                    row.style.background = 'transparent';
                    row.style.border = 'none';
                    row.style.opacity = '0.4';
                    row.classList.remove('active');
                }
            });

            // Mostrar info do filtro
            const filterInfo = document.getElementById('envFilterInfo');
            const filterText = document.getElementById('envFilterText');
            if (filterInfo && filterText) {
                filterInfo.style.display = 'inline-flex';
                filterInfo.style.alignItems = 'center';
                filterText.textContent = `Filtrando: ${env}`;
            }

            // Funo auxiliar para verificar se um item corresponde ao ambiente
            function matchesEnvironment(item, targetEnv) {
                // 1. Verificar badge de ambiente
                const envBadge = item.querySelector('span[style*="background"]');
                if (envBadge) {
                    const badgeText = envBadge.textContent.trim().toUpperCase();
                    if (targetEnv === 'PRD' && (badgeText === 'PRD' || badgeText === 'PROD')) return true;
                    if (targetEnv === 'QLT' && (badgeText === 'QLT' || badgeText === 'QUAL')) return true;
                    if (targetEnv === 'TST' && (badgeText === 'TST' || badgeText === 'TEST' || badgeText === 'DEV')) return true;
                    if (targetEnv === 'Undefined' && badgeText === 'UNDEFINED') return true;
                }

                // 2. Verificar nome da instância
                const instanceNameEl = item.querySelector('.instance-name');
                if (instanceNameEl) {
                    const instanceName = instanceNameEl.textContent.trim().toUpperCase();
                    if (targetEnv === 'PRD' && (instanceName.includes('PRD') || instanceName.includes('PROD'))) return true;
                    if (targetEnv === 'QLT' && (instanceName.includes('QLT') || instanceName.includes('QUAL'))) return true;
                    if (targetEnv === 'TST' && (instanceName.includes('TST') || instanceName.includes('TEST') || instanceName.includes('DEV'))) return true;
                }

                // 3. Verificar data-attribute do item
                const dataEnv = item.dataset.env;
                if (dataEnv) {
                    const envUpper = dataEnv.toUpperCase();
                    if (targetEnv === 'PRD' && (envUpper === 'PRD' || envUpper === 'PROD')) return true;
                    if (targetEnv === 'QLT' && (envUpper === 'QLT' || envUpper === 'QUAL')) return true;
                    if (targetEnv === 'TST' && (envUpper === 'TST' || envUpper === 'TEST' || envUpper === 'DEV')) return true;
                    if (targetEnv === 'Undefined' && envUpper === 'UNDEFINED') return true;
                }

                // 4. Se é Undefined e não encontrou nenhum match específico
                if (targetEnv === 'Undefined') {
                    const instanceName = (item.querySelector('.instance-name').textContent || '').toUpperCase();
                    const hasKnownEnv = instanceName.includes('PRD') || instanceName.includes('PROD') ||
                                       instanceName.includes('QLT') || instanceName.includes('QUAL') ||
                                       instanceName.includes('TST') || instanceName.includes('TEST') || instanceName.includes('DEV');
                    return !hasKnownEnv;
                }

                return false;
            }

            // Filtrar itens da lista
            let visibleCount = 0;
            let totalCount = 0;
            document.querySelectorAll('.instance-item').forEach(item => {
                totalCount++;
                const matches = matchesEnvironment(item, env);
                item.style.display = matches ? 'block' : 'none';
                if (matches) visibleCount++;
