const ChaosDetection = {
    async load(timeWindow = 60) {
        this.showLoading();
        try {
            const [chaosResponse, alertsResponse] = await Promise.all([
                fetch(`${INTELLIGENCE_API_BASE}/chaos-detection/time_window_minutes=${timeWindow}`),
                fetch(`${INTELLIGENCE_API_BASE}/chaos-detection/alerts/urgent`)
            ]);

            if (!chaosResponse.ok) throw new Error('Erro ao carregar chaos detection');

            const chaosData = await chaosResponse.json();
            const alertsData = await alertsResponse.json();

            this.render({ ...chaosData, alerts: alertsData });
        } catch (error) {
            console.error('ChaosDetection Error:', error);
            this.showError(error.message);
        }
    },

    showLoading() {
        const container = document.getElementById('chaos-detection-content');
        if (container) {
            container.innerHTML = `
                <div class="loading-state">
                    <i class="fas fa-spinner fa-spin"></i>
                    <span>Detectando padrãoes de anomalias...</span>
                </div>
            `;
        }
    },

    showError(message) {
        const container = document.getElementById('chaos-detection-content');
        if (container) {
            container.innerHTML = `
                <div class="alert-card critical" style="margin: 20px;">
                    <i class="fas fa-exclamation-circle"></i>
                    <div>
                        <strong>Erro ao carregar dados</strong>
                        <p>${message}</p>
                        <p style="font-size: 0.85em; opacity: 0.8;">Verifique se o WatcherDB Intelligence esta rodando na porta 8001</p>
                    </div>
                </div>
            `;
        }
    },

    render(data) {
        const container = document.getElementById('chaos-detection-content');
        if (!container) return;

        const groups = data.correlated_groups || [];
        const cascades = data.cascade_analyses || [];
        const infraCorrelations = data.infrastructure_correlations || [];
        const alerts = data.alerts || {};

        // Count patterns by type
        const patternCounts = { CASCADE: 0, SIMULTANEOUS: 0, PERIODIC: 0, ISOLATED: 0, BLAST_RADIUS: 0 };
        groups.forEach(g => { if (patternCounts[g.pattern_type] !== undefined) patternCounts[g.pattern_type]++; });

        container.innerHTML = `
            <div style="padding: 20px;">
                <!-- Summary Cards -->
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
                    <div class="kpi-card" style="text-align: center;">
                        <div class="kpi-value" style="color: var(--color-info);">${data.total_events_analyzed || 0}</div>
                        <div class="kpi-label">Eventos Analisados</div>
                    </div>
                    <div class="kpi-card" style="text-align: center;">
                        <div class="kpi-value" style="color: ${data.total_correlations_found > 0 ? 'var(--color-warning)' : 'var(--color-success)'};">${data.total_correlations_found || 0}</div>
                        <div class="kpi-label">Correlacoes</div>
                    </div>
                    <div class="kpi-card" style="text-align: center;">
                        <div class="kpi-value" style="color: ${cascades.length > 0 ? 'var(--color-danger)' : 'var(--color-success)'};">${cascades.length}</div>
                        <div class="kpi-label">Cascatas</div>
                    </div>
                    <div class="kpi-card" style="text-align: center;">
                        <div class="kpi-value" style="color: ${infraCorrelations.length > 0 ? 'var(--color-warning)' : 'var(--color-success)'};">${infraCorrelations.length}</div>
                        <div class="kpi-label">Prob. Infra</div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <!-- Patterns Detected -->
                    <div class="card" style="padding: 16px;">
                        <h3 style="margin: 0 0 16px 0;"><i class="fas fa-project-diagram"></i> Padroes Detectados</h3>
                        ${this.renderPatternItem('CASCADE', 'fa-stream', 'Cascata', 'Problemas propagando entre servidores', patternCounts.CASCADE)}
                        ${this.renderPatternItem('SIMULTANEOUS', 'fa-bolt', 'Simultaneo', 'Multiplos servidores ao mesmo tempo', patternCounts.SIMULTANEOUS)}
                        ${this.renderPatternItem('PERIODIC', 'fa-clock', 'Periodico', 'Padroes recorrentes em horarios fixos', patternCounts.PERIODIC)}
                    </div>

                    <!-- Urgent Alerts -->
                    <div class="card" style="padding: 16px;">
                        <h3 style="margin: 0 0 16px 0; ${alerts.requires_immediate_attention ? 'color: var(--color-danger);' : ''}">
                            <i class="fas fa-exclamation-triangle"></i> Alertas Urgentes
                        </h3>
                        ${alerts.requires_immediate_attention ? `
                            ${(alerts.priority_actions || []).map(action => `
                                <div class="alert-card critical" style="margin-bottom: 12px;">
                                    <i class="fas fa-bolt"></i>
                                    <div>
                                        <strong>Acao Necessaria</strong>
                                        <p style="margin: 4px 0 0 0;">${action}</p>
                                    </div>
                                </div>
                            `).join('')}
                            ${alerts.most_affected_instance ? `
                                <div class="alert-card warning" style="margin-bottom: 12px;">
                                    <i class="fas fa-server"></i>
                                    <div>
                                        <strong>Instancia Mais Afetada</strong>
                                        <p style="margin: 4px 0 0 0;">${alerts.most_affected_instance}</p>
                                    </div>
                                </div>
                            ` : ''}
                        ` : `
                            <div class="alert-card success">
                                <i class="fas fa-check-circle"></i>
                                <span>Nenhum alerta urgente não momento</span>
                            </div>
                        `}
                    </div>
                </div>

                <!-- Timeline -->
                ${this.renderTimeline(data)}
            </div>
        `;
    },

    renderPatternItem(type, icon, title, desc, count) {
        const hasEvents = count > 0;
        const color = hasEvents ? 'var(--color-warning)' : 'var(--color-text-secondary)';
        return `
            <div style="display: flex; align-items: center; padding: 12px; background: ${hasEvents ? 'rgba(255,152,0,0.1)' : 'var(--color-bg-tertiary)'}; border-radius: 8px; margin-bottom: 8px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: ${hasEvents ? 'var(--color-warning)' : 'var(--color-bg-elevated)'}; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                    <i class="fas ${icon}" style="color: ${hasEvents ? 'white' : 'var(--color-text-secondary)'};"></i>
                </div>
                <div style="flex: 1;">
                    <div style="font-weight: bold; color: ${color};">${title}</div>
                    <div style="font-size: 0.85em; color: var(--color-text-secondary);">${desc}</div>
                </div>
                <div style="font-size: 1.5em; font-weight: bold; color: ${color};">${count}</div>
            </div>
        `;
    },

    renderTimeline(data) {
        const events = [];
        (data.correlated_groups || []).forEach(group => {
            (group.events || []).forEach(event => {
                events.push({ ...event, group_id: group.group_id, pattern_type: group.pattern_type });
            });
        });
        events.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

        if (events.length === 0) {
            return `
                <div class="card" style="padding: 16px; margin-top: 20px;">
                    <h3 style="margin: 0 0 16px 0;"><i class="fas fa-history"></i> Timeline</h3>
                    <div style="text-align: center; padding: 40px; color: var(--color-text-secondary);">
                        <i class="fas fa-check-circle" style="font-size: 2em; margin-bottom: 12px;"></i>
                        <p>Nenhum evento não periodo</p>
                    </div>
                </div>
            `;
        }

        return `
            <div class="card" style="padding: 16px; margin-top: 20px;">
                <h3 style="margin: 0 0 16px 0;"><i class="fas fa-history"></i> Timeline de Eventos</h3>
                <div style="position: relative; padding-left: 20px; border-left: 2px solid var(--color-bg-tertiary);">
                    ${events.slice(0, 10).map(event => {
                        const severity = event.severity.toLowerCase() || 'medium';
                        const severityColor = severity === 'high' ? 'var(--color-danger)' :
                                             severity === 'medium' ? 'var(--color-warning)' : 'var(--color-info)';
                        return `
                            <div style="position: relative; padding: 12px 0 12px 20px; margin-bottom: 8px;">
                                <div style="position: absolute; left: -9px; top: 16px; width: 16px; height: 16px; border-radius: 50%; background: ${severityColor};"></div>
                                <div style="font-size: 0.8em; color: var(--color-text-secondary);">${new Date(event.timestamp).toLocaleString('pt-BR')}</div>
                                <div style="font-weight: bold;">${event.event_type || 'Evento'}</div>
                                <div style="font-size: 0.9em; color: var(--color-text-secondary);">${event.description || ''}</div>
                                <span style="display: inline-block; background: var(--color-bg-tertiary); padding: 2px 8px; border-radius: 4px; font-size: 0.8em; margin-top: 4px;">${event.instance_id}</span>
                            </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
    }
};

