                            <table style="font-size: 11px;">
                                <thead>
                                    <tr>
                                        <th>Database</th>
                                        <th>FileGroup</th>
                                        <th>Tipo</th>
                                        <th style="text-align: center;">Files</th>
                                        <th style="text-align: center;">No Limite</th>
                                        <th style="text-align: right;">Tamanho</th>
                                        <th style="text-align: right;">MAXSIZE</th>
                                        <th style="text-align: right;">Disp. Cresc.</th>
                                        <th style="text-align: right;">Uso Atual</th>
                                        <th style="text-align: right;">Prev. 30d</th>
                                        <th style="text-align: right;">Dias</th>
                                        <th>Recomendao</th>
                                    </tr>
                                </thead>
                                <tbody>
