        // ============================================================================
        function showQueryTextModal(queryText, sessionId) {
            if (!queryText || queryText === 'null' || queryText === 'NULL') {
                showToast('Esta sessão não tem query ativa não momento.', 'warning');
                return;
            }

            // Escapar HTML para evitar XSS
            const escapedText = queryText
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');

            const content = `
                <div style="background: #1e293b; border-radius: 8px; padding: 16px; max-height: 400px; overflow: auto;">
                    <pre style="white-space: pre-wrap; word-break: break-all; color: #e5e7eb; font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; margin: 0; line-height: 1.5;">${escapedText}</pre>
                </div>
                <div style="margin-top: 12px; padding: 8px; background: #0f172a; border-radius: 6px; font-size: 12px; color: #94a3b8;">
                    <i class="fas fa-info-circle" style="margin-right: 6px;"></i>
                    Session ID: <strong style="color: #60a5fa;">${sessionId}</strong> |
                    Clique em "Copiar Query" para copiar o texto completo
                </div>
            `;

            // Armazenar o texto para cópia
            window._tempQueryText = queryText;

            showSelectableModal(
                `Query da Sesso ${sessionId}`,
                content,
                'Copiar Query',
                () => {
                    copyTextToClipboard(window._tempQueryText);
                    showToast('Query copiada com sucesso!', 'success');
                }
            );
        }

