        async function showProblematicInstances(kpiType, title, showAll = false) {
            const modal = document.getElementById('instancesModal');
            const modalTitle = document.getElementById('instancesModalTitle');
            const modalBody = document.getElementById('instancesModalBody');
            
            modalTitle.textContent = title;
            
            // Armazenar o tipo de KPI não modal para usar quando clicar na instância
            modal.dataset.kpiType = kpiType;
            modalBody.innerHTML = createPremiumLoading('Carregando instâncias...');
            modal.classList.add('show');
            
            try {
                // Detectar qual endpoint usar (Intelligence ou Oracle)
                const baseEndpoint = cachedKpiEndpoint || await detectKpiEndpoint();
                const instancesEndpoint = baseEndpoint.replace('/dashboard', `/instances/${kpiType}`);
                
                // Verificar se deve buscar instâncias OK (APENAS para card "Instances OK")
                // NO usar kpiType === 'instance-availability' porque isso também inclui o card "Instances Off"
                const isOkFilter = title === 'Instances OK';
                let url = '';
                if (showAll) {
                    url = `${instancesEndpoint}?all=true`;
                } else if (isOkFilter) {
                    url = `${instancesEndpoint}?ok=true`;
                } else {
                    url = instancesEndpoint;
                }
                debugLog(`[INFO] Modal KPI: kpiType=${kpiType}, title=${title}, isOkFilter=${isOkFilter}, url=${url}`, 'info');
                const response = await fetch(url);
                const result = await response.json();
                
                if (!result.success) {
                    throw new Error(result.error || 'Erro ao carregar instâncias');
                }
                
                const instances = result.instances || [];
                const totalDatabases = result.total_databases || null;
                
                if (instances.length === 0) {
                    const emptyMessage = kpiType === 'db-availability-ok' 
                         'Nenhuma instância OK encontrada.' 
                        : kpiType === 'db-availability'
                         'Nenhuma database com problema encontrada.'
                        : 'Nenhuma instância com problema encontrada.';
                    modalBody.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #94a3b8;">
                            <i class="fas fa-check-circle" style="font-size: 48px; color: #10b981; margin-bottom: 16px;"></i>
                            <p>${emptyMessage}</p>
                        </div>
                    `;
                    return;
                }
                
                // Para db-availability, mostrar databases individuais e total
                let summaryText = '';
                if (kpiType === 'db-availability') {
                    if (showAll) {
                        // Quando all=true, mostrar todas as instâncias (agregadas)
                        summaryText = `Total: <strong style="color: #f1f5f9;">${instances.length}</strong> instância(s)`;
                        // Tentar calcular total de databases se possível
                        let totalDbs = 0;
                        instances.forEach(inst => {
                            const totalCnt = inst.TotalCnt || inst.total_cnt || inst.TOTALCNT || 0;
                            totalDbs += parseInt(totalCnt) || 0;
                        });
                        if (totalDbs > 0) {
                            summaryText += ` | <strong style="color: #f1f5f9;">${totalDbs}</strong> database(s) total`;
                        } else if (totalDatabases !== null) {
                            summaryText += ` | <strong style="color: #f1f5f9;">${totalDatabases}</strong> database(s) total`;
                        }
                    } else {
                        // Quando não é all, mostrar databases com problema
                        summaryText = `Total: <strong style="color: #f1f5f9;">${instances.length}</strong> database(s) com problema`;
                        if (totalDatabases !== null) {
                            summaryText += ` de <strong style="color: #f1f5f9;">${totalDatabases}</strong> database(s) total`;
                        }
                    }
                } else if (kpiType === 'db-availability-ok' || title === 'Instances OK') {
                    summaryText = `Total: <strong style="color: #10b981;">${instances.length}</strong> instância(s) OK`;
                } else {
                    summaryText = `Total: <strong style="color: #f1f5f9;">${instances.length}</strong> instância(s) com problema`;
                }

                // Gerar gráfico de barras por ambiente para TODOS os KPIs
                // O gráfico é gerado automaticamente a partir dos dados das instâncias
                let envChartHtml = '';

                if (instances.length > 0) {
                    // Calcular contagem por ambiente a partir dos dados das instâncias
                    const envData = { PRD: 0, QLT: 0, TST: 0, Undefined: 0 };

                    instances.forEach(inst => {
                        // Tentar obter o ambiente de vrias formas
                        let env = inst.Env || inst.ENV || inst.env || '';

                        // Se não tem campo Env, inferir do nome da instância
                        if (!env || env === '') {
                            const instanceName = (inst.Instance || inst.INSTANCE || inst.instance ||
                                                  inst.ServerInstance || inst.SERVER_INSTANCE || '').toUpperCase();
                            if (instanceName.includes('PRD') || instanceName.includes('PROD')) {
                                env = 'PRD';
                            } else if (instanceName.includes('QLT') || instanceName.includes('QUAL')) {
                                env = 'QLT';
                            } else if (instanceName.includes('TST') || instanceName.includes('TEST') || instanceName.includes('DEV')) {
                                env = 'TST';
                            } else {
                                env = 'Undefined';
                            }
                        }

                        // Normalizar o ambiente
                        if (env === 'PROD') env = 'PRD';
                        else if (env === 'QUAL') env = 'QLT';
                        else if (env === 'TEST' || env === 'DEV') env = 'TST';

                        // Contar
                        if (env === 'PRD') envData.PRD++;
                        else if (env === 'QLT') envData.QLT++;
                        else if (env === 'TST') envData.TST++;
                        else envData.Undefined++;
                    });

                    // Definir título do gráfico baseado não KPI
                    let chartTitle = 'Distribuio por Ambiente';
                    if (title === 'Instances OK') chartTitle = 'Instâncias OK por Ambiente';
                    else if (title === 'Instances Off') chartTitle = 'Instâncias Offline por Ambiente';
                    else if (title.includes('DB Availability')) chartTitle = 'Databases por Ambiente';
                    else if (title.includes('DB Not Availability')) chartTitle = 'Databases com Problema por Ambiente';
                    else if (title.includes('FileGroups')) chartTitle = 'FileGroups por Ambiente';
                    else if (title.includes('Disk')) chartTitle = 'Discos por Ambiente';
                    else if (title.includes('Transaction')) chartTitle = 'Transaction Logs por Ambiente';
                    else if (title.includes('Blocked')) chartTitle = 'Bloqueios por Ambiente';
                    else if (title.includes('Always On')) chartTitle = 'Always On por Ambiente';
                    else if (title.includes('Backup')) chartTitle = 'Backups por Ambiente';
                    else if (title.includes('Processes')) chartTitle = 'Processos por Ambiente';

                    // Remover Undefined se for 0
                    const cleanEnvData = envData.Undefined === 0 ?
                        { PRD: envData.PRD, QLT: envData.QLT, TST: envData.TST } : envData;
                    const envs = Object.entries(cleanEnvData).filter(([k, v]) => v > 0);

                    if (envs.length > 0) {
                        const maxValue = Math.max(...envs.map(([_, v]) => v));
                        const colors = {
                            'PRD': '#ef4444',  // Vermelho para Produo
                            'QLT': '#f59e0b',  // Amarelo para Qualidade
                            'TST': '#22c55e',  // Verde para Teste
                            'Undefined': '#94a3b8'  // Cinza para indefinido
                        };

                        envChartHtml = `
                            <div id="envChartContainer" style="margin-bottom: 20px; padding: 16px; background: rgba(30, 41, 59, 0.5); border-radius: 8px; border: 1px solid rgba(71, 85, 105, 0.3);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <div style="font-size: 14px; font-weight: 600; color: #e2e8f0;">
                                        <i class="fas fa-chart-bar" style="margin-right: 8px; color: #60a5fa;"></i>${chartTitle}
                                    </div>
                                    <div id="envFilterInfo" style="display: none; font-size: 11px; color: #60a5fa;">
                                        <span id="envFilterText"></span>
                                        <button onclick="clearEnvFilter()" style="margin-left: 8px; background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 2px 8px; border-radius: 4px; cursor: pointer; font-size: 10px;">
                                            <i class="fas fa-times"></i> Limpar
                                        </button>
                                    </div>
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    ${envs.map(([env, count]) => `
                                        <div class="env-bar-row" data-env="${env}"
                                             onclick="filterByEnv('${env}')"
                                             style="display: flex; align-items: center; gap: 12px; cursor: pointer; padding: 4px; border-radius: 4px; transition: all 0.2s;"
                                             onmouseover="this.style.background='rgba(59, 130, 246, 0.1)'"
                                             onmouseout="if(!this.classList.contains('active')) this.style.background='transparent'">
                                            <div style="width: 70px; font-weight: 600; color: ${colors[env] || '#94a3b8'}; font-size: 13px;">${env}</div>
                                            <div style="flex: 1; background: rgba(51, 65, 85, 0.5); border-radius: 4px; height: 24px; position: relative; overflow: hidden;">
                                                <div style="width: ${(count / maxValue * 100)}%; height: 100%; background: ${colors[env] || '#60a5fa'}; border-radius: 4px; transition: width 0.5s ease;"></div>
                                            </div>
                                            <div style="width: 60px; text-align: right; font-weight: 600; color: #f1f5f9; font-size: 14px;">${count}</div>
                                        </div>
                                    `).join('')}
                                </div>
                                <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(71, 85, 105, 0.3); display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: #94a3b8; font-size: 12px;">Total</span>
                                    <span style="font-weight: 700; color: #10b981; font-size: 16px;">${envs.reduce((sum, [_, v]) => sum + v, 0)}</span>
                                </div>
                                <div style="margin-top: 8px; text-align: center; font-size: 11px; color: #64748b;">
                                    <i class="fas fa-hand-pointer"></i> Clique em um ambiente para filtrar
                                </div>
                            </div>
                        `;
                    }
                }

                // Adicionar aviso para blocked-sessions e blocked-users sobre dados desatualizados
                // Sempre mostrar aviso para bloqueios, pois os dados do KPI vm do Oracle (agregados)
                const showBlockingWarning = (kpiType === 'blocked-sessions' || kpiType === 'blocked-users');
                
                let html = `
                    ${showBlockingWarning ? `
                    <div style="margin-bottom: 16px; padding: 12px; background: rgba(251, 191, 36, 0.15); border-left: 3px solid #fbbf24; border-radius: 4px;">
                        <div style="display: flex; align-items: start; gap: 8px;">
                            <i class="fas fa-exclamation-triangle" style="color: #fbbf24; font-size: 16px; margin-top: 2px;"></i>
                            <div style="flex: 1;">
                                <div style="color: #fbbf24; font-weight: 600; margin-bottom: 4px; font-size: 13px;">
                                    Dados do KPI podem estar desatualizados
                                </div>
                                <div style="color: #cbd5e1; font-size: 12px; line-height: 1.4;">
                                    O KPI mostra dados agregados do Oracle que podem estar desatualizados. 
                                    Os dados abaixo so consultados em <strong>tempo real</strong> do SQL Server. 
                                    Se não háouver bloqueios ativos, significa que o problema já foi resolvido.
                                </div>
                            </div>
                        </div>
                    </div>
                    ` : ''}
                    ${envChartHtml}
                    <div style="margin-bottom: 16px; color: #94a3b8; font-size: 14px;">
                        ${summaryText}
                    </div>
                    <div class="instances-list">
                `;
                
                instances.forEach((instance, index) => {
                    // Para db-availability, mostrar databases individuais apenas quando NO for all=true
                    if (kpiType === 'db-availability' && !showAll) {
                        // Tentar múltiplas variaes de nome de coluna (case-insensitive)
                        const instanceKeys = Object.keys(instance);
                        const instanceKeysUpper = instanceKeys.map(k => k.toUpperCase());
                        
                        // Buscar Database
                        let dbName = 'N/A';
                        for (const key of ['DATABASE', 'DB_NAME', 'DATABASENAME']) {
                            const idx = instanceKeysUpper.indexOf(key);
                            if (idx !== -1) {
                                dbName = instance[instanceKeys[idx]] || 'N/A';
                                if (dbName && dbName !== 'N/A') break;
                            }
                        }
                        if (dbName === 'N/A') {
                            dbName = instance.Database || instance.database || instance.DATABASE || 'N/A';
                        }
                        
                        // Buscar Instance
                        let instName = 'N/A';
                        for (const key of ['INSTANCE', 'SERVER_INSTANCE', 'SERVERINSTANCE']) {
                            const idx = instanceKeysUpper.indexOf(key);
                            if (idx !== -1) {
                                instName = instance[instanceKeys[idx]] || 'N/A';
                                if (instName && instName !== 'N/A') break;
                            }
                        }
                        if (instName === 'N/A') {
                            instName = instance.Instance || instance.instance || instance.INSTANCE || 'N/A';
                        }
                        
                        // Buscar State (coluna correta da view detalhada)
                        let dbState = null;
                        for (const key of ['STATE', 'DB_STATE', 'DATABASE_STATE', 'STATUS']) {
                            const idx = instanceKeysUpper.indexOf(key);
                            if (idx !== -1) {
                                const value = instance[instanceKeys[idx]];
                                if (value && value !== 'N/A' && value !== null && value !== undefined) {
                                    dbState = value;
                                    break;
                                }
                            }
                        }
                        if (!dbState) {
                            dbState = instance.State || instance.state || instance.STATE || null;
                        }
                        
                        // Buscar Is_Available (coluna correta da view detalhada)
                        let isAvailable = null;
                        for (const key of ['IS_AVAILABLE', 'ISAVAILABLE', 'AVAILABLE']) {
                            const idx = instanceKeysUpper.indexOf(key);
                            if (idx !== -1) {
                                const value = instance[instanceKeys[idx]];
                                if (value !== null && value !== undefined) {
                                    isAvailable = value;
                                    break;
                                }
                            }
                        }
                        if (isAvailable === null) {
                            isAvailable = instance.Is_Available || instance.is_available || instance.IS_AVAILABLE;
                        }
                        
                        // Buscar Problem_Reason da view (classifica o tipo de problema)
                        const problemReason = instance.Problem_Reason || instance.problem_reason || instance.PROBLEM_REASON || null;
                        
                        // Determinar texto do problema - priorizar Problem_Reason se existir
                        let problemsText = '';
                        if (problemReason) {
                            // Problem_Reason da view ja explica o problema
                            problemsText = problemReason;
                            if (dbState && dbState !== 'ONLINE') {
                                problemsText += ` (${dbState})`;
                            }
                        } else {
                            // Fallback: construir texto baseado nos campos
                            const problems = [];
                            if (dbState && dbState !== 'ONLINE' && dbState !== 'N/A') {
                                problems.push(`Estado: ${dbState}`);
                            }
                            if (isAvailable === 0 || isAvailable === false || isAvailable === '0' || isAvailable === 'False') {
                                problems.push('Nao disponivel');
                            }
                            problemsText = problems.length > 0 ? problems.join(', ') : 'Problema desconhecido';
                        }
                        
                        html += `
                            <div class="instance-item" style="margin-bottom: 20px; border-left: 3px solid #ef4444; padding-left: 12px; cursor: pointer; transition: background 0.2s;"
                                 onmouseover="this.style.background='rgba(59, 130, 246, 0.1)'"
                                 onmouseout="this.style.background='transparent'"
                                 onclick="selectInstanceFromModal('${instName.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}', 'db-availability')"
                                 data-instance-name="${instName.replace(/"/g, '&quot;')}" 
                                 data-kpi-type="db-availability">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                    <div style="flex: 1;">
                                        <div class="instance-name" style="color: #60a5fa; font-weight: 600; margin-bottom: 4px;">
                                            <i class="fas fa-database" style="margin-right: 8px;"></i>${dbName}
                                        </div>
                                        <div style="color: #94a3b8; font-size: 12px; margin-bottom: 4px;">
                                            <i class="fas fa-server" style="margin-right: 6px;"></i>${instName}
                                        </div>
                                        <div style="color: #fca5a5; font-size: 12px;">
                                            <i class="fas fa-exclamation-triangle" style="margin-right: 6px;"></i>${problemsText}
                                        </div>
                                    </div>
                                    <div style="color: #94a3b8; font-size: 11px; margin-left: 16px;">
                                        <i class="fas fa-chevron-right"></i> Verificar conectividade
                                    </div>
                                </div>
                            </div>
                        `;
                        return; // Pular para próxima iteração
                    }
                    
                    // Para Always On, priorizar ServerInstance, depois INSTANCE, depois AG_NAME
                    let instanceName = '';
                    if (kpiType === 'always-on') {
                        // Priorizar ServerInstance (mais importante)
                        instanceName = instance.SERVER_INSTANCE || instance.server_instance || 
                                       instance.INSTANCE || instance.instance || 
                                       instance.AG_NAME || instance.ag_name || 
                                       instance.AGNAME || instance.agname ||
                                       'N/A';
                    } else {
                        // Para outros KPIs (incluindo service-status), usar lógica padrão
                        // Tentar múltiplas variaes de nome de coluna (case-insensitive)
                        const instanceKeys = Object.keys(instance);
                        const instanceKeyUpper = instanceKeys.map(k => k.toUpperCase());
                        
                        // Procurar por colunas que podem conter o nome da instância (prioridade)
                        let foundKey = null;
                        const possibleKeys = ['INSTANCE', 'SERVER_INSTANCE', 'SERVERINSTANCE', 'SERVER', 'SERVERNAME', 'HOST', 'HOSTNAME'];
                        
                        for (const key of possibleKeys) {
                            const idx = instanceKeyUpper.indexOf(key);
                            if (idx !== -1) {
                                foundKey = instanceKeys[idx];
                                const value = instance[foundKey];
                                if (value && value !== 'N/A' && value !== '' && value !== null && value !== undefined) {
                                    instanceName = value;
                                    break;
                                }
                            }
                        }
                        
                        // Se não encontrou, tentar todas as chaves do objeto (pode ter nome diferente)
                        if (!instanceName || instanceName === 'N/A') {
                            // Procurar qualquer chave que contenha "instance" ou "server" não nome
                            for (const key of instanceKeys) {
                                const keyUpper = key.toUpperCase();
                                if ((keyUpper.includes('INSTANCE') || keyUpper.includes('SERVER') || keyUpper.includes('HOST')) 
                                    && keyUpper !== 'SERVER_INSTANCE' && keyUpper !== 'SERVERINSTANCE') {
                                    const value = instance[key];
                                    if (value && value !== 'N/A' && value !== '' && value !== null && value !== undefined) {
                                        instanceName = value;
                                        break;
                                    }
                                }
                            }
                        }
                        
                        // Fallback final: tentar variaes case-sensitive diretas
                        if (!instanceName || instanceName === 'N/A') {
                        instanceName = instance.INSTANCE || instance.instance || 
                                           instance.Instance || instance.ServerInstance || instance.server_instance ||
                                           instance.SERVER_INSTANCE || instance.Server || instance.server ||
                                           instance.ServerName || instance.server_name ||
                                           instance.Host || instance.host || instance.HostName || instance.hostname ||
                                       instance.AG_NAME || instance.ag_name || 
                                       instance.AGNAME || instance.agname ||
                                       'N/A';
                        }
                        
                        // Debug: log se ainda não encontrou
                        if (!instanceName || instanceName === 'N/A') {
                            debugLog(`[INFO] Nome da instância não encontrado para KPI ${kpiType}. Chaves disponveis: ${instanceKeys.join(', ')}`, 'warning');
                        }
                    }
                    
                    // Normalizar nome da instância se vier sem separador (ex: SQLHDSPRD214I01 -> SQLHDSPRD214\I01)
                    // Detectar padrão: HOST seguido de I seguido de números (ex: SQLHDSPRD214I01)
                    if (instanceName && !instanceName.includes('\\') && !instanceName.includes('_')) {
                        // Tentar detectar padrão HOSTI## (ex: SQLHDSPRD214I01)
                        const match = instanceName.match(/^(.+)(I\d+)$/i);
                        if (match) {
                            instanceName = `${match[1]}\\${match[2]}`;
                            debugLog(`[INFO] Nome normalizado: ${instance.INSTANCE || instance.instance} -> ${instanceName}`, 'info');
                        }
                    }
                    
                    // Para FileGroup Usage, buscar databases e filegroups específicos com problema
                    if (kpiType === 'filegroup-usage') {
                        // Converter instanceName para server_id (backslash para underscore)
                        const serverId = instanceName.replace(/\\/g, '_');
                        
                        // Escapar o instanceName para uso seguro não onclick
                        const escapedInstanceName = instanceName.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        
                        html += `
                            <div class="instance-item" 
                                 style="margin-bottom: 20px; border-left: 3px solid #ef4444; padding-left: 12px; cursor: pointer; transition: background 0.2s;"
                                 onmouseover="this.style.background='rgba(59, 130, 246, 0.1)'"
                                 onmouseout="this.style.background='transparent'"
