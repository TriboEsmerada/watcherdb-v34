                             onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';"
                             title="Clique para filtrar sessões com idle =30 min">
                            <i class="fas fa-clock" style="color: #ef4444; font-size: 18px;"></i>
                            <div>
                                <div style="font-size: 20px; font-weight: 700; color: #ef4444;">${highIdleCount}</div>
                                <div style="font-size: 10px; color: #fca5a5; text-transform: uppercase; letter-spacing: 0.5px;">Idle Alto</div>
                            </div>
                            <i class="fas fa-filter" style="color: #fca5a5; font-size: 12px; margin-left: 4px;"></i>
                        </div>
