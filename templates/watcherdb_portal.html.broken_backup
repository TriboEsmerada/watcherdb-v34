                const spaceColor = spaceStatusType === 'critical' ? '#ef4444' :
                                   spaceStatusType === 'warning' ? '#f59e0b' :
                                   (spaceScore !== null ? '#10b981' : '#6b7280');
                const spaceStatusText = spaceStatus;

