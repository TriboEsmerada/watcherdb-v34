        async function loadMemoryAnalysis(contentElement = null) {
            // Se contentElement não foi fornecido, tentar obter da aba ativa ou contentArea
            const content = contentElement || (activeTabId ? openTabs.get(activeTabId).contentElement : document.getElementById('contentArea'));
            if (!content) {
                debugLog('[INFO] contentElement não encontrado para loadMemoryAnalysis', 'warning');
                return;
            }
            const serverId = selectedServer.server_id;
            
            debugLog(`[INFO] Carregando Memory Analysis...`, 'info');
            debugLog(`[INFO] Server ID: ${serverId}`, 'info');
            
            content.innerHTML = createPremiumLoading('Carregando análise de memória...');
            
            try {
                const apiUrl = `/api/monitoring/memory/server/${serverId}?t=${Date.now()}`;
                debugLog(`[INFO] API: ${apiUrl}`, 'info');
                
                const response = await createFetchWithAbort(apiUrl);
                const json = await response.json();
                
                debugLog(`[INFO] Status: ${response.status}`, response.ok ? 'success' : 'error');
                
                if (!json.success) {
                    throw new Error(json.error || 'Erro na API de memória');
                }
                
                const memoryData = json.data;
                debugLog(` Dados de memória carregados`, 'success');
                
                renderMemoryAnalysis(memoryData, serverId);
                
            } catch (error) {
                debugLog(` Erro: ${error.message}`, 'error');
                content.innerHTML = `
                    <div class="card" style="background: #7f1d1d; border-color: #991b1b;">
                        <h4 style="color: #fca5a5;"><i class="fas fa-exclamation-triangle"></i> Erro</h4>
                        <p style="color: #fecaca;">${error.message}</p>
                    </div>
                `;
            }
        }

        function renderMemoryAlerts(alerts) {
            if (!alerts || alerts.length === 0) {
                return '<div class="alert alert-success"><i class="fas fa-check-circle"></i> Configurao de memória adequada</div>';
            }
            
            let alertsHtml = '';
            alerts.forEach(alert => {
                const icon = alert.level === 'danger' ? 'fa-exclamation-triangle' : 
                           alert.level === 'warning' ? 'fa-exclamation-circle' : 
                           alert.level === 'info' ? 'fa-info-circle' : 'fa-check-circle';
                
                alertsHtml += `
                    <div class="alert alert-${alert.level}">
                        <i class="fas ${icon}"></i> ${alert.message}
                    </div>
                `;
            });
            
            return alertsHtml;
        }

