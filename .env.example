# ============================================================================
# WatcherDB Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================================
#
# SECURITY: In production, set these as SYSTEM environment variables
# instead of keeping them in .env. Use one of:
#   - Windows: System Properties > Environment Variables
#   - Linux: /etc/environment or systemd EnvironmentFile
#   - Docker: docker-compose.yml environment section
#   - Cloud: AWS Secrets Manager, Azure Key Vault, HashiCorp Vault
#
# The .env file is for DEVELOPMENT ONLY.
#
# pydantic-settings loads values in this order (last wins):
#   1. Defaults in watcherdb/core/settings.py
#   2. Values from .env file
#   3. SYSTEM / process environment variables   <-- highest priority
#
# So in production you can delete .env entirely and rely on system env vars.
# ============================================================================

# ----------------------------------------------------------------------------
# Product Edition (tier gating)
# ----------------------------------------------------------------------------
# WatcherDB ships in two commercial editions — see watcherdb-council/docs/FEATURE_MATRIX.md
#
#   standard  — V3.3 default. Core monitoring. LLM / AI / ML features are DISABLED
#               regardless of LLM_ENABLED. Safe default for shipped Standard clients.
#   pro       — V3.3 dev/test only. Allows LLM integration for internal testing.
#               Production Pro clients run V5, not V3.3 — do NOT set pro in client builds.
#
# Default (unset) = standard. Changing to "pro" only makes sense in controlled
# dev environments where LLM invocation is authorized.
WATCHERDB_EDITION=standard

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
# Options: development, staging, production
WATCHERDB_ENV=development

# ----------------------------------------------------------------------------
# Security - JWT Authentication
# ----------------------------------------------------------------------------
# REQUIRED in production! Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me

# Fernet encryption key for server passwords in servers.json
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WATCHERDB_ENCRYPTION_KEY=your-fernet-key-change-me

# ----------------------------------------------------------------------------
# Email Notifications (SMTP)
# ----------------------------------------------------------------------------
# REQUIRED for email alerts functionality
# Configure SMTP settings in config/config.yaml, password here

# For Gmail (recommended):
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below (not your regular Gmail password)
# 4. In config.yaml, use: smtp_server: smtp.gmail.com, smtp_port: 587
SMTP_PASSWORD=your_gmail_app_password_here

# For Office 365/Outlook:
# smtp_server: smtp.office365.com
# smtp_port: 587
# Use your regular Office 365 password
# SMTP_PASSWORD=your_office365_password

# For other SMTP providers:
# Consult your email provider's documentation for SMTP settings
# Configure smtp_server and smtp_port in config/config.yaml

# ----------------------------------------------------------------------------
# Microsoft Teams Notifications
# ----------------------------------------------------------------------------
# Teams webhook URL for sending alerts to Teams channels
# Get this from Teams: Channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# ----------------------------------------------------------------------------
# Slack Notifications (Optional)
# ----------------------------------------------------------------------------
# Slack webhook URL for sending alerts to Slack channels
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ----------------------------------------------------------------------------
# Custom Webhook (Optional)
# ----------------------------------------------------------------------------
# Custom webhook URL for sending alerts to external systems
CUSTOM_WEBHOOK_URL=https://your-custom-webhook.example.com/alerts

# ----------------------------------------------------------------------------
# Grafana Integration (Optional)
# ----------------------------------------------------------------------------
# Grafana API key for exporting metrics
# Get this from: Grafana → Configuration → API Keys
GRAFANA_API_KEY=your_grafana_api_key

# ----------------------------------------------------------------------------
# Cache Backend
# ----------------------------------------------------------------------------
# Set to true to use a real Redis server instead of the in-memory cache
USE_REDIS=false

# ----------------------------------------------------------------------------
# Rate Limiting (Optional)
# ----------------------------------------------------------------------------
# Redis connection for distributed rate limiting (optional)
# If not set, in-memory rate limiting will be used
# REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Advanced Options
# ----------------------------------------------------------------------------
# Override default settings from config/config.yaml

# API Server Configuration
# WATCHERDB_HOST=0.0.0.0
# WATCHERDB_PORT=8000
# WATCHERDB_WORKERS=4

# Database Connection Pool
# DB_POOL_SIZE=20
# DB_CONNECTION_TIMEOUT=30

# Cache Configuration
# CACHE_TTL=60
# CACHE_MAX_MEMORY_MB=200

# Logging Level
# LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ----------------------------------------------------------------------------
# Development Options
# ----------------------------------------------------------------------------
# Enable debug mode (development only!)
# DEBUG=true

# Hot reload on code changes (development only!)
# RELOAD=true

# Disable authentication (development only - NEVER in production!)
# DISABLE_AUTH=false

# ----------------------------------------------------------------------------
# Security Best Practices
# ----------------------------------------------------------------------------
# 1. Never commit this file with real credentials
# 2. Use strong, unique passwords
# 3. Rotate secrets regularly (at least every 90 days)
# 4. Use different credentials for each environment
# 5. Enable 2FA where possible
# 6. Monitor access logs regularly
# 7. Use managed secrets services in production (AWS Secrets Manager, Azure Key Vault, etc.)
# ============================================================================
