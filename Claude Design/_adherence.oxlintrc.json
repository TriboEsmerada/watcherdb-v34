/* ============================================================
   WatcherDB — SPACING, RADII, ELEVATION, MOTION, Z-INDEX

   8pt grid. The codebase runs TWO spacing systems in parallel:
   the documented --space-* (8pt) and portal_fix_styles.css's
   --spacing-* (4/8/16/24/32). They are reconciled here onto the
   8pt scale; --spacing-* aliases are provided for migration.
   ============================================================ */

:root {
    /* ---- SPACING (8pt) ---- */
    --space-0:   0;
    --space-2xs: 0.25rem;   /*  4px — icon gaps, badge padding */
    --space-xs:  0.5rem;    /*  8px */
    --space-sm:  1rem;      /* 16px */
    --space-md:  1.5rem;    /* 24px */
    --space-lg:  2rem;      /* 32px */
    --space-xl:  3rem;      /* 48px */
    --space-2xl: 4rem;      /* 64px */

    /* portal_fix_styles.css aliases (4/8/16/24/32) */
    --spacing-xs: var(--space-2xs);
    --spacing-sm: var(--space-xs);
    --spacing-md: var(--space-sm);
    --spacing-lg: var(--space-md);
    --spacing-xl: var(--space-lg);

    /* Dense table rhythm — tuned for scan speed, not airiness */
    --row-pad-y: 0.5rem;    /* 8px  vertical cell padding */
    --row-pad-x: 0.75rem;   /* 12px horizontal cell padding */

    /* ---- RADII ---- */
    --radius-none: 0;
    --radius-sm: 4px;       /* inputs, chips, table container */
    --radius-md: 8px;       /* cards, buttons */
    --radius-lg: 12px;      /* modals, large panels */
    --radius-xl: 16px;
    --radius-full: 9999px;

    /* ---- ELEVATION (shadows tuned for a dark UI — darker, not
            the light-theme rgba(0,0,0,0.05) leftovers) ---- */
    --shadow-sm:  0 1px 2px rgba(0, 0, 0, 0.30);
    --shadow-md:  0 4px 6px rgba(0, 0, 0, 0.35);
    --shadow-lg:  0 10px 20px rgba(0, 0, 0, 0.45);
    --shadow-xl:  0 20px 35px rgba(0, 0, 0, 0.55);
    --shadow-focus: 0 0 0 3px rgba(96, 165, 250, 0.35);

    /* ---- MOTION — restrained. A monitoring wall should be
            calm; reserve animation for state CHANGE, never decor.
            No infinite pulses on idle content. ---- */
    --motion-fast: 120ms cubic-bezier(0.4, 0, 0.2, 1); /* @kind other */
    --motion-base: 200ms cubic-bezier(0.4, 0, 0.2, 1); /* @kind other */
    --motion-slow: 320ms cubic-bezier(0.4, 0, 0.2, 1); /* @kind other */

    /* ---- Z-INDEX ---- */
    --z-base: 0;             /* @kind other */
    --z-sticky: 1020;        /* @kind other */
    --z-fixed: 1030;         /* @kind other */
    --z-modal-backdrop: 1040;/* @kind other */
    --z-modal: 1050;         /* @kind other */
    --z-popover: 1060;       /* @kind other */
    --z-tooltip: 1070;       /* @kind other */
    --z-notification: 1080;  /* @kind other */

    /* ---- LAYOUT DIMENSIONS ---- */
    --sidebar-width: 320px;
    --header-height: 64px;
    --status-bar-height: 32px;
}

@media (prefers-reduced-motion: reduce) {
    :root {
        --motion-fast: 1ms; /* @kind other */
        --motion-base: 1ms; /* @kind other */
        --motion-slow: 1ms; /* @kind other */
    }
}
